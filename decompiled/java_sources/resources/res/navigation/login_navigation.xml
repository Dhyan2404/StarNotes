<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_login"
    app:startDestination="@+id/fragment_login">
    <fragment
        android:label="LoginFragment"
        android:name="com.onyx.galaxy.note.account.p043ui.LoginFragment"
        android:id="@+id/fragment_login">
        <action
            android:id="@+id/action_fragment_login_to_fragment_bind_phone"
            app:destination="@+id/fragment_bind_phone"
            app:popUpTo="@+id/fragment_login"
            app:popUpToInclusive="true">
            <argument
                android:name="bind_type"
                android:defaultValue="BIND_PHONE"
                app:argType="com.onyx.galaxy.note.account.data.BindType"/>
        </action>
    </fragment>
</navigation>
