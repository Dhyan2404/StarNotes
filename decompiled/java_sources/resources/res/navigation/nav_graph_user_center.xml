<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_user_center"
    app:startDestination="@+id/fragment_user_center">
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.ImageCropFragment"
        android:id="@+id/fragment_image_crop">
        <argument
            android:name="uri"
            app:argType="android.net.Uri"/>
        <argument
            android:name="savePath"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="Login"
        android:name="com.onyx.galaxy.note.account.p043ui.LoginFragment"
        android:id="@+id/fragment_login"/>
    <fragment
        android:label="UserCenter"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.UserCenterFragment"
        android:id="@+id/fragment_user_center"/>
    <fragment
        android:label="AccountCenter"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.AccountCenterFragment"
        android:id="@+id/fragment_account_center">
        <action
            android:id="@+id/account_center_to_image_crop"
            app:destination="@+id/fragment_image_crop">
            <argument
                android:name="uri"
                app:argType="android.net.Uri"/>
            <argument
                android:name="savePath"
                app:argType="string"/>
        </action>
        <action
            android:id="@+id/account_center_to_unbind_phone"
            app:destination="@+id/fragment_unbind_phone"/>
        <action
            android:id="@+id/account_center_to_unbind_email"
            app:destination="@+id/fragment_unbind_email"/>
        <action
            android:id="@+id/account_center_to_bind_phone"
            app:destination="@+id/fragment_bind_phone"/>
        <action
            android:id="@+id/account_center_to_bind_email"
            app:destination="@+id/fragment_bind_email"/>
        <action
            android:id="@+id/account_center_to_phone_verify"
            app:destination="@+id/fragment_phone_verify"/>
        <action
            android:id="@+id/account_center_to_email_verify"
            app:destination="@+id/fragment_email_verify"/>
        <action
            android:id="@+id/account_center_to_wechat_verify"
            app:destination="@+id/fragment_wechat_verify"/>
        <action
            android:id="@+id/account_center_to_mixed_verify"
            app:destination="@+id/fragment_mixed_verify"/>
    </fragment>
    <fragment
        android:label="LogOffAgreement"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.LogOffAgreementFragment"
        android:id="@+id/fragment_log_off_agreement">
        <action
            android:id="@+id/to_mixed_verify"
            app:destination="@+id/fragment_mixed_verify"/>
        <action
            android:id="@+id/to_wechat_verify"
            app:destination="@+id/fragment_wechat_verify"/>
        <action
            android:id="@+id/to_account_center"
            app:popUpTo="@+id/fragment_account_center"/>
    </fragment>
    <fragment
        android:label="LogOffMethod"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.VerifyMethodFragment"
        android:id="@+id/fragment_verify_method">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/verify_method_to_phone_verify"
            app:destination="@+id/fragment_phone_verify"/>
        <action
            android:id="@+id/verify_method_to_email_verify"
            app:destination="@+id/fragment_email_verify"/>
        <action
            android:id="@+id/verify_method_to_wechat_verify"
            app:destination="@+id/fragment_wechat_verify"/>
    </fragment>
    <fragment
        android:label="LogOffByPhone"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.LogOffByPhoneFragment"
        android:id="@+id/fragment_log_off_by_phone"/>
    <fragment
        android:label="LogOffByEmail"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.LogOffByEmailFragment"
        android:id="@+id/fragment_log_off_by_email"/>
    <fragment
        android:label="UnbindPhone"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.UnbindPhoneFragment"
        android:id="@+id/fragment_unbind_phone">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/unbind_phone_to_bind_phone"
            app:destination="@+id/fragment_bind_phone">
            <argument
                android:name="oldSocialAccount"
                app:argType="string"/>
            <argument
                android:name="oldVerifyCode"
                app:argType="string"/>
        </action>
    </fragment>
    <fragment
        android:label="UnbindEmail"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.UnbindEmailFragment"
        android:id="@+id/fragment_unbind_email">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/unbind_email_to_bind_email"
            app:destination="@+id/fragment_bind_email">
            <argument
                android:name="oldSocialAccount"
                app:argType="string"/>
            <argument
                android:name="oldVerifyCode"
                app:argType="string"/>
        </action>
    </fragment>
    <fragment
        android:label="BindPhone"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.BindPhoneFragment"
        android:id="@+id/fragment_bind_phone">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <argument
            android:name="oldSocialAccount"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="oldVerifyCode"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/bind_phone_to_account_center"
            app:popUpTo="@+id/fragment_account_center"/>
    </fragment>
    <fragment
        android:label="BindEmail"
        android:name="com.onyx.galaxy.note.usercenter.p049ui.BindEmailFragment"
        android:id="@+id/fragment_bind_email">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <argument
            android:name="oldSocialAccount"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="oldVerifyCode"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/bind_email_to_account_center"
            app:popUpTo="@+id/fragment_account_center"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.PhoneVerifyFragment"
        android:id="@+id/fragment_phone_verify">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/phone_verify_to_password_reset"
            app:destination="@+id/fragment_password_reset"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.EmailVerifyFragment"
        android:id="@+id/fragment_email_verify">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/email_verify_to_password_reset"
            app:destination="@+id/fragment_password_reset"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.MixedVerifyFragment"
        android:id="@+id/fragment_mixed_verify">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/mixed_verify_to_password_reset"
            app:destination="@+id/fragment_password_reset"/>
        <action
            android:id="@+id/mixed_verify_to_account_center"
            app:popUpTo="@+id/fragment_account_center"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.WechatVerifyFragment"
        android:id="@+id/fragment_wechat_verify">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/wechat_verify_to_account_center"
            app:popUpTo="@+id/fragment_account_center"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.PasswordResetFragment"
        android:id="@+id/fragment_password_reset">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <argument
            android:name="socialAccount"
            app:argType="string"/>
        <argument
            android:name="verifyCode"
            app:argType="string"/>
        <argument
            android:name="token"
            app:argType="string"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.MessageCenterFragment"
        android:id="@+id/MessageCenterFragment"/>
</navigation>
