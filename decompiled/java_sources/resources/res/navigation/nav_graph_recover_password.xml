<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@+id/MixedVerifyFragment">
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.MixedVerifyFragment"
        android:id="@+id/MixedVerifyFragment">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <action
            android:id="@+id/mixed_verify_to_password_reset"
            app:destination="@+id/PasswordResetFragment"/>
        <action
            android:id="@+id/mixed_verify_to_account_center"
            app:popUpTo="@+id/fragment_account_center"/>
    </fragment>
    <fragment
        android:name="com.onyx.galaxy.note.usercenter.p049ui.PasswordResetFragment"
        android:id="@+id/PasswordResetFragment">
        <argument
            android:name="purpose"
            app:argType="string"/>
        <argument
            android:name="socialAccount"
            app:argType="string"/>
        <argument
            android:name="verifyCode"
            app:argType="string"/>
        <argument
            android:name="token"
            app:argType="string"/>
    </fragment>
</navigation>
