<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="sequentially">
    <set android:ordering="together">
        <objectAnimator
            android:duration="100"
            android:valueFrom="1"
            android:valueTo="1.2"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:duration="100"
            android:valueFrom="1"
            android:valueTo="1.2"
            android:propertyName="scaleY"/>
    </set>
    <set android:ordering="together">
        <objectAnimator
            android:duration="100"
            android:valueFrom="1.2"
            android:valueTo="0.8"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:duration="100"
            android:valueFrom="1.2"
            android:valueTo="0.8"
            android:propertyName="scaleY"/>
    </set>
    <set android:ordering="together">
        <objectAnimator
            android:duration="100"
            android:valueFrom="0.8"
            android:valueTo="1.1"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:duration="100"
            android:valueFrom="0.8"
            android:valueTo="1.1"
            android:propertyName="scaleY"/>
    </set>
    <set android:ordering="together">
        <objectAnimator
            android:duration="100"
            android:valueFrom="1.1"
            android:valueTo="1"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:duration="100"
            android:valueFrom="1.1"
            android:valueTo="1"
            android:propertyName="scaleY"/>
    </set>
</set>
