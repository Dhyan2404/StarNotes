<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_note_tab_management_0"
    android:background="@drawable/selector_note_select_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48"
    android:paddingStart="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_12">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_text_color_01"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:lines="1"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/more"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/icon_tab_more"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
