<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/item_note_page_thumbnail_0"
    android:paddingBottom="@dimen/dp_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="@dimen/note_item_grid_pad_width"
        android:layout_height="@dimen/note_item_grid_pad_height">
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:layout_gravity="center"
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shadowColor="@color/black_percent_15"
            app:shadowRadius="@dimen/dp_5"
            app:showShadow="true">
            <com.onyx.android.sdk.p039ui.RoundImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                app:showAlphaBg="true"/>
            <com.onyx.android.sdk.theme.widgets.TintCheckBox
                android:layout_gravity="center"
                android:id="@+id/checkbox"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/selector_circle_selected"/>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    </FrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/tv_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"/>
</androidx.appcompat.widget.LinearLayoutCompat>
