<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_84">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_user_icon"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/icon_avatar"
        android:layout_marginStart="@dimen/dp_20"
        app:civ_border_color="@color/overlay_04"
        app:civ_border_overlay="false"
        app:civ_border_width="@dimen/px_1"
        app:civ_fill_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/iv_expand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_expand"
        style="@style/iconButtonStyle"/>
    <Space
        android:id="@+id/guide_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        app:layout_constraintTop_toBottomOf="@+id/iv_user_icon"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_user_role"
        android:visibility="gone"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_42"
        app:layout_constraintBottom_toBottomOf="@+id/guide_role"
        app:layout_constraintLeft_toLeftOf="@+id/iv_user_icon"
        app:layout_constraintRight_toRightOf="@+id/iv_user_icon"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/iv_notify_unread"
        android:background="@drawable/shape_notify_circle_red"
        android:layout_width="@dimen/dp_5"
        android:layout_height="@dimen/dp_5"
        android:layout_marginRight="@dimen/dp_1"
        android:layout_marginBottom="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="@+id/iv_user_icon"
        app:layout_constraintRight_toRightOf="@+id/iv_user_icon"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_library"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/ic_library"
        android:layout_marginEnd="@dimen/dp_16"
        app:iconSize="@dimen/dp_40"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/iv_expand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_expand"
        style="@style/materialPressStyleRadiusDp12"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_setting"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/ic_settings"
        android:layout_marginEnd="@dimen/dp_8"
        app:iconSize="@dimen/dp_40"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/iv_expand"
        app:layout_constraintEnd_toStartOf="@+id/iv_library"
        app:layout_constraintTop_toTopOf="@+id/iv_expand"
        style="@style/materialPressStyleRadiusDp12"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_expand"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_28"
        android:src="@drawable/ic_expand"
        android:layout_marginEnd="@dimen/dp_8"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintEnd_toStartOf="@+id/iv_setting"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/materialPressStyleRadiusDp12"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
