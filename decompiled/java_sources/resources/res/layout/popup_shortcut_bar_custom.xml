<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_shortcut_bar_custom_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_layout"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_528"
        android:layout_height="@dimen/dp_460"
        android:paddingVertical="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_primary_color_01"
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/materialPressStyleBtnRadiusDp08"/>
            <com.onyx.android.sdk.p039ui.MediumTextView
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_shortcut_bar"
                android:layout_centerInParent="true"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.p039ui.MediumTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_primary_color_01"
                android:id="@+id/tv_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finish"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_alignParentEnd="true"
                style="@style/materialPressStyleBtnRadiusDp08"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_24">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/theme_text_color_02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:text="@string/custom_shortcut_bar_tips"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_shortcut_bar_title"/>
                <com.onyx.galaxy.note.common.view.MaxHeightRecyclerView
                    android:id="@+id/list"
                    android:background="@drawable/common_rectangle_background"
                    android:padding="@dimen/dp_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:maxHeight="@dimen/dp_320"/>
                <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_text_color_01"
                        android:id="@+id/tv_title_more_func"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/custom_shortcut_bar_more_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/theme_text_color_02"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_title_more_func_click"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text="@string/custom_shortcut_bar_more_title_tip_click"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_title_more_func"
                        app:layout_constraintStart_toEndOf="@+id/tv_title_more_func"
                        app:layout_constraintTop_toTopOf="@+id/tv_title_more_func"/>
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_title_more_func_disable_eye"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/icon_small_disable_eye"
                        android:layout_marginStart="@dimen/dp_2"
                        app:imageTint="@color/theme_icon_color_02"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_title_more_func"
                        app:layout_constraintStart_toEndOf="@+id/tv_title_more_func_click"
                        app:layout_constraintTop_toTopOf="@+id/tv_title_more_func"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/theme_text_color_02"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text="@string/custom_shortcut_bar_more_title_tips"
                        android:layout_marginStart="@dimen/dp_2"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_title_more_func"
                        app:layout_constraintStart_toEndOf="@+id/iv_title_more_func_disable_eye"
                        app:layout_constraintTop_toTopOf="@+id/tv_title_more_func"/>
                </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
                <com.onyx.galaxy.note.common.view.MaxHeightRecyclerView
                    android:id="@+id/candidate_list"
                    android:background="@drawable/common_rectangle_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:maxHeight="@dimen/dp_320"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_error_color_01"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_reset_config"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/restore_default_settings"
                    android:paddingHorizontal="@dimen/dp_8"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
