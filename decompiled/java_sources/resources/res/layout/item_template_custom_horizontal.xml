<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="@dimen/dp_121"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_164"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:id="@+id/iv_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:borderColor="@color/theme_divider_color_01"
            app:borderWidth="@dimen/dp_0_5"
            app:fillColor="@color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shadowColor="@color/theme_divider_color_01"
            app:shadowDy="@dimen/dp_2"
            app:shadowRadius="@dimen/dp_8"
            app:showShadow="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.onyx.android.sdk.p039ui.RoundImageView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:topLeftRadius="@dimen/dp_2"
                    android:topRightRadius="@dimen/dp_6"
                    android:bottomLeftRadius="@dimen/dp_2"
                    android:bottomRightRadius="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_thumbnail"
                    app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
                    app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"
                    app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"
                    app:showAlphaBg="true"/>
                <com.onyx.galaxy.note.editor.view.custom.TemplateThumbnailView
                    android:id="@+id/iv_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_75"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:shapeAppearance="@style/template_face_shape_appearance"
                    app:strokeColor="@color/transparent"
                    app:strokeWidth="@dimen/dp_1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/iv_template_selected"
            android:visibility="gone"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            android:src="@drawable/selector_circle_selected"
            app:layout_constraintBottom_toBottomOf="@+id/iv_shadow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/iv_template_multi_selected"
            android:visibility="gone"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            android:src="@drawable/selector_circle_selected"
            app:layout_constraintBottom_toBottomOf="@+id/iv_shadow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_shadow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/selector_item_template_text_color"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/tv_template_name"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:lines="1"
        android:paddingStart="@dimen/dp_2"
        android:paddingEnd="@dimen/dp_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_thumbnail"/>
</androidx.constraintlayout.widget.ConstraintLayout>
