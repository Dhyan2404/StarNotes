<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/popup_textinput_selection_menu_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintRelativeLayout
        android:background="@drawable/common_rectangle_background"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/copy"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/copy"
            android:layout_centerVertical="true"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_divider"
            android:background="@color/theme_divider_color_01"
            android:layout_width="@dimen/dp0_5"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/copy"
            android:layout_marginVertical="@dimen/dp_1"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/paste"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paste"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/view_divider"/>
    </com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
</FrameLayout>
