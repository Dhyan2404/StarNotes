<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content_layout"
    android:tag="layout/item_count_down_record_0"
    android:background="@drawable/theme_ripple_bg_no_radius"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_68"
    android:paddingHorizontal="@dimen/dp_16">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_play_icon_color"
        android:gravity="center"
        android:id="@+id/tv_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textFontWeight="@integer/font_weight_Medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintFrameLayout
        android:id="@+id/fly_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/tv_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_01"
            android:gravity="end|center_vertical"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_count_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_30"/>
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/fly_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintEditText
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="end|center_vertical"
                android:id="@+id/edit_counter_name"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/dp_30"
                android:hint="@string/counter_task_enter_name"
                android:maxLines="@integer/text_view_max_lines_2"
                android:singleLine="true"
                android:imeOptions="actionDone"/>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
    </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/theme_play_icon_color"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fly_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_more_option"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/icon_counter_more"
        android:scaleType="centerInside"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/tv_total_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_total_time"
        style="@style/materialPressStyleRadiusDp08"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/checkbox"
        android:background="@drawable/selector_circle_selected"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:button="@null"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_total_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_total_time"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
