<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_mixed_verify_0"
    android:background="@drawable/layer_bind_phone_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_36"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_button"
            style="@style/account_return_button"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:layout_gravity="center"
            android:id="@+id/title_text"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="left"
        android:orientation="vertical"
        android:id="@+id/verify_layout"
        android:layout_width="@dimen/dp_440"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_24"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_account_verify"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/subTitleTipText"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"/>
        <com.onyx.android.sdk.theme.widgets.TintTabLayoutView
            android:id="@+id/tab_layout"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            app:tabBackground="@color/transparent"
            app:tabGravity="center"
            app:tabIndicator="@drawable/shape_color_tab_indicator"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/theme_primary_color_01"
            app:tabIndicatorFullWidth="true"
            app:tabMinWidth="@dimen/dp_72"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/transparent"
            app:tabTextSelector="@color/selector_theme_tab_layout_color"
            app:tabUnboundedRipple="true">
            <com.google.android.material.tabs.TabItem
                android:id="@+id/phoneTab"
                android:background="@color/transparent"
                android:layout_width="@dimen/dp_72"
                android:layout_height="wrap_content"
                android:text="@string/user_title_phone"
                android:contentDescription="@string/user_title_phone"/>
            <com.google.android.material.tabs.TabItem
                android:id="@+id/emailTab"
                android:background="@color/transparent"
                android:layout_width="@dimen/dp_72"
                android:layout_height="wrap_content"
                android:text="@string/user_title_email"
                android:contentDescription="@string/user_title_email"/>
        </com.onyx.android.sdk.theme.widgets.TintTabLayoutView>
        <FrameLayout
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/phoneVerifyLayout"
                android:visibility="invisible"
                layout="@layout/layout_phone_verify_item"/>
            <include
                android:id="@+id/emailVerifyLayout"
                android:visibility="invisible"
                layout="@layout/layout_email_verify_item"/>
        </FrameLayout>
    </LinearLayout>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
