<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auto_layout"
    android:tag="layout/layout_function_tool_0"
    android:background="@color/theme_background_function_layout_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/func_tool_layout_item_size"
        android:layout_height="@dimen/func_tool_layout_item_size"
        android:src="@drawable/ic_title_back"
        android:layout_marginStart="@dimen/dp_12"
        app:imageTint="@color/theme_icon_color_edit_title"
        app:layout_constraintBottom_toBottomOf="@+id/title_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_layout"
        style="@style/shortcutMaterialPressStyleRadiusDp12"/>
    <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
        android:id="@+id/iv_tab_indicator"
        android:background="@drawable/shape_tab_layout_arrow_bg"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/ic_note_tap_arrow_down"
        android:layout_marginEnd="@dimen/dp_12"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
        android:id="@+id/iv_custom_shortcut"
        android:layout_width="@dimen/func_tool_layout_item_size"
        android:layout_height="@dimen/func_tool_layout_item_size"
        android:src="@drawable/icon_more_function"
        android:layout_marginEnd="@dimen/dp_12"
        app:imageTint="@color/select_icon_edit_title_color"
        app:layout_constraintBottom_toBottomOf="@+id/title_layout"
        app:layout_constraintEnd_toStartOf="@+id/iv_tab_indicator"
        app:layout_constraintTop_toTopOf="@+id/title_layout"
        style="@style/shortcutMaterialPressStyleRadiusDp12"/>
    <FrameLayout
        android:id="@+id/iv_title_cloud"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/iv_title_layer"
        style="@style/func_layout_right_item_style">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_gravity="center"
            android:id="@+id/progress_sync"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SyncProgressIndicatorStyle"/>
        <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
            android:id="@+id/iv_sync_status"
            android:layout_width="@dimen/func_tool_layout_item_size"
            android:layout_height="@dimen/func_tool_layout_item_size"
            android:src="@drawable/ic_cloud"
            android:scaleType="center"
            app:imageTint="@color/select_icon_edit_title_color"
            style="@style/shortcutMaterialPressStyleRadiusDp12"/>
    </FrameLayout>
    <com.onyx.galaxy.note.editor.view.CustomShortcutsContainer
        android:id="@+id/title_layout"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/iv_custom_shortcut"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/play_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_layout">
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/shape_record_play_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            app:cardBackgroundColor="@color/theme_bg_overlay_color_01"
            app:cardCornerRadius="@dimen/dp_20"
            app:cardElevation="0dp"
            app:contentPaddingBottom="@dimen/dp_5">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/btn_audio_close"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_close_white"
                    app:imageTint="@color/theme_play_icon_color"
                    style="@style/materialPressStyleRadiusDp08"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/btn_audio_play"
                    android:tag="binding_1"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:layout_marginStart="@dimen/dp_12"
                    app:imageTint="@color/theme_play_icon_color"
                    style="@style/materialPressStyleRadiusDp08"/>
                <com.onyx.galaxy.note.editor.view.custom.TickSeekBar
                    android:id="@+id/seekBar"
                    android:tag="binding_2"
                    android:layout_width="@dimen/dp_200"
                    android:layout_height="wrap_content"
                    android:progressDrawable="@drawable/player_seekbar_progress"
                    android:thumb="@drawable/player_seekbar_thumb_drawable"
                    android:progressTint="@color/theme_secondary_color_01"
                    android:backgroundTint="@color/theme_background_color_06"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/theme_play_icon_color"
                    android:id="@+id/play_progress_time"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_35"
                    android:singleLine="true"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_play_icon_color"
                    android:gravity="center"
                    android:id="@+id/tv_play_speed"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_40"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/btn_audio_more"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_action_more"
                    app:imageTint="@color/theme_play_icon_color"
                    style="@style/materialPressStyleRadiusDp08"/>
            </LinearLayout>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
    </FrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/dividerStyle"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
