<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/change_title_layout"
    android:tag="layout/change_note_template_title_container_0"
    android:background="@drawable/shape_note_template_change_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_64">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/theme_primary_color_01"
        android:id="@+id/iv_note_template_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_12"
        style="@style/materialPressStyleBtnRadiusDp08"/>
    <com.onyx.android.sdk.p039ui.MediumTextView
        android:enabled="false"
        android:textSize="@dimen/sp_16"
        android:textColor="@color/theme_text_btn_color"
        android:gravity="center"
        android:id="@+id/tv_template_apply"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_36"
        android:text="@string/apply"
        android:maxLines="@integer/text_view_max_lines_1"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_24"
        android:layout_alignParentEnd="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/sp_12"
        android:autoSizeMaxTextSize="@dimen/sp_16"
        style="@style/materialBtnEnablePrimaryRadius12"/>
    <com.onyx.android.sdk.theme.widgets.TintTabLayoutView
        android:layout_gravity="center"
        android:id="@+id/templateChangeTabLayout"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp_320"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        app:rippleColorRes="@color/theme_bg_primary_color_01"
        app:tabGravity="center"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/theme_primary_color_01"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/dp_0"
        app:tabMinWidth="@dimen/dp_1"
        app:tabMode="scrollable"
        app:tabPadding="@dimen/dp_12"
        app:tabTextAppearance="@style/TabLayoutAppearance"
        app:tabTextSelector="@color/selector_theme_tab_layout_color"
        style="@style/tabLayoutStyle"/>
    <com.onyx.android.sdk.p039ui.MediumTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/tv_change_new_page_template_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/change_new_template"
        android:layout_centerInParent="true"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:layout_alignParentBottom="true"
        style="@style/dividerStyle"/>
</com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
