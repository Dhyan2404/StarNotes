<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_bg"
    android:tag="layout/editor_view_lock_layout_0"
    android:background="@color/background_100"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cls_lock_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/tintImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_edit_view_lock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/black_88"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/dialog_note_input_pwd_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tintImageView"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/til_name"
            android:layout_width="@dimen/dp_280"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:boxBackgroundColor="@color/background_50"
            app:boxStrokeColor="@color/selector_edt_stroke_outline_un_fit"
            app:endIconMode="none"
            app:hintTextColor="@color/black_38"
            app:layout_constraintEnd_toEndOf="@+id/btn_ok"
            app:layout_constraintStart_toStartOf="@+id/btn_ok"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                android:textSize="@dimen/sp_16"
                android:textColor="@color/black_88"
                android:textColorHint="@color/black_38"
                android:gravity="start|center_vertical"
                android:id="@+id/tie_name"
                android:layout_width="@dimen/dp_280"
                android:hint="@string/dialog_note_input_pwd_sub_title"
                android:maxLines="1"
                android:maxLength="@integer/note_pwd_max_input_text_length"
                android:inputType="numberPassword"
                android:imeOptions="actionDone"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_52"
                app:enableLengthRule="true"
                style="@style/textInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/btn_toggle_pwd_visible"
            android:padding="@dimen/dp_12"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:src="@drawable/selector_edt_pwd"
            app:imageTint="@color/black_50"
            app:layout_constraintBottom_toBottomOf="@+id/til_name"
            app:layout_constraintEnd_toEndOf="@+id/til_name"
            app:layout_constraintTop_toTopOf="@+id/til_name"
            style="?attr/materialIconButtonStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_forget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/dialog_note_input_pwd_forget"
            app:layout_constraintStart_toStartOf="@+id/til_name"
            app:layout_constraintTop_toBottomOf="@+id/til_name"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/selector_login_btn_text_color"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:layout_width="@dimen/dp_280"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/confirm"
            app:cornerRadius="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_forget"
            style="@style/materialBtnEnablePrimaryRadius12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/black_88"
            android:gravity="center"
            android:id="@+id/tv_finger"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/dialog_note_set_pwd_finger_title"
            android:drawableLeft="@drawable/icon_edit_view_finger"
            android:drawablePadding="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_64"
            app:layout_constraintEnd_toEndOf="@+id/btn_ok"
            app:layout_constraintStart_toStartOf="@+id/btn_ok"
            app:layout_constraintTop_toBottomOf="@+id/btn_ok"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
