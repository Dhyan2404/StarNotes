<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_custom_cover_0"
    android:background="@drawable/shape_common_popup_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_116">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/tv_import_from_gallery"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:foreground="@drawable/ripple_gary_oval"
            android:text="@string/import_from_gallery"
            android:drawableLeft="@drawable/ic_create_note_pic_import"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/theme_icon_color_01"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/tv_import_from_file"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:foreground="@drawable/ripple_gary_oval"
            android:text="@string/import_from_file"
            android:drawableLeft="@drawable/ic_create_note_file_import"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/theme_icon_color_01"/>
    </LinearLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
