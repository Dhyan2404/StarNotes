<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_wechat_verify_0"
    android:background="@drawable/layer_bind_phone_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_36"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/back_button"
            style="@style/account_return_button"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:layout_gravity="center"
            android:id="@+id/title_text"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:id="@+id/blank_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toTopOf="@+id/qr_code_image"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_weight="1"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/qr_code_image"
        android:padding="@dimen/dp_1"
        android:layout_width="@dimen/dp_264"
        android:layout_height="@dimen/dp_264"
        app:layout_constraintBottom_toTopOf="@+id/scan_tip_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blank_top"
        app:shapeAppearance="@style/qrShapeAppearance"
        app:strokeColor="@color/gray"
        app:strokeWidth="@dimen/dp_1"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_01"
        android:layout_gravity="center"
        android:id="@+id/scan_tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/user_tip_wechat_verify_by_scan"
        app:layout_constraintBottom_toTopOf="@+id/or_tip_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qr_code_image"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/theme_text_color_03"
        android:layout_gravity="center"
        android:id="@+id/or_tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_tip_or"
        android:layout_marginVertical="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/start_app_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scan_tip_text"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/dp_18"
        android:textColor="@color/white"
        android:id="@+id/start_app_button"
        android:tag="binding_2"
        android:layout_width="@dimen/dp_440"
        android:layout_height="@dimen/dp_50"
        android:text="@string/user_title_wechat_use_local"
        android:backgroundTint="@color/wechat_green"
        app:cornerRadius="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/blank_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/or_tip_text"/>
    <View
        android:id="@+id/blank_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_app_button"
        app:layout_constraintVertical_weight="1"/>
    <com.onyx.galaxy.note.account.view.WechatLoadWebWidget
        android:id="@+id/webWidget"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
