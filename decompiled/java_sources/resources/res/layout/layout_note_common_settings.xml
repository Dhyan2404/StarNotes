<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:tag="layout/layout_note_common_settings_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:gravity="start"
            android:id="@+id/tv_common_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_150"
            android:maxLines="@integer/text_view_max_lines_1"
            android:drawableRight="@drawable/icon_switch_note_settings_arrow"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/note_more_setting_left_right_margin"
            android:layout_alignParentStart="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_8"
            android:autoSizeMaxTextSize="@dimen/sp_12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/tv_common_settings_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_90"
            android:maxLines="@integer/text_view_max_lines_2"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/note_more_setting_left_right_margin"
            android:layout_alignParentEnd="true"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_8"
            android:autoSizeMaxTextSize="@dimen/sp_12"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_56"
        android:paddingStart="@dimen/note_more_setting_left_right_margin"
        android:paddingEnd="@dimen/note_more_setting_left_right_margin">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_90"
            android:text="@string/toolbar"
            android:maxLines="@integer/text_view_max_lines_2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_14"
            android:autoSizeMaxTextSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/toolbar_top"
            android:background="@drawable/selector_settings_icon_bg"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/ic_toolbar_top"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/toolbar_left"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/toolbar_left"
            android:background="@drawable/selector_settings_icon_bg"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/ic_toolbar_left"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/toolbar_right"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/toolbar_right"
            android:background="@drawable/selector_settings_icon_bg"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/ic_toolbar_right"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/toolbar_bottom"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/toolbar_bottom"
            android:background="@drawable/selector_settings_icon_bg"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/ic_toolbar_bottom"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/page_orientation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_56"
        android:paddingStart="@dimen/note_more_setting_left_right_margin"
        android:paddingEnd="@dimen/note_more_setting_left_right_margin">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_180"
            android:text="@string/paging_orientation"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/layout_type_horizontal"
            android:background="@drawable/selector_settings_icon_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/ic_paging_horizontal"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_type_vertical"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/layout_type_vertical"
            android:background="@drawable/selector_settings_icon_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/ic_paging_vertical"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/page_number_panel_direction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_56"
        android:paddingStart="@dimen/note_more_setting_left_right_margin"
        android:paddingEnd="@dimen/note_more_setting_left_right_margin">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_180"
            android:text="@string/page_number_display_panel_direction"
            android:maxLines="@integer/text_view_max_lines_2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_14"
            android:autoSizeMaxTextSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/page_number_panel_direction_start"
            android:background="@drawable/selector_settings_icon_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/page_num_panel_on_left"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/page_number_panel_direction_end"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/page_number_panel_direction_end"
            android:background="@drawable/selector_settings_icon_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/page_num_panel_on_left"
            android:scaleX="-1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_single_paging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_56"
        android:paddingStart="@dimen/note_more_setting_left_right_margin"
        android:paddingEnd="@dimen/note_more_setting_left_right_margin">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/note_setting_more_item_max_width"
            android:text="@string/slide_continued"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
            android:id="@+id/single_paging"
            android:textOn=""
            android:textOff=""
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbTint="@color/white"
            style="@style/commonSwitchStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_two_page_browsing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_56"
        android:paddingStart="@dimen/note_more_setting_left_right_margin"
        android:paddingEnd="@dimen/note_more_setting_left_right_margin">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/note_setting_more_item_max_width"
            android:text="@string/two_page_browsing"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
            android:id="@+id/two_page_browsing"
            android:textOn=""
            android:textOff=""
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbTint="@color/white"
            style="@style/commonSwitchStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_adapt_stroke_width"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_56"
        android:paddingStart="@dimen/note_more_setting_left_right_margin"
        android:paddingEnd="@dimen/note_more_setting_left_right_margin">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_adapt_stroke_width"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_160"
            android:text="@string/adapt_pen_stroke_width"
            android:maxLines="@integer/text_view_max_lines_2"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_15"
            android:autoSizeMaxTextSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_adapt_stroke_width_guide"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/icon_guide"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_adapt_stroke_width"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
            android:id="@+id/adapt_stroke_width"
            android:textOn=""
            android:textOff=""
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbTint="@color/white"
            style="@style/commonSwitchStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/note_more_setting_left_right_margin"
        android:layout_marginEnd="@dimen/note_more_setting_left_right_margin"
        style="@style/dividerStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintFrameLayout
        android:id="@+id/change_theme"
        style="@style/noteSettingItemStyle">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_56"
            android:maxWidth="@dimen/note_setting_more_item_max_width"
            android:text="@string/change_theme"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_arrow_right"
            app:imageTint="@color/theme_icon_color_02"/>
    </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintFrameLayout
        android:id="@+id/more_settings"
        style="@style/noteSettingItemStyle">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/note_setting_more_item_max_width"
            android:text="@string/more_settings"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_arrow_right"
            app:imageTint="@color/theme_icon_color_02"/>
    </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
</LinearLayout>
