<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_note_list_dust_bin_op_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_240"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_12">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/selector_note_op_delete_btn_color"
            android:gravity="center_vertical"
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/option_dust_bin_delete_quietly"
            android:drawableLeft="@drawable/icon_dust_bin_delete"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/selector_note_op_delete_btn_color"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_2"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_delete"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/btn_restore"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/option_dust_bin_restore"
            android:drawableLeft="@drawable/icon_dust_bin_restore"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/theme_text_color_01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_2"
            style="@style/materialSelectPressStyleNoRadius"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
