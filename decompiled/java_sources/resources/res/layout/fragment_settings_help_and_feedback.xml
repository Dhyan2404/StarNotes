<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_settings_help_and_feedback_0"
    android:background="@color/theme_background_color_01"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_28"
        android:src="@drawable/icon_back"
        android:layout_marginStart="@dimen/dp_16"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/materialPressStyleRadiusDp08"/>
    <com.onyx.android.sdk.p039ui.MediumTextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/theme_text_color_01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/help_and_feedback"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back">
        <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_24">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_36"
                android:text="@string/feedback_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.onyx.android.sdk.theme.widgets.TintRecycleView
                android:id="@+id/rv_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_type"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_memo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/feedback_memo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_type"/>
            <com.onyx.android.sdk.theme.widgets.TintEditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="start|top"
                android:id="@+id/edt_memo"
                android:background="@drawable/shape_feedback_edt_bg"
                android:padding="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:minHeight="@dimen/dp_160"
                android:hint="@string/feedback_memo_hint"
                android:maxLength="1000"
                app:layout_constraintTop_toBottomOf="@+id/tv_memo"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_upload_pic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_memo"/>
            <com.onyx.android.sdk.theme.widgets.TintRecycleView
                android:id="@+id/rv_picture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_upload_pic"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/feedback_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_picture"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_02"
                android:id="@+id/tv_email_desc"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/feedback_email_desc"
                android:layout_marginHorizontal="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_email"
                app:layout_constraintTop_toTopOf="@+id/tv_email"/>
            <com.onyx.android.sdk.theme.widgets.TintEditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="start|top"
                android:id="@+id/edt_email"
                android:background="@drawable/shape_feedback_edt_bg"
                android:padding="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginTop="@dimen/dp_12"
                android:hint="@string/feedback_email_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_email"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/selector_login_btn_text_color"
                android:gravity="center"
                android:id="@+id/tv_submit"
                android:layout_width="@dimen/dp_440"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_32"
                android:layout_marginBottom="@dimen/dp_24"
                android:text="@string/feedback_submit"
                app:cornerRadius="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edt_email"
                app:layout_constraintVertical_bias="0"
                style="@style/materialBtnEnablePrimaryRadius12"/>
        </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
    </ScrollView>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
