<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fl"
    android:tag="layout/popup_create_note_0"
    android:background="@drawable/shape_common_popup_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="@dimen/dp_240"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_1"
        android:paddingEnd="@dimen/dp_1">
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_create_note"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/create_note"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_1"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_quota_lock"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_create_no_bonds"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_no_bonds"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/no_bonds_note"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_2"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_quota_lock"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_create_file_import"
            android:padding="@dimen/dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_file_import"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="@string/import_file"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_12"
                        style="@style/commonTextStyle"/>
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:tag="binding_3"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/ic_quota_lock"
                        app:imageTint="@color/theme_icon_color_02"/>
                </LinearLayout>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/theme_text_color_03"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_file_support_type_hint"
                    android:layout_marginEnd="@dimen/dp_28"/>
            </LinearLayout>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_create_pic_import"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_pic_import"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/import_picture"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_4"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_quota_lock"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_create_camera"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_camera"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/take_photo"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_5"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_quota_lock"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_scanner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_scan_import"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/doc_scanner"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textColor="@color/theme_text_color_01"
                android:gravity="center"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_create_folder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_folder"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/dialog_create_folder_title"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_6"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_quota_lock"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_quickly"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:background="@drawable/ic_create_note_quickly"
                app:backgroundTint="@color/theme_icon_color_01"
                style="@style/commonIconStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/quickly_note"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/quickly_settings"
                android:tag="binding_7"
                android:padding="@dimen/dp_4"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_create_note_quickly_settings"
                app:imageTint="@color/theme_icon_color_02"
                style="@style/materialSelectPressStyleNoRadius"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_8"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ic_quota_lock"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.galaxy.note.editor.view.PalmCollectionLinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_vip_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/secondary_200"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_vip_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_12"
                android:text="@string/vip_hint"/>
        </LinearLayout>
    </LinearLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
