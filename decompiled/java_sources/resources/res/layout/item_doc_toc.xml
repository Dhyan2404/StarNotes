<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_layout"
    android:tag="layout/item_doc_toc_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/dp_48"
    style="@style/materialSelectPressStyleNoRadius">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_indicator"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/ic_toc_expand_arrow_right"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        app:imageTint="@color/theme_icon_color_03"
        style="@style/materialPressStyleRadiusDp08"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/coverTitleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_4"
        android:layout_toStartOf="@+id/page_index"
        android:layout_toEndOf="@+id/iv_indicator">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/image_container"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_marginHorizontal="@dimen/dp_5">
            <com.onyx.galaxy.note.p048ui.view.ShadowLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:shadowColor="@color/black_percent_15"
                app:shadowDy="@dimen/dp_1"
                app:shadowRadius="@dimen/dp_2"
                app:showShadow="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:scaleType="centerInside"/>
            </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_4"/>
    </LinearLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_text_color_03"
        android:id="@+id/page_index"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/more_settings"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/more_settings"
        android:background="@drawable/ripple_primary_radius_by_pressed"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/ic_action_more"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_toStartOf="@+id/checkbox"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintCheckBox
        android:id="@+id/checkbox"
        android:padding="@dimen/dp_2"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/selector_circle_selected"
        android:minWidth="@dimen/dp_12"
        android:minHeight="@dimen/dp_12"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_alignParentEnd="true"
        style="@style/materialPressStyleRadiusDp08"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_drag_bottom"
        android:background="@drawable/shape_item_folder_drag_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_2"
        android:layout_alignParentBottom="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignStart="@+id/iv_indicator"
        android:layout_alignParentEnd="true"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_drag_top"
        android:background="@drawable/shape_item_folder_drag_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_2"
        android:layout_alignParentTop="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignStart="@+id/iv_indicator"
        android:layout_alignParentEnd="true"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_drag_in"
        android:background="@drawable/shape_item_folder_drag_in"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignStart="@+id/iv_indicator"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/dp_1"
        android:paddingVertical="@dimen/dp_4"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/dividerView"
        android:background="@color/theme_divider_color_01"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp0_5"
        android:layout_alignParentBottom="true"/>
</com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
