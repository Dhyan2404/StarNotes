<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:tag="layout/item_count_down_multiple_time_list_0"
    android:background="@drawable/selector_counter_time_list_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_36"
    android:paddingStart="@dimen/dp_32"
    android:paddingEnd="@dimen/dp_16">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/selector_color_selected_blue_black"
        android:id="@+id/tv_total_time"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:textFontWeight="@integer/font_weight_Medium"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_more_option"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/icon_counter_more"
        android:scaleType="centerInside"
        android:layout_alignParentEnd="true"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintEditText
        android:textSize="@dimen/sp_10"
        android:textColor="@color/theme_text_color_01"
        android:textColorHint="@color/theme_text_color_03"
        android:gravity="end|center_vertical"
        android:id="@+id/edt_count_name"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp_30"
        android:layout_centerVertical="true"
        android:imeOptions="actionDone"
        android:layout_marginEnd="@dimen/dp_8"
        android:layout_toStartOf="@+id/iv_more_option"
        android:textFontWeight="@integer/font_weight_Medium"/>
</com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
