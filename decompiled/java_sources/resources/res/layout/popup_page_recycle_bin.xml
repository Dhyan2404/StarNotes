<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_page_recycle_bin_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintFrameLayout
        android:background="@drawable/shape_common_popup_top_radius_bg"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/dp_12">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/page_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_64">
                <com.onyx.android.sdk.theme.widgets.TintCheckBox
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center_vertical"
                    android:id="@+id/select_all"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_24"
                    android:button="@drawable/selector_circle_selected"
                    android:text="@string/select_all"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_alignParentStart="true"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/theme_text_color_03"
                    android:gravity="center"
                    android:id="@+id/selected_count"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_selected_count"
                    android:layout_alignTop="@+id/select_all"
                    android:layout_alignBottom="@+id/select_all"
                    android:layout_toEndOf="@+id/select_all"
                    android:layout_marginHorizontal="@dimen/dp_3"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center"
                    android:id="@+id/close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_60"
                    android:minHeight="@dimen/dp_40"
                    android:text="@string/close"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:paddingHorizontal="@dimen/dp_12"
                    style="@style/materialPressStyleRadiusDp08"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_recycle_bin"
                    android:layout_centerInParent="true"
                    android:textFontWeight="@integer/font_weight_Medium"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/finish"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="@dimen/dp_40"
                    android:text="@string/select"
                    android:maxLines="@integer/text_view_max_lines_1"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="@dimen/sp_12"
                    android:layout_marginHorizontal="@dimen/dp_12"
                    android:autoSizeMaxTextSize="@dimen/sp_16"
                    style="@style/materialBtnEnablePrimaryRadius12"/>
            </RelativeLayout>
            <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/selection_action_layout"
                android:background="@drawable/shape_note_op_menu_bg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:layout_marginBottom="@dimen/dp_12">
                <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_dust_bin_op_delete"
                    android:padding="@dimen/dp_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/materialPressStyleRadiusDp08">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_dust_bin_op_delete"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/icon_dust_bin_delete"
                        app:imageTint="@color/selector_note_op_delete_btn_color"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:enabled="false"
                        android:textColor="@color/selector_note_op_delete_btn_color"
                        android:id="@+id/tv_dust_bin_op_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permanently_delete"
                        android:layout_marginStart="@dimen/dp_8"/>
                </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
                <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_dust_bin_op_restore"
                    android:padding="@dimen/dp_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    style="@style/materialPressStyleRadiusDp08">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_dust_bin_op_restore"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/icon_dust_bin_restore"
                        app:imageTint="@color/selector_note_op_btn_color"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:enabled="false"
                        android:textColor="@color/selector_note_op_btn_color"
                        android:id="@+id/tv_dust_bin_op_restore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/option_dust_bin_restore"
                        android:layout_marginStart="@dimen/dp_8"/>
                </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
            </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
            <com.onyx.galaxy.note.category.view.SwipeRecycleViewContainer
                android:id="@+id/swipe_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:padding="@dimen/dp_24"/>
        </LinearLayout>
        <com.onyx.galaxy.note.category.view.CommonEmptyView
            android:id="@+id/empty_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_64"/>
    </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
</FrameLayout>
