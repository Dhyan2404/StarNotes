<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_area_code_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_602">
        <com.onyx.android.sdk.theme.widgets.TintTabLayoutView
            android:textSize="@dimen/sp_16"
            android:id="@+id/scrollable_tab_layout"
            android:background="@color/transparent"
            android:paddingTop="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabGravity="start"
            app:tabIndicatorFullWidth="false"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="@dimen/dp_16"
            app:tabPaddingStart="@dimen/dp_16"
            style="@style/tabLayoutStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollable_tab_layout"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollable_tab_layout"
            app:spanCount="2"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
