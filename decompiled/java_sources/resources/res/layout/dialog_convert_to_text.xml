<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl"
    android:tag="layout/dialog_convert_to_text_0"
    android:background="@drawable/bg_dialog_element_handle"
    android:padding="@dimen/dp_16"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_dialog_policy_cancel"
            android:layout_centerVertical="true"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_260"
            android:text="@string/hand_writing_recognition"
            android:layout_centerInParent="true"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_btn_color"
            android:gravity="center"
            android:id="@+id/convert"
            android:background="@drawable/selector_convert_btn_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_150"
            android:minHeight="@dimen/dp_32"
            android:text="@string/confirm_convert"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="@dimen/dp_12"/>
    </RelativeLayout>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/langSelectLayout"
        android:background="@drawable/bg_search_condition"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/dp_168"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_16">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/langText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_14"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/spacingView"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/arrowButton"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_12"
            android:src="@drawable/ic_ink_font_select_arrow"
            android:scaleType="centerInside"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:layout_marginVertical="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_4"
            android:paddingVertical="@dimen/dp_6"
            app:imageTint="@color/theme_text_color_02"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    <FrameLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_220"
        android:layout_marginTop="@dimen/dp_16">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="vertical"
            android:background="@drawable/common_rectangle_background"
            android:padding="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.onyx.android.sdk.p039ui.TouchModeMaxLengthEditText
                android:scrollbarStyle="outsideOverlay"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="start"
                android:id="@+id/content"
                android:background="@color/theme_background_color_01"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:singleLine="false"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_8"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/ll_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_12">
                <com.onyx.galaxy.note.p048ui.view.TextSwitchButton
                    android:id="@+id/smartHwrButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    app:text="@string/hwr_smart_recognition"
                    app:textMarginStart="@dimen/dp_4"
                    app:textSize="@dimen/dp_10"
                    app:thumbHeight="@dimen/dp_12"
                    app:thumbMarginEnd="@dimen/dp_2"
                    app:thumbMarginStart="@dimen/dp_6"
                    app:thumbMarginVertical="@dimen/dp_6"
                    app:thumbWidth="@dimen/dp_12"/>
                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_1"
                    android:layout_weight="1"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center"
                    android:id="@+id/copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_full_text"
                    android:paddingHorizontal="@dimen/dp_12"/>
                <com.onyx.android.sdk.theme.widgets.TintView
                    android:id="@+id/buttonDivider"
                    android:background="@color/theme_divider_color_01"
                    android:layout_width="@dimen/dp0_5"
                    android:layout_height="@dimen/dp_16"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center"
                    android:id="@+id/export"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_full_text"
                    android:paddingHorizontal="@dimen/dp_12"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/recognizing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_loading"
                android:background="@drawable/animate_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_8"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_primary_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recognizing"/>
        </LinearLayout>
    </FrameLayout>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
