<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_wechat_login_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content">
        <com.onyx.galaxy.note.account.view.WechatLoadWebWidget
            android:id="@+id/webLoadWidget"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/dialog_wechat_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:src="@drawable/icon_wechat_qr_back_arrow"
            android:layout_marginStart="@dimen/dp_12"
            app:imageTint="@color/theme_icon_color_01"
            app:layout_constraintBottom_toBottomOf="@+id/tv_dialog_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_dialog_title"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_qr"
            android:layout_width="@dimen/dp_212"
            android:layout_height="@dimen/dp_212"
            android:layout_marginTop="@dimen/dp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"
            app:shapeAppearance="@style/qrShapeAppearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:background="@drawable/shape_wechat_qr_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_qr"
            app:layout_constraintEnd_toEndOf="@+id/iv_qr"
            app:layout_constraintStart_toStartOf="@+id/iv_qr"
            app:layout_constraintTop_toTopOf="@+id/iv_qr"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/dialog_wechat_qr_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_qr"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/textView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/dialog_wechat_app_qr_refresh"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="@+id/textView"
            app:layout_constraintEnd_toStartOf="@+id/textView"
            app:layout_constraintStart_toStartOf="@+id/iv_qr"
            app:layout_constraintTop_toTopOf="@+id/textView"
            style="@style/loginDividerLineStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/dialog_wechat_or_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView13"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="@+id/textView"
            app:layout_constraintEnd_toEndOf="@+id/iv_qr"
            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintTop_toTopOf="@+id/textView"
            style="@style/loginDividerLineStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/selector_login_btn_text_color"
            android:gravity="center"
            android:id="@+id/btn_app_login"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_32"
            android:layout_marginBottom="@dimen/dp_40"
            android:text="@string/dialog_wechat_app_hint"
            android:backgroundTint="@color/wechat_green"
            app:cornerRadius="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            style="@style/materialBtnEnablePrimaryRadius12"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
