<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_note_auth_password_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:tag="@string/auto_size_dialog_tag"
        android:background="@drawable/shape_common_dialog_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/dp_86"
            android:layout_height="@dimen/dp_46"
            android:text="@string/cancel"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/materialPressStyleRadiusDp12"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:maxWidth="@dimen/dp_220"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_46"
            android:maxWidth="@dimen/dp_150"
            android:minWidth="@dimen/dp_86"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/materialPressStyleRadiusDp12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_sub_title"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/til_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:endIconMode="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sub_title"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                android:textSize="@dimen/sp_16"
                android:gravity="start|center_vertical"
                android:id="@+id/tie_name"
                android:layout_width="match_parent"
                android:hint="@string/dialog_note_pwd_hint_title"
                android:maxLines="1"
                android:maxLength="@integer/note_pwd_max_input_text_length"
                android:inputType="numberPassword"
                android:imeOptions="actionDone"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_52"
                app:enableLengthRule="true"
                style="@style/textInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/btn_toggle_pwd_visible"
            android:padding="@dimen/dp_12"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:src="@drawable/selector_edt_pwd"
            app:imageTint="@color/theme_icon_color_02"
            app:layout_constraintBottom_toBottomOf="@+id/til_name"
            app:layout_constraintEnd_toEndOf="@+id/til_name"
            app:layout_constraintTop_toTopOf="@+id/til_name"
            style="?attr/materialIconButtonStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_forget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/dialog_note_input_pwd_forget"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/til_name"
            app:layout_constraintTop_toBottomOf="@+id/til_name"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
