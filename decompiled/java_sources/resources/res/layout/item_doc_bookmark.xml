<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_doc_bookmark_0"
    android:background="@drawable/selector_doc_overview_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_12">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:id="@+id/image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:shadowColor="@color/black_percent_15"
            app:shadowRadius="@dimen/dp_5"
            app:showShadow="true">
            <ImageView
                android:id="@+id/image"
                android:layout_width="@dimen/note_item_bookmark_width"
                android:layout_height="@dimen/note_item_bookmark_height"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/bookmark"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_margin="@dimen/dp_2"
                android:src="@drawable/ic_bookmark_selected"
                style="@style/iconButtonStyle"/>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/theme_text_color_01"
        android:gravity="center"
        android:id="@+id/page"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/image_container"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@+id/image_container"
        android:layout_alignEnd="@+id/image_container"
        android:paddingVertical="@dimen/dp_6"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/more_settings"
        android:background="@drawable/ripple_primary_radius_by_pressed"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/ic_action_more"
        android:scaleType="centerInside"
        android:layout_alignTop="@+id/page"
        android:layout_alignBottom="@+id/page"
        android:layout_alignParentEnd="true"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/centerSettingButton"
        android:background="@drawable/ripple_primary_radius_by_pressed"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/ic_action_more"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintCheckBox
        android:id="@+id/checkbox"
        android:padding="@dimen/dp_2"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/selector_circle_checked_02"
        android:minWidth="@dimen/dp_12"
        android:minHeight="@dimen/dp_12"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_5"
        android:layout_alignParentEnd="true"
        style="@style/iconButtonStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/theme_text_color_03"
        android:layout_gravity="end|bottom"
        android:id="@+id/countText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/page"
        android:layout_alignBottom="@+id/page"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_toStartOf="@+id/checkbox"
        android:layout_toEndOf="@+id/image_container">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/title_edit_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:counterEnabled="false"
            app:counterMaxLength="@integer/book_mark_title_max_char_length"
            app:hintEnabled="false">
            <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/title_edit"
                android:tag="binding_2"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/input_description"
                android:maxLines="@integer/book_mark_title_max_lines"
                android:lines="@integer/book_mark_title_max_lines"
                android:maxLength="@integer/desc_input_default_limit_count"
                android:inputType="textMultiLine"
                android:paddingHorizontal="@dimen/dp_5"
                android:paddingVertical="@dimen/dp_28"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="@dimen/sp_12"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="@integer/book_mark_title_max_lines"
            android:paddingEnd="@dimen/dp_36"/>
    </FrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/dividerView"
        android:background="@color/theme_divider_color_01"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_alignParentBottom="true"/>
</com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
