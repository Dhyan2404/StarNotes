<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_common_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/loading_container"
            android:background="@drawable/shape_dialog_loading_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_120"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <ImageView
                android:id="@+id/iv_loading_anim"
                android:background="@drawable/animate_loading"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:maxWidth="@dimen/dp_120"
                android:text="@string/dialog_loading"
                android:paddingHorizontal="@dimen/dp_12"/>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:background="@drawable/shape_common_dialog_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tv_title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_warning"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_warning"/>
                <com.onyx.android.sdk.p039ui.MediumTextView
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/theme_text_color_01"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/content_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="center"
                    android:id="@+id/tv_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_352"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_container"/>
                <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
                    android:id="@+id/cl_edit_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textColor="@color/theme_text_color_02"
                        android:id="@+id/tv_edit_length_display"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp_8"
                        app:layout_constraintBottom_toTopOf="@+id/til_name"
                        app:layout_constraintEnd_toEndOf="@+id/cl_edit_container"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/til_name"
                        android:layout_width="@dimen/dp_352"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginHorizontal="@dimen/dp_24"
                        app:boxBackgroundColor="@color/theme_background_color_02"
                        app:boxCornerRadiusBottomEnd="@dimen/dp_12"
                        app:boxCornerRadiusBottomStart="@dimen/dp_12"
                        app:boxCornerRadiusTopEnd="@dimen/dp_12"
                        app:boxCornerRadiusTopStart="@dimen/dp_12"
                        app:boxStrokeColor="@color/selector_edt_stroke_outline"
                        app:boxStrokeWidth="@dimen/dp_1"
                        app:boxStrokeWidthFocused="@dimen/dp_1"
                        app:endIconDrawable="@drawable/icon_login_clear"
                        app:endIconMode="clear_text"
                        app:endIconTint="@color/theme_icon_color_02"
                        app:hintEnabled="false"
                        app:hintTextColor="@color/theme_text_color_03"
                        app:layout_constraintTop_toBottomOf="@+id/tv_edit_length_display"
                        style="?attr/textInputOutlinedDenseStyle">
                        <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                            android:textColor="@color/theme_text_color_01"
                            android:textColorHint="@color/theme_text_color_03"
                            android:gravity="center"
                            android:id="@+id/edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_52"
                            android:maxLines="1"
                            android:inputType="text"
                            android:imeOptions="actionDone"/>
                    </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
                </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="@dimen/dp_352"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginBottom="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24">
                <com.onyx.android.sdk.p039ui.MediumTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="center"
                    android:id="@+id/tv_cancel"
                    android:background="@drawable/theme_ripple_dialog_gray_stroke_bg"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_48"
                    android:minWidth="@dimen/dp_16"
                    android:minHeight="@dimen/dp_16"
                    android:text="@string/cancel"
                    android:layout_weight="1"/>
                <com.onyx.android.sdk.p039ui.MediumTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_btn_color"
                    android:gravity="center"
                    android:id="@+id/tv_confirm"
                    android:background="@drawable/theme_ripple_dialog_primary_bg"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_48"
                    android:minWidth="@dimen/dp_16"
                    android:minHeight="@dimen/dp_16"
                    android:text="@string/confirm"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_16"/>
            </LinearLayout>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </FrameLayout>
</FrameLayout>
