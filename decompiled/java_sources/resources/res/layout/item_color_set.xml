<?xml version="1.0" encoding="utf-8"?>
<com.onyx.galaxy.note.p048ui.view.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shadowLayout"
    android:tag="layout/item_color_set_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cornerRadius="@dimen/dp_12"
    app:shadowColor="@color/black_percent_15"
    app:shadowRadius="@dimen/dp_5"
    app:showBorder="false"
    app:showShadow="false">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_10">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:id="@+id/nameText"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/iv_menu"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_menu"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/icon_color_set_menu"
            android:scaleType="centerInside"
            app:imageTint="@color/theme_icon_color_01"
            app:layout_constraintBottom_toBottomOf="@+id/nameText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/nameText"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/gridLayout"
            android:background="@drawable/shape_colorset_border"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nameText">
            <com.onyx.galaxy.note.editor.view.toolbar.ColorView
                android:id="@+id/grid1"
                style="@style/colorViewStyleLarge"/>
            <com.onyx.galaxy.note.editor.view.toolbar.ColorView
                android:id="@+id/grid2"
                android:layout_marginStart="@dimen/dp_22"
                style="@style/colorViewStyleLarge"/>
            <com.onyx.galaxy.note.editor.view.toolbar.ColorView
                android:id="@+id/grid3"
                android:layout_marginStart="@dimen/dp_22"
                style="@style/colorViewStyleLarge"/>
            <com.onyx.galaxy.note.editor.view.toolbar.ColorView
                android:id="@+id/grid4"
                android:layout_marginStart="@dimen/dp_22"
                style="@style/colorViewStyleLarge"/>
            <com.onyx.galaxy.note.editor.view.toolbar.ColorView
                android:id="@+id/grid5"
                android:layout_marginStart="@dimen/dp_22"
                style="@style/colorViewStyleLarge"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.onyx.galaxy.note.p048ui.view.ShadowLayout>
