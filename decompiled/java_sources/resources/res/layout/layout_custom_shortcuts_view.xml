<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_custom_shortcuts_view_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <HorizontalScrollView
        android:id="@+id/left_scroll_view"
        android:scrollbars="none"
        android:layout_width="@dimen/dp_300"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/left_shortcut_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_camera"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_title_camera"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_screen_shot"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_title_screen_shot"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout
                android:id="@+id/record_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:layout_constraintTop_toTopOf="parent">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_record"
                    android:tag="binding_1"
                    android:src="@drawable/ic_title_audio"
                    android:layout_marginStart="0dp"
                    app:imageTint="@color/select_icon_edit_title_color"
                    style="@style/func_layout_left_item_style"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/secondary_200"
                    android:layout_gravity="center"
                    android:id="@+id/btn_record"
                    android:tag="binding_2"
                    android:background="@drawable/shape_record_time_bg"
                    android:padding="@dimen/dp_8"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_36"
                    android:minWidth="@dimen/dp_86"
                    android:drawableLeft="@drawable/ic_record_pause"
                    android:drawablePadding="@dimen/dp_5"
                    android:layout_marginVertical="@dimen/dp_2"
                    style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            </com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout>
            <com.onyx.android.sdk.theme.widgets.TintFrameLayout
                android:id="@+id/iv_audio_set"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12">
                <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                    android:id="@+id/iv_audio_set_normal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_title_audio_set"
                    app:imageTint="@color/select_icon_edit_title_color"/>
                <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                    android:id="@+id/iv_audio_set_preview"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_title_audio_set_preview"
                    app:imageTint="@color/select_icon_edit_title_color"/>
                <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                    android:id="@+id/iv_audio_set_new_record"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_title_audio_set_new_record"/>
            </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_title_more"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_title_more"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_slide"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_title_slide_bar"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_add_page"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_title_add_page"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_title_layer"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_title_layer"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout
                android:id="@+id/iv_touch_mode"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_touch_mode_stylus"
                    android:visibility="gone"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/ic_title_touch_stylus"
                    app:imageTint="@color/select_icon_edit_title_color"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_touch_mode_finger"
                    android:visibility="gone"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/ic_title_touch_finger"
                    app:imageTint="@color/select_icon_edit_title_color"/>
            </com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_adjust_page_whitespace"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_toolbar_page_whitespace_adjustment"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_doc_overview_full"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_toolbar_doc_overview_full"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_export_doc"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_toolbar_export_doc"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout
                android:id="@+id/iv_realtime_beautify"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12">
                <com.onyx.android.sdk.theme.widgets.TintFrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/iv_realtime_mode"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_realtime_mode_inner"
                        android:layout_width="@dimen/func_tool_layout_item_size"
                        android:layout_height="@dimen/func_tool_layout_item_size"
                        android:src="@drawable/icon_shortcut_beautify_on"
                        app:imageTint="@color/select_icon_edit_title_color"/>
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:layout_gravity="end|bottom"
                        android:id="@+id/iv_realtime_settings"
                        android:padding="@dimen/dp_5"
                        android:clickable="true"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/icon_shortcut_beautify_arrow"
                        android:scaleType="fitXY"
                        app:imageTint="@color/select_icon_edit_title_color"/>
                </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_non_realtime_mode"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/icon_shortcut_beautify_off"
                    app:imageTint="@color/select_icon_edit_title_color"/>
            </com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout>
            <com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout
                android:id="@+id/iv_reading_mode"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_reading_mode_note"
                    android:visibility="gone"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/ic_title_note_mode"
                    app:imageTint="@color/select_icon_edit_title_color"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_reading_mode_reading"
                    android:visibility="gone"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/ic_title_reading_mode"
                    app:imageTint="@color/select_icon_edit_title_color"/>
            </com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_counter"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/ic_toolbar_counter"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout
                android:id="@+id/iv_encryption"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_encryption_lock"
                    android:visibility="gone"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/ic_title_note_lock"
                    app:imageTint="@color/select_icon_edit_title_color"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_encryption_unlock"
                    android:visibility="gone"
                    android:layout_width="@dimen/func_tool_layout_item_size"
                    android:layout_height="@dimen/func_tool_layout_item_size"
                    android:src="@drawable/ic_title_note_unlock"
                    app:imageTint="@color/select_icon_edit_title_color"/>
            </com.onyx.galaxy.note.editor.view.PalmCollectionFrameLayout>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_note_overview"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/icon_toolbar_note_overview"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_note_mode"
                android:padding="0dp"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
            <com.onyx.galaxy.note.editor.view.PalmCollectionImageView
                android:id="@+id/iv_full_screen"
                android:visibility="gone"
                android:layout_width="@dimen/func_tool_layout_item_size"
                android:layout_height="@dimen/func_tool_layout_item_size"
                android:src="@drawable/icon_toolbar_full_screen"
                app:imageTint="@color/select_icon_edit_title_color"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/shortcutMaterialPressStyleRadiusDp12"/>
        </LinearLayout>
    </HorizontalScrollView>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/left_side_divider"
        android:visibility="gone"
        android:layout_marginVertical="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_scroll_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/verticalDividerStyle"/>
    <HorizontalScrollView
        android:id="@+id/right_scroll_view"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/right_shortcut_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
    </HorizontalScrollView>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/right_side_divider"
        android:visibility="gone"
        android:layout_marginVertical="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/right_scroll_view"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/verticalDividerStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
