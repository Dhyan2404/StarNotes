<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_manage_tag_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:tag="binding_1"
        android:background="@drawable/shape_common_dialog_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_528">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            app:layout_constraintBottom_toBottomOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView4"
            style="@style/textButtonStyle"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:text="@string/manager_tag_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"
            app:layout_constraintBottom_toBottomOf="@+id/textView4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView4"
            style="@style/textButtonStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/til_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:boxStrokeColor="@color/selector_search_edt_stroke_outline"
            app:endIconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.p039ui.TouchModeMaxLengthInputTextEdit
                android:textSize="@dimen/sp_14"
                android:id="@+id/tie_name"
                android:layout_width="match_parent"
                android:hint="@string/manager_tag_search_hint_title"
                android:maxLines="1"
                android:maxLength="@integer/tag_name_max_input_length"
                android:inputType="text"
                android:paddingStart="@dimen/dp_48"
                app:enableLengthRule="true"
                style="@style/dialogTextInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_search"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/icon_search_note"
            android:layout_marginStart="@dimen/dp_12"
            app:imageTint="@color/theme_icon_color_03"
            app:layout_constraintBottom_toBottomOf="@+id/til_name"
            app:layout_constraintStart_toStartOf="@+id/til_name"
            app:layout_constraintTop_toTopOf="@+id/til_name"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/manager_tag_hint_title"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_name"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/manager_tag_hint_sub_title"
            android:paddingHorizontal="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView6"/>
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:id="@+id/fl_list"
            android:background="@drawable/shape_select_folder_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:layout_marginVertical="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView7">
            <com.onyx.android.sdk.theme.widgets.TintCardView
                android:id="@+id/card_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/theme_background_popup_color_01"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <com.aitsuki.swipe.SwipeMenuRecyclerView
                    android:id="@+id/rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:splitMotionEvents="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </com.onyx.android.sdk.theme.widgets.TintCardView>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        <include
            android:id="@+id/include_empty_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/fl_list"
            app:layout_constraintEnd_toEndOf="@+id/fl_list"
            app:layout_constraintStart_toStartOf="@+id/fl_list"
            app:layout_constraintTop_toTopOf="@+id/textView6"
            layout="@layout/empty_view_manage_tag"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_create_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_edit_tag_for_note_create_tag"
            android:drawableLeft="@drawable/icon_manage_dialog_create"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="@+id/textView6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView6"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/manager_folder_search_result_title"
            app:layout_constraintStart_toStartOf="@+id/til_name"
            app:layout_constraintTop_toBottomOf="@+id/til_name"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:splitMotionEvents="false"
            android:layout_marginVertical="@dimen/dp_8"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/til_name"
            app:layout_constraintStart_toStartOf="@+id/til_name"
            app:layout_constraintTop_toBottomOf="@+id/textView9"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_list"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="textView6,textView7,fl_list,tv_create_tag"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_search_list"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="textView9,rv_search"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
