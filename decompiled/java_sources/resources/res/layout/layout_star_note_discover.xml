<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/star_note_discover_container"
    android:background="@color/theme_background_color_02"
    android:paddingBottom="@dimen/dp_40"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_24"
    android:paddingEnd="@dimen/dp_24">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:id="@+id/tv_star_note_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        app:layout_constraintBottom_toBottomOf="@+id/start_note_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/start_note_title"
        style="@style/commonPrimaryTextStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_18"
        android:id="@+id/start_note_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_35"
        android:text="@string/discover_star_note"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/commonTextStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/start_note_divider"
        android:background="@color/theme_divider_color_01"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp0_5"
        android:layout_marginTop="@dimen/dp_19"
        app:layout_constraintTop_toBottomOf="@+id/start_note_title"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:background="@drawable/ic_logo"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_note_divider"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:id="@+id/tv_discover_start_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/discover_more_about_star_note"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo"
        style="@style/commonPrimaryTextStyle"/>
    <com.onyx.galaxy.note.settings.p047ui.LongPressPalmCollectionTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_text_color_02"
        android:id="@+id/tv_version"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_discover_start_note"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_8"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_user_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_service_policy"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:layout_gravity="center_vertical"
            android:background="@color/theme_divider_color_01"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginEnd="@dimen/dp_2"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_privacy_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_privacy_policy"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:layout_gravity="center_vertical"
            android:background="@color/theme_divider_color_01"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_marginEnd="@dimen/dp_2"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_information_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_policy_information_list"/>
    </LinearLayout>
    <include
        android:id="@+id/layout_icp_container"
        layout="@layout/include_icp_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8"
        app:layout_constraintBottom_toTopOf="@+id/layout_icp_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_service_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/service_contact_prefix"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:layout_gravity="center_vertical"
            android:background="@color/theme_divider_color_01"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_star_note_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/copyright_star_note"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </LinearLayout>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
