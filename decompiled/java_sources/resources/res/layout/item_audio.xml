<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_content_layout"
    android:tag="layout/item_audio_0"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_74"
    android:paddingStart="@dimen/dp_16">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_audio_list_play"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginEnd="@dimen/dp_14"
        android:layout_alignParentStart="true"
        app:imageTint="@color/theme_icon_color_01"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/more_settings"
        android:layout_toEndOf="@+id/iv_play">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:ellipsize="end"
            android:id="@+id/title"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_duration"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_below="@+id/title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/tv_time"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_duration"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_toEndOf="@+id/tv_duration"/>
    </RelativeLayout>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/more_settings"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_action_more"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_alignParentEnd="true"
        app:imageTint="@color/theme_icon_color_01"
        style="@style/iconButtonStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintRadioButton
        android:id="@+id/checkbox"
        android:background="@drawable/selector_circle_selected"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:button="@null"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_alignParentEnd="true"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:layout_alignParentBottom="true"
        style="@style/dividerStyle"/>
</RelativeLayout>
