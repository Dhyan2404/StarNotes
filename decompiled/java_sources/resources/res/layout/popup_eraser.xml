<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_eraser_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_height"
        android:background="@drawable/popup_shadow_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="vertical"
            android:id="@+id/fl_content_layout"
            android:background="@drawable/shape_common_popup_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.p039ui.MediumTextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tool_popup_title_margin_top"
                android:text="@string/eraser"
                style="@style/commonTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/divider"
                android:layout_marginTop="@dimen/tool_popup_title_margin_top"
                style="@style/dividerStyle"/>
            <ScrollView
                android:layout_width="@dimen/dp_320"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingBottom="@dimen/tool_popup_padding_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_eraser_type_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.onyx.android.sdk.theme.widgets.TintImageView
                                android:layout_gravity="center"
                                android:id="@+id/pixel_eraser"
                                android:background="@drawable/rectangle_bg_selector"
                                android:padding="@dimen/dp_5"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:src="@drawable/ic_eraser_pixel"/>
                            <com.onyx.android.sdk.theme.widgets.TintTextView
                                android:textSize="@dimen/sp_12"
                                android:textColor="@color/theme_text_color_01"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:maxWidth="@dimen/dp_100"
                                android:text="@string/pixel_erasure"
                                android:paddingHorizontal="@dimen/dp_4"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.onyx.android.sdk.theme.widgets.TintImageView
                                android:layout_gravity="center"
                                android:id="@+id/stroke_eraser"
                                android:background="@drawable/rectangle_bg_selector"
                                android:padding="@dimen/dp_5"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:src="@drawable/ic_eraser_stroke"/>
                            <com.onyx.android.sdk.theme.widgets.TintTextView
                                android:textSize="@dimen/sp_12"
                                android:textColor="@color/theme_text_color_01"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:maxWidth="@dimen/dp_100"
                                android:text="@string/stroke_erasure"
                                android:paddingHorizontal="@dimen/dp_4"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.onyx.android.sdk.theme.widgets.TintImageView
                                android:id="@+id/select_eraser"
                                android:background="@drawable/rectangle_bg_selector"
                                android:padding="@dimen/dp_5"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:src="@drawable/ic_eraser_select"/>
                            <com.onyx.android.sdk.theme.widgets.TintTextView
                                android:textSize="@dimen/sp_12"
                                android:textColor="@color/theme_text_color_01"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4"
                                android:maxWidth="@dimen/dp_100"
                                android:text="@string/select_erasure"
                                android:paddingHorizontal="@dimen/dp_4"/>
                        </LinearLayout>
                    </LinearLayout>
                    <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
                        android:id="@+id/seek_bar_thickness"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tool_popup_seekbar_height"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/ll_eraser_type_container"
                        app:progressValueSuffix="@string/unit_mm"
                        app:seekBarTitle="@string/eraser_thickness"/>
                    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                        android:orientation="vertical"
                        android:id="@+id/lly_pressure_eraser"
                        android:background="@drawable/bg_pressure_sensitive_eraser"
                        android:paddingTop="@dimen/tool_popup_container_padding_top"
                        android:paddingBottom="@dimen/tool_popup_container_padding_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_container_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_container_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/seek_bar_thickness">
                        <FrameLayout
                            android:id="@+id/pressure_eraser_container"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/tool_popup_common_item_height"
                            android:layout_marginStart="@dimen/tool_popup_container_margin_start"
                            android:layout_marginEnd="@dimen/tool_popup_container_margin_end">
                            <com.onyx.android.sdk.theme.widgets.TintTextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/theme_text_color_01"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pressure_sensitive_eraser"
                                android:layout_marginEnd="@dimen/dp_48"
                                android:autoSizeTextType="uniform"
                                android:autoSizeMinTextSize="@dimen/sp_12"
                                android:autoSizeMaxTextSize="@dimen/sp_14"/>
                            <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                                android:layout_gravity="end|center_vertical"
                                android:id="@+id/switch_pressure_eraser"
                                android:textOn=""
                                android:textOff=""
                                app:thumbTint="@color/white"
                                style="@style/commonSwitchStyle"/>
                        </FrameLayout>
                        <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
                            android:id="@+id/seek_bar_pressure"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/tool_popup_seekbar_height"
                            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                            android:layout_marginStart="@dimen/tool_popup_container_margin_start"
                            android:layout_marginEnd="@dimen/tool_popup_container_margin_end"
                            app:isDisplayFloatValue="false"
                            app:isStick="true"
                            app:layout_constraintTop_toBottomOf="@+id/pressure_eraser_container"
                            app:progressValueSuffix="@string/unit_percent"
                            app:seekBarTitle="@string/pressure_sensitivity"
                            app:segmentCount="10"/>
                    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
                    <FrameLayout
                        android:id="@+id/scratch_erase_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tool_popup_common_item_height"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/lly_pressure_eraser">
                        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                            android:gravity="center_vertical"
                            android:layout_gravity="start|center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <com.onyx.android.sdk.theme.widgets.TintTextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/theme_text_color_01"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/scribble_erase"/>
                            <com.onyx.android.sdk.theme.widgets.TintImageView
                                android:id="@+id/iv_scribble_erase_guide"
                                android:layout_width="@dimen/dp_24"
                                android:layout_height="@dimen/dp_24"
                                android:src="@drawable/icon_guide"
                                android:layout_marginStart="@dimen/dp_4"/>
                        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
                        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/scribble_erase"
                            android:textOn=""
                            android:textOff=""
                            app:thumbTint="@color/white"
                            style="@style/commonSwitchStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/eraser_only_mark_pen_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tool_popup_common_item_height"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/scratch_erase_container">
                        <com.onyx.android.sdk.theme.widgets.TintTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/theme_text_color_01"
                            android:layout_gravity="start|center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/erase_only_mark_pen"/>
                        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/switch_only_mark_pen"
                            android:textOn=""
                            android:textOff=""
                            app:thumbTint="@color/white"
                            style="@style/commonSwitchStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/eraser_only_tape_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tool_popup_common_item_height"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/eraser_only_mark_pen_container">
                        <com.onyx.android.sdk.theme.widgets.TintTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/theme_text_color_01"
                            android:layout_gravity="start|center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/erase_the_tape_only"/>
                        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/switch_only_tape"
                            android:textOn=""
                            android:textOff=""
                            app:thumbTint="@color/white"
                            style="@style/commonSwitchStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/eraser_all_contains"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tool_popup_common_item_height"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/eraser_only_tape_container">
                        <com.onyx.android.sdk.theme.widgets.TintTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/theme_text_color_01"
                            android:layout_gravity="start|center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/erase_all_contains"/>
                        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/switch_all_contains"
                            android:textOn=""
                            android:textOff=""
                            app:thumbTint="@color/white"
                            style="@style/commonSwitchStyle"/>
                    </FrameLayout>
                    <View
                        android:id="@+id/view_divider_line"
                        android:background="@color/theme_bg_overlay_color_01"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp0_5"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/eraser_all_contains"/>
                    <FrameLayout
                        android:id="@+id/eraser_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tool_popup_common_item_height"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/view_divider_line">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_gravity="start|center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <com.onyx.android.sdk.theme.widgets.TintTextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/theme_text_color_01"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="@dimen/dp_200"
                                android:text="@string/erase_cancel"/>
                            <com.onyx.android.sdk.theme.widgets.TintImageView
                                android:id="@+id/iv_erase_cancel_guide"
                                android:layout_width="@dimen/dp_24"
                                android:layout_height="@dimen/dp_24"
                                android:src="@drawable/icon_guide"
                                android:layout_marginStart="@dimen/dp_4"/>
                        </LinearLayout>
                        <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/switch_eraser_cancel"
                            android:textOn=""
                            android:textOff=""
                            app:thumbTint="@color/white"
                            style="@style/commonSwitchStyle"/>
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/error_200"
                        android:gravity="center"
                        android:id="@+id/tv_clear_page"
                        android:background="@drawable/shape_rectangle_error_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
                        android:text="@string/clear_the_current_page"
                        android:layout_marginStart="@dimen/tool_popup_margin_start"
                        android:layout_marginEnd="@dimen/tool_popup_margin_end"
                        app:layout_constraintTop_toBottomOf="@+id/eraser_cancel"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </FrameLayout>
</FrameLayout>
