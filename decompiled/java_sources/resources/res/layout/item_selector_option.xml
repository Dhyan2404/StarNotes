<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_selector_option_0"
    android:background="@drawable/ripple_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48"
    android:paddingHorizontal="@dimen/dp_12">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/selector_tab_item_icon_color"
        android:id="@+id/displayText"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/selectedIcon"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ic_ink_selected"
        android:scaleType="centerInside"
        app:imageTint="@color/theme_primary_color_01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/bottomDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/dividerStyle"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
