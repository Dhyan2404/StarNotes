<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_note_export_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:tag="@string/auto_size_dialog_tag"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_24">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_file"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_primary_color_01"
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tv_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_120"
                android:text="@string/only_export"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/export_type_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vector_pdf"
                android:background="@drawable/selector_export_pdf_edit_bg"
                android:layout_width="@dimen/dp_116"
                android:layout_height="@dimen/dp_100">
                <ImageView
                    android:id="@+id/iv_vector_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:src="@drawable/ic_export_pdf_edit_enable"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/select_theme_text_color_01_check"
                    android:gravity="center"
                    android:id="@+id/tv_vector_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/vector_pdf"
                    android:paddingHorizontal="@dimen/dp_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_vector_pdf"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bitmap_pdf"
                android:background="@drawable/selector_export_pdf_edit_unable_bg"
                android:layout_width="@dimen/dp_116"
                android:layout_height="@dimen/dp_100">
                <ImageView
                    android:id="@+id/iv_bitmap_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:src="@drawable/ic_export_pdf_edit_unable"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/select_theme_text_color_01_check"
                    android:gravity="center"
                    android:id="@+id/tv_bitmap_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/bitmap_pdf"
                    android:paddingHorizontal="@dimen/dp_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_bitmap_pdf"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/image_file"
                android:background="@drawable/selector_export_pic_bg"
                android:layout_width="@dimen/dp_116"
                android:layout_height="@dimen/dp_100">
                <ImageView
                    android:id="@+id/iv_image_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:src="@drawable/ic_export_pic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/select_theme_text_color_01_check"
                    android:gravity="center"
                    android:id="@+id/tv_image_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/picture"
                    android:paddingHorizontal="@dimen/dp_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_image_file"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/note_file"
                android:background="@drawable/selector_export_star_note_bg"
                android:layout_width="@dimen/dp_116"
                android:layout_height="@dimen/dp_100">
                <ImageView
                    android:id="@+id/iv_note_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    android:src="@drawable/ic_export_star_note"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/select_theme_text_color_01_check"
                    android:gravity="center"
                    android:id="@+id/tv_note_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/star_note"
                    android:paddingHorizontal="@dimen/dp_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_note_file"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_90">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="center"
                android:id="@+id/format_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vector_pdf_desc"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/format_waring_desc_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">
                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/icon_export_warning"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/warning_200"
                    android:gravity="start"
                    android:layout_gravity="center"
                    android:id="@+id/format_waring_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vector_pdf_warning_desc"
                    android:layout_marginStart="@dimen/dp_4"/>
            </LinearLayout>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/document_name"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/til_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                android:textSize="@dimen/sp_16"
                android:gravity="start|center_vertical"
                android:id="@+id/tie_name"
                android:layout_width="match_parent"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                app:enableLengthRule="true"
                style="@style/textInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_export_pages"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_6">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_02"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_document_range"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_03"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_export_pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="@dimen/dp_8"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintCheckBox
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/exportWithBackground"
            android:paddingLeft="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:checked="true"
            android:button="@drawable/sel_checkbox"
            android:text="@string/export_include_template"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_btn_color"
            android:gravity="center"
            android:id="@+id/tv_share"
            android:background="@drawable/theme_ripple_dialog_primary_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/popup_note_list_export_and_share"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_03"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/save_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_16"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
