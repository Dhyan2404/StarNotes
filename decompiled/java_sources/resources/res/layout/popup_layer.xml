<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root"
    android:tag="layout/popup_layer_0"
    android:background="@drawable/popup_shadow_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_240"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_8">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/select"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_sticker_select"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                app:cornerRadius="@dimen/dp_4"
                app:imageTint="@color/theme_icon_color_02"
                style="@style/materialPressStyleRadiusDp08"/>
            <com.onyx.android.sdk.p039ui.MediumTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layer"
                android:layout_centerInParent="true"
                android:layout_marginVertical="@dimen/tool_popup_title_margin_top"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_4"
                android:layout_alignParentEnd="true">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_close_popup"
                    app:imageTint="@color/theme_icon_color_03"
                    style="@style/materialPressStyleRadiusDp08"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/finish"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_80"
                    android:text="@string/finish"
                    android:maxLines="@integer/text_view_max_lines_1"
                    android:layout_marginEnd="@dimen/dp_6_"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="@dimen/sp_12"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:autoSizeMaxTextSize="@dimen/sp_14"
                    app:cornerRadius="@dimen/dp_0"
                    style="@style/materialPressStyleBtnRadiusDp08"/>
            </FrameLayout>
        </RelativeLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_primary_color_01"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/add_layer"
                android:padding="@dimen/dp_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_layer"
                android:drawableLeft="@drawable/ic_layer_add"
                android:drawablePadding="@dimen/dp_4"
                app:drawableLeftTint="@color/theme_primary_color_01"
                style="@style/materialPressStyleRadiusDp12"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/selection_action_layout"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_8">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/selector_delete_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/delete"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="@string/delete"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/dp_2"
                    android:paddingVertical="@dimen/dp_5"
                    app:cornerRadius="@dimen/dp_0"
                    style="@style/materialSelectPressStyleNoRadiusError"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/selector_primary_gray_color_select"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/merge"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="@string/merge"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/dp_2"
                    android:paddingVertical="@dimen/dp_5"
                    app:cornerRadius="@dimen/dp_0"
                    style="@style/materialSelectPressStyleNoRadius"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/selector_primary_gray_color_select"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/clean"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="@string/clean"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/dp_2"
                    android:paddingVertical="@dimen/dp_5"
                    app:cornerRadius="@dimen/dp_0"
                    style="@style/materialSelectPressStyleNoRadius"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/selector_primary_gray_color_select"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/rename"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:text="@string/rename"
                    android:layout_weight="1"
                    android:paddingHorizontal="@dimen/dp_2"
                    android:paddingVertical="@dimen/dp_5"
                    app:cornerRadius="@dimen/dp_0"
                    style="@style/materialSelectPressStyleNoRadius"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
        <com.onyx.galaxy.note.common.view.MaxHeightRecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_8"
            app:maxHeight="@dimen/dp_672"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
