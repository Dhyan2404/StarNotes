<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cls_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_op"
            android:background="@drawable/bg_item_tree_normal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dp_12"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_note_tree_folder_bottom"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/icon_item_folder_list_bottom"
            app:layout_constraintBottom_toBottomOf="@+id/iv_note_tree_folder"
            app:layout_constraintEnd_toEndOf="@+id/iv_note_tree_folder"
            app:layout_constraintStart_toStartOf="@+id/iv_note_tree_folder"
            app:layout_constraintTop_toTopOf="@+id/iv_note_tree_folder"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_note_tree_folder"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/icon_item_folder_list"
            android:layout_marginStart="@dimen/dp_36"
            app:imageTint="@color/theme_icon_color_01"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:ellipsize="end"
            android:id="@+id/tv_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_note_total_count"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_note_tree_folder"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/tv_note_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_48"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_folder_expand"
            android:layout_width="@dimen/dp_48"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:layout_marginEnd="@dimen/dp_8"
            app:imageTint="@color/theme_icon_color_02"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_drag_top"
            android:background="@drawable/shape_item_folder_drag_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_2"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:layout_marginVertical="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_drag_in"
            android:background="@drawable/shape_item_folder_drag_in"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:layout_marginVertical="@dimen/dp_4"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_drag_bottom"
            android:background="@drawable/shape_item_folder_drag_bottom"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_2"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:layout_marginVertical="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
