<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_local_restore_file_0"
    android:background="@color/theme_background_color_01"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_24"
    android:paddingEnd="@dimen/dp_24">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/icon_back"
        android:layout_marginStart="@dimen/dp_8"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/materialPressStyleRadiusDp08"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_35"
        android:text="@string/import_backup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:enabled="false"
        android:textColor="@color/selector_text_import_enable"
        android:gravity="center"
        android:id="@+id/btn_import"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_40"
        android:text="@string/import_files"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/materialBtnEnablePrimaryRadius12"/>
    <FrameLayout
        android:id="@+id/fl_search_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <com.onyx.android.sdk.theme.widgets.TintEditText
            android:textColor="@color/theme_text_color_01"
            android:textColorHint="@color/theme_text_color_03"
            android:id="@+id/edt_search"
            android:background="@drawable/selector_edit_text_search"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/please_enter_name_of_document"
            android:paddingStart="@dimen/dp_46"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_search_gray"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16"
            app:backgroundTint="@color/theme_icon_color_02"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_delete"
            android:background="@drawable/ic_settings_close"
            android:visibility="gone"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_16"
            app:backgroundTint="@color/theme_icon_color_02"/>
    </FrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/theme_primary_color_01"
        android:id="@+id/tv_select_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/select_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_search_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginVertical="@dimen/dp_24"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_select_all"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
