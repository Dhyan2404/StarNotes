<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/include_ballpoint_pen_popup_params_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
        android:id="@+id/seek_bar_thickness"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_68"
        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
        android:layout_marginStart="@dimen/tool_popup_margin_start"
        android:layout_marginEnd="@dimen/tool_popup_margin_end"
        app:layout_constraintTop_toTopOf="parent"
        app:progressValueSuffix="@string/unit_mm"
        app:seekBarTitle="@string/thickness"/>
    <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
        android:id="@+id/seek_bar_smooth"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_68"
        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
        android:layout_marginStart="@dimen/tool_popup_margin_start"
        android:layout_marginEnd="@dimen/tool_popup_margin_end"
        app:isDisplayFloatValue="false"
        app:isStick="true"
        app:layout_constraintTop_toBottomOf="@+id/seek_bar_thickness"
        app:progressValueSuffix="@string/unit_percent"
        app:seekBarTitle="@string/smooth"
        app:segmentCount="10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
