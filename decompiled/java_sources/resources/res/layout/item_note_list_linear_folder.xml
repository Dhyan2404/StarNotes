<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_item_tree"
    android:layout_width="match_parent"
    android:layout_height="@dimen/folder_linear_item_height">
    <View
        android:id="@+id/v_click_open"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_option"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_click_option"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_option"
        app:layout_constraintEnd_toEndOf="@+id/iv_option"
        app:layout_constraintStart_toStartOf="@+id/iv_option"
        app:layout_constraintTop_toTopOf="@+id/iv_option"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_thumbnail"
        android:layout_width="@dimen/dp_80"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/v_folder_bottom_shadow"
            android:background="@drawable/note_list_item_shadow"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_20"
            android:translationY="@dimen/dp_8_"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toBottomOf="@+id/iv_face_bottom"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_bottom"
            android:padding="0dp"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_80"
            android:src="@drawable/icon_folder_face_bottom"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/folder_small_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_52"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_fourth_top"
            android:padding="0dp"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_80"
            android:src="@drawable/icon_folder_face_fourth_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/folder_small_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_thr_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_folder_face_thr_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_sec_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_folder_face_sec_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@mipmap/ic_folder_face_top_shadow"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@drawable/shape_note_list_item_folder_small_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_folder_face_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_small_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_drag_in"
            android:background="@drawable/shape_item_linear_folder_drag_in"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_small_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_text_color_01"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_38"
        android:maxEms="@integer/folder_name_max_length"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/iv_option"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/cl_thumbnail"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/theme_text_color_03"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_option"
        android:layout_width="@dimen/dp_24"
        android:layout_height="0dp"
        android:src="@drawable/icon_tree_arrow"
        android:scaleType="center"
        app:imageTint="@color/theme_icon_color_02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintCheckBox
        android:id="@+id/cb_sel"
        android:background="@drawable/sel_note_list_checkbox"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:button="@null"
        app:layout_constraintBottom_toBottomOf="@+id/iv_option"
        app:layout_constraintEnd_toEndOf="@+id/iv_option"
        app:layout_constraintStart_toStartOf="@+id/iv_option"
        app:layout_constraintTop_toTopOf="@+id/iv_option"/>
    <com.onyx.galaxy.note.category.view.TagsLinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_tags"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_20"
        android:layout_marginVertical="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="@+id/tv_name"
        app:layout_constraintStart_toStartOf="@+id/tv_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"
        app:tagHorizontalMargin="@dimen/dp_4"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:background="@color/theme_divider_color_01"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp0_5"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_time"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_drag_bottom"
        android:background="@drawable/shape_item_folder_drag_bottom"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_time"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_drag_top"
        android:background="@drawable/shape_item_folder_drag_bottom"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_time"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
