<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/popup_upgrade_text_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialogRoot"
        android:background="@color/theme_background_popup_color_01"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_100"
            android:src="@drawable/fg_upgrade_text_header"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:maxWidth="@dimen/dp_240"
            android:fontFamily="sans-serif"
            android:textFontWeight="@integer/font_weight_Medium"/>
        <com.onyx.galaxy.note.p048ui.view.NotificationRichTextView
            android:gravity="start|center_vertical"
            android:id="@+id/contentText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_12"
            android:maxHeight="@dimen/dp_240"
            android:fontFamily="sans-serif"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:basicHeight="@dimen/dp_360"
            app:maxScreenRatioY="0.7"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/selector_login_btn_text_color"
            android:gravity="center"
            android:id="@+id/confirmButton"
            android:background="@drawable/selector_fill_blue_gray_ripple"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/upgrade_start"
            android:layout_marginHorizontal="@dimen/dp_24"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/theme_text_color_03"
            android:gravity="center"
            android:id="@+id/cancelButton"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_24"
            android:minHeight="@dimen/dp_18"
            android:text="@string/upgrade_exit"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    <View
        android:id="@+id/dialogTop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/px_1"
        app:layout_constraintBottom_toTopOf="@+id/dialogRoot"
        app:layout_constraintTop_toTopOf="@+id/dialogRoot"/>
    <ImageView
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_96"
        android:src="@drawable/ic_rocket"
        app:layout_constraintBottom_toBottomOf="@+id/dialogTop"
        app:layout_constraintLeft_toLeftOf="@+id/dialogRoot"
        app:layout_constraintRight_toRightOf="@+id/dialogRoot"
        app:layout_constraintTop_toTopOf="@+id/dialogTop"/>
</androidx.constraintlayout.widget.ConstraintLayout>
