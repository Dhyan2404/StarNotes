<?xml version="1.0" encoding="utf-8"?>
<com.onyx.galaxy.note.p048ui.view.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shadowLayout"
    android:tag="layout/item_candidate_shortcut_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:shadowColor="@color/black_percent_15"
    app:shadowRadius="@dimen/dp_5"
    app:showShadow="false">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/ic_eye"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/icon_shortcut_eye_disabled"
            android:layout_marginStart="@dimen/dp_16"
            app:imageTint="@color/theme_icon_color_03"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/menu_icon"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_16"
            app:imageTint="@color/theme_icon_color_03"/>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_12">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_03"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_8"
                android:minWidth="@dimen/dp_52"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_30"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/ic_drag_tag"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_margin="@dimen/dp_8"
                android:src="@drawable/ic_custom_tool_drag"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:imageTint="@color/theme_icon_color_03"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_line"
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
</com.onyx.galaxy.note.p048ui.view.ShadowLayout>
