<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:tag="layout/layout_sticker_category_select_0"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50"
    android:paddingHorizontal="@dimen/dp_16"
    style="@style/materialSelectPressStyleNoRadius">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_01"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxEms="@integer/name_max_length"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/selected_image"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/selected_image"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginRight="@dimen/dp_16"
        android:src="@drawable/ic_selected"
        app:imageTint="@color/theme_primary_color_01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:background="@color/theme_divider_color_01"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp0_5"
        app:layout_constraintBottom_toBottomOf="parent"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
