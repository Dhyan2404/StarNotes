<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_convert_file_progress_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/shape_progress_dialog_bg"
        android:paddingBottom="@dimen/dp_24"
        android:layout_width="@dimen/dp_360"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.DynamicImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_68"
            android:src="@drawable/ic_progress_popup_bg"
            android:scaleType="fitXY"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_56"
            android:text="@string/import_file"
            app:layout_constraintBottom_toBottomOf="@+id/iv_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_close"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:src="@drawable/ic_close_dialog"
            android:layout_marginEnd="@dimen/dp_16"
            app:imageTint="@color/theme_icon_color_03"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <com.onyx.android.sdk.theme.widgets.TintFrameLayout
                android:background="@drawable/doc_import_progress_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.onyx.android.sdk.theme.widgets.TintProgressBar
                    android:orientation="horizontal"
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_10"
                    android:progress="20"
                    android:progressDrawable="@drawable/doc_import_progress_drawable"
                    android:thumb="@null"
                    android:progressTint="@color/theme_primary_color_01"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title"
                    style="@style/commonProgressStyle"/>
            </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_value_container"
            android:visibility="visible"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="@+id/progress_container"
            app:layout_constraintStart_toStartOf="@+id/progress_container"
            app:layout_constraintTop_toBottomOf="@+id/progress_container">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_progress_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/doc_converting"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/downloadingButton"
                android:padding="@dimen/dp_4"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/icon_loading"
                app:imageTint="@color/theme_icon_color_03"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_progress_title"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/percent_progress"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/wait_container"
            android:visibility="gone"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="@+id/progress_container"
            app:layout_constraintStart_toStartOf="@+id/progress_container"
            app:layout_constraintTop_toBottomOf="@+id/progress_container">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_wait_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/convert_waiting_tips"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/warning_200"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_wait_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭后将退出队列，需重新排队"
                    android:drawableLeft="@drawable/ic_warning"
                    android:drawablePadding="@dimen/dp_4"
                    app:drawableLeftTint="@color/warning_200"
                    app:layout_constraintEnd_toEndOf="@+id/progress_container"
                    app:layout_constraintTop_toBottomOf="@+id/progress_container"/>
            </FrameLayout>
        </LinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
