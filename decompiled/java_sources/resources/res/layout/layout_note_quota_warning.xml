<?xml version="1.0" encoding="utf-8"?>
<com.onyx.galaxy.note.p048ui.view.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_40"
    android:layout_marginHorizontal="@dimen/dp_24"
    app:cornerRadius="@dimen/dp_12"
    app:layout_constraintBottom_toBottomOf="parent"
    app:shadowColor="@color/black_percent_08"
    app:shadowDy="@dimen/dp_1"
    app:shadowRadius="@dimen/dp_16"
    app:showBorder="false"
    app:showShadow="true">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/shape_round_solid_white_border"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_22">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="vertical"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_24">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textStyle="bold"
                android:textColor="@color/theme_text_color_01"
                android:ellipsize="end"
                android:id="@+id/contentText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif"
                android:textFontWeight="@integer/font_weight_Medium"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_12"
                android:textColor="@color/theme_text_color_02"
                android:ellipsize="end"
                android:id="@+id/contentText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:maxLines="3"
                android:fontFamily="sans-serif"
                android:textFontWeight="@integer/font_weight_Regular"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/theme_text_btn_color"
            android:gravity="center"
            android:id="@+id/confirmButton"
            android:background="@drawable/md_ui_shape_solid_primary"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dp_10"
            android:paddingHorizontal="@dimen/dp_24"
            android:textFontWeight="@integer/font_weight_Regular"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/closeButton"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_guide_close"
            android:scaleType="centerInside"
            android:minWidth="@dimen/dp_112"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:imageTint="@color/theme_text_color_01"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.galaxy.note.p048ui.view.ShadowLayout>
