<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.p039ui.MediumTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/tv_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.onyx.galaxy.note.common.view.MaxHeightFrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:minHeight="@dimen/dp_140">
        <com.onyx.galaxy.note.category.p044ui.TemplateRecycleView
            android:orientation="horizontal"
            android:id="@+id/rl_template_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.onyx.galaxy.note.common.view.MaxHeightFrameLayout>
</LinearLayout>
