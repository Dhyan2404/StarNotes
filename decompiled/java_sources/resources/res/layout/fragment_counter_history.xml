<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_counter_history_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_396">
        <com.onyx.galaxy.note.p048ui.view.ThemeRecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_16">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/selection"
            android:padding="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/materialPressStyleRadiusDp08"/>
        <RelativeLayout
            android:id="@+id/selection_layout"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/selector_primary_gray_color_select"
                android:gravity="center"
                android:id="@+id/select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_100"
                android:text="@string/select_all"
                android:layout_centerVertical="true"
                android:paddingHorizontal="@dimen/dp_6"
                android:paddingVertical="@dimen/dp_8"
                style="@style/materialPressStyleRadiusDp08"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textColor="@color/selector_delete_color"
                android:id="@+id/delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_toEndOf="@+id/select_all"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_8"
                style="@style/materialPressStyleRadiusDp08"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_btn_color"
                android:gravity="center"
                android:id="@+id/finish"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_28"
                android:text="@string/finish"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/materialBtnPrimaryRadius08"/>
        </RelativeLayout>
    </RelativeLayout>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
