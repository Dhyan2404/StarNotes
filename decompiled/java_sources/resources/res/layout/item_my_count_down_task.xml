<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_my_count_down_task_0"
    android:background="@drawable/theme_ripple_bg_no_radius"
    android:padding="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/theme_text_color_03"
        android:id="@+id/tv_count_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/theme_text_color_01"
        android:gravity="center"
        android:id="@+id/tv_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginStart="@dimen/dp_8"
        android:textFontWeight="@integer/font_weight_Bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_count_name"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_expand_flag_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_counter_arrow_down"
        android:layout_marginStart="@dimen/dp_4"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/tv_total_time"
        app:layout_constraintStart_toEndOf="@+id/tv_total_time"
        app:layout_constraintTop_toTopOf="@+id/tv_total_time"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_more_option"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/icon_counter_more"
        android:scaleType="centerInside"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="@+id/tv_total_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_count_name"
        style="@style/materialPressStyleRadiusDp08"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/theme_primary_color_01"
        android:id="@+id/tv_start"
        android:background="@drawable/shape_counter_button_border_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/counter_task_start"
        android:layout_marginEnd="@dimen/dp_8"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_7"
        android:textFontWeight="@integer/font_weight_Medium"
        app:layout_constraintBottom_toBottomOf="@+id/tv_total_time"
        app:layout_constraintEnd_toStartOf="@+id/iv_more_option"
        app:layout_constraintTop_toTopOf="@+id/tv_count_name"/>
    <com.onyx.android.sdk.theme.widgets.TintRecycleView
        android:id="@+id/rv_task_time_list"
        android:background="@drawable/shape_counter_task_detail_bg"
        android:padding="@dimen/dp_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_count_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_time"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
