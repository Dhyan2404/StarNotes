<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_insert_page_0"
    android:background="@drawable/popup_shadow_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/shape_common_popup_bg"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_page"
            android:layout_marginVertical="@dimen/tool_popup_title_margin_top"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"/>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.onyx.android.sdk.theme.widgets.TintCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    app:cardBackgroundColor="@color/theme_background_color_02"
                    app:cardCornerRadius="@dimen/dp_8"
                    app:cardElevation="0dp"
                    app:contentPadding="@dimen/dp_2">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.onyx.android.sdk.theme.widgets.TintRadioButton
                            android:id="@+id/prev_current_page_radio"
                            android:text="@string/before_current_page"
                            style="@style/popup_insert_page_radio_btn_style"/>
                        <com.onyx.android.sdk.theme.widgets.TintRadioButton
                            android:id="@+id/after_current_page_radio"
                            android:checked="true"
                            android:text="@string/after_current_page"
                            style="@style/popup_insert_page_radio_btn_style"/>
                        <com.onyx.android.sdk.theme.widgets.TintRadioButton
                            android:id="@+id/last_page_radio"
                            android:text="@string/the_last_page"
                            style="@style/popup_insert_page_radio_btn_style"/>
                    </RadioGroup>
                </com.onyx.android.sdk.theme.widgets.TintCardView>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_text_color_02"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_130"
                        android:text="@string/recently_used"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintBottom_toBottomOf="@+id/more_template"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/more_template"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_primary_color_01"
                        android:gravity="center"
                        android:id="@+id/more_template"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/more_template"
                        android:drawableRight="@drawable/ic_arrow_right"
                        android:paddingEnd="@dimen/dp_0"
                        android:layout_marginEnd="@dimen/dp_12"
                        app:drawableRightTint="@color/theme_primary_color_01"
                        app:iconGravity="textEnd"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/materialPressStyleBtnRadiusDp08"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginHorizontal="@dimen/dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/more_template"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/add_note_pages"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/add_note_pages"
                    android:drawableLeft="@drawable/ic_add_note_page"
                    style="@style/popup_insert_page_btn_style"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/paste_page"
                    android:visibility="gone"
                    android:text="@string/paste_page"
                    android:drawableLeft="@drawable/ic_paste"
                    style="@style/popup_insert_page_btn_style"/>
                <com.onyx.android.sdk.theme.widgets.TintView
                    android:background="@color/theme_divider_color_01"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp0_5"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:layout_marginVertical="@dimen/dp_8"
                    android:paddingHorizontal="@dimen/dp_16"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/import_file"
                    android:text="@string/import_file"
                    android:drawableLeft="@drawable/ic_create_note_file_import"
                    style="@style/popup_insert_page_btn_style"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/import_pic"
                    android:text="@string/import_picture"
                    android:drawableLeft="@drawable/ic_create_note_pic_import"
                    style="@style/popup_insert_page_btn_style"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/take_photo"
                    android:text="@string/take_photo"
                    android:drawableLeft="@drawable/ic_create_note_camera"
                    style="@style/popup_insert_page_btn_style"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/scan_file"
                    android:visibility="gone"
                    android:text="@string/doc_scanner"
                    android:drawableLeft="@drawable/ic_create_note_scan_import"
                    style="@style/popup_insert_page_btn_style"/>
            </LinearLayout>
        </ScrollView>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
