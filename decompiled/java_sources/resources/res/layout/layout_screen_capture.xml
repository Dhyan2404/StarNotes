<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_screen_capture_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="top|left"
        android:orientation="horizontal"
        android:id="@+id/buttonGroup"
        android:background="@drawable/shape_screen_capture_btn_bg"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_40"
        android:translationZ="@dimen/dp_1"
        android:elevation="@dimen/dp_1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_cancel"
            android:padding="@dimen/dp_8"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_40"
            android:src="@drawable/ic_screen_capture_close"/>
        <View
            android:background="@color/divider_line"
            android:layout_width="@dimen/dp_0_5"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_ok"
            android:padding="@dimen/dp_8"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_40"
            android:src="@drawable/ic_screen_capture_confirm"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top|left"
        android:id="@+id/shot_container"
        android:layout_width="@dimen/layout_screen_capture_editor_size"
        android:layout_height="@dimen/layout_screen_capture_editor_size">
        <View
            android:id="@+id/shot_view"
            android:background="@drawable/shape_screen_capture_bg"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_margin="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_top_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toTopOf="@+id/shot_view"
            app:layout_constraintEnd_toStartOf="@+id/shot_view"
            app:layout_constraintStart_toStartOf="@+id/shot_view"
            app:layout_constraintTop_toTopOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_top_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toTopOf="@+id/shot_view"
            app:layout_constraintEnd_toEndOf="@+id/shot_view"
            app:layout_constraintStart_toEndOf="@+id/shot_view"
            app:layout_constraintTop_toTopOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/top_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toTopOf="@+id/shot_view"
            app:layout_constraintEnd_toEndOf="@+id/shot_view"
            app:layout_constraintStart_toStartOf="@+id/shot_view"
            app:layout_constraintTop_toTopOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bottom_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toBottomOf="@+id/shot_view"
            app:layout_constraintEnd_toEndOf="@+id/shot_view"
            app:layout_constraintStart_toStartOf="@+id/shot_view"
            app:layout_constraintTop_toBottomOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toBottomOf="@+id/shot_view"
            app:layout_constraintEnd_toStartOf="@+id/shot_view"
            app:layout_constraintStart_toStartOf="@+id/shot_view"
            app:layout_constraintTop_toTopOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toBottomOf="@+id/shot_view"
            app:layout_constraintEnd_toEndOf="@+id/shot_view"
            app:layout_constraintStart_toEndOf="@+id/shot_view"
            app:layout_constraintTop_toTopOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_bottom_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toBottomOf="@+id/shot_view"
            app:layout_constraintEnd_toStartOf="@+id/shot_view"
            app:layout_constraintStart_toStartOf="@+id/shot_view"
            app:layout_constraintTop_toBottomOf="@+id/shot_view"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_bottom_handle"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_screen_capture_item"
            app:layout_constraintBottom_toBottomOf="@+id/shot_view"
            app:layout_constraintEnd_toEndOf="@+id/shot_view"
            app:layout_constraintStart_toEndOf="@+id/shot_view"
            app:layout_constraintTop_toBottomOf="@+id/shot_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
