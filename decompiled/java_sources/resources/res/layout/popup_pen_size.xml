    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_100">
        <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
            android:id="@+id/seek_bar_thickness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_76"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintTop_toTopOf="parent"
            app:progressValueSuffix="@string/unit_mm"
            app:seekBarTitle="@string/thickness"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
