<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_audio_list_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_47"
            android:text="@string/audio"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"/>
        <com.aitsuki.swipe.SwipeMenuRecyclerView
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/recyclerView"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="@dimen/dp_300"
            android:layout_weight="1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textColor="@color/theme_primary_color_01"
                android:id="@+id/selection"
                android:padding="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/materialPressStyleRadiusDp08"/>
            <RelativeLayout
                android:id="@+id/selection_layout"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/selector_primary_gray_color_select"
                    android:gravity="center"
                    android:id="@+id/select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_100"
                    android:text="@string/select_all"
                    android:drawableLeft="@drawable/selector_circle_selected"
                    android:layout_centerVertical="true"
                    android:paddingHorizontal="@dimen/dp_6"
                    android:paddingVertical="@dimen/dp_8"
                    style="@style/materialPressStyleRadiusDp08"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textColor="@color/selector_delete_color"
                    android:id="@+id/delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/delete"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_toEndOf="@+id/select_all"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_8"
                    style="@style/materialPressStyleRadiusDp08"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/theme_text_btn_color"
                    android:gravity="center"
                    android:id="@+id/finish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finish"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    style="@style/materialBtnPrimaryRadius08"/>
            </RelativeLayout>
        </RelativeLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
