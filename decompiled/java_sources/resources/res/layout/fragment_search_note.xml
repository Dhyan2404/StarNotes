<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_search_note_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/cls"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutDescription="@xml/fragment_search_note_scene">
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_bg"
            android:background="@color/theme_background_color_01"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:id="@+id/ll_ops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/iv_expand"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:src="@drawable/ic_expand"
                android:layout_marginEnd="@dimen/dp_10"
                app:imageTint="@color/theme_icon_color_01"
                style="@style/materialPressStyleRadiusDp12"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/iv_setting"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:src="@drawable/ic_settings"
                android:layout_marginEnd="@dimen/dp_10"
                app:iconSize="@dimen/dp_40"
                app:imageTint="@color/theme_icon_color_01"
                style="@style/materialPressStyleRadiusDp12"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/iv_library"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:src="@drawable/ic_library"
                app:iconSize="@dimen/dp_40"
                app:imageTint="@color/theme_icon_color_01"
                style="@style/materialPressStyleRadiusDp12"/>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/search"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_ops"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_input_layout_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_24"
            app:boxBackgroundColor="@color/theme_background_color_02"
            app:boxCornerRadiusBottomEnd="@dimen/dp_12"
            app:boxCornerRadiusBottomStart="@dimen/dp_12"
            app:boxCornerRadiusTopEnd="@dimen/dp_12"
            app:boxCornerRadiusTopStart="@dimen/dp_12"
            app:boxStrokeColor="@color/selector_search_edt_stroke_outline"
            app:boxStrokeWidth="@dimen/dp0_5"
            app:boxStrokeWidthFocused="@dimen/dp0_5"
            app:endIconDrawable="@drawable/icon_login_clear"
            app:endIconMode="clear_text"
            app:endIconTint="@null"
            app:hintEnabled="false"
            app:layout_constraintEnd_toStartOf="@+id/barrier1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TextInputLayoutStyle">
            <com.onyx.android.sdk.theme.widgets.TintTextInputEditTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="start|center_vertical"
                android:id="@+id/text_input_edit_text_view_name"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:hint="@string/note_search_hint"
                android:maxLines="1"
                android:maxLength="@integer/search_note_keyword_length"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:paddingStart="@dimen/dp_48"
                android:paddingEnd="@dimen/dp_48"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:id="@+id/loadingLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:elevation="@dimen/dp_1"
            app:cornerRadius="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="@+id/text_input_layout_name"
            app:layout_constraintStart_toStartOf="@+id/text_input_layout_name"
            app:layout_constraintTop_toBottomOf="@+id/text_input_layout_name"
            app:shadowColor="@color/black_percent_08"
            app:shadowDy="@dimen/dp_1"
            app:shadowRadius="@dimen/dp_8"
            app:showBorder="false"
            app:showShadow="true">
            <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/shape_search_loading_bg"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_32"
                android:paddingStart="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_8">
                <ImageView
                    android:id="@+id/loadingView"
                    android:background="@drawable/animate_loading"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/theme_text_color_01"
                    android:ellipsize="none"
                    android:id="@+id/progressText"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_4"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/theme_text_color_02"
                    android:id="@+id/countText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/closeSearchButton"
                    android:clickable="true"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ic_close_dialog"
                    android:paddingEnd="@dimen/dp_8"
                    app:imageTint="@color/theme_icon_color_03"/>
            </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_search"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/icon_search_note"
            android:layout_marginStart="@dimen/dp_12"
            app:imageTint="@color/theme_icon_color_03"
            app:layout_constraintBottom_toBottomOf="@+id/text_input_layout_name"
            app:layout_constraintStart_toStartOf="@+id/text_input_layout_name"
            app:layout_constraintTop_toTopOf="@+id/text_input_layout_name"/>
        <com.onyx.galaxy.note.category.view.AutoFitRecycleView
            android:id="@+id/rv_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_10"
            android:paddingHorizontal="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/searchScopeBinding"
            app:padding="0dp"
            app:widthLarge="@dimen/dp_148"
            app:widthSmall="@dimen/dp_148"/>
        <com.onyx.galaxy.note.category.view.CommonEmptyView
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:empty_holder_src="@drawable/icon_empty_view_search"
            app:empty_title="@string/note_empty_view_search_title"
            app:layout_constraintBottom_toBottomOf="@+id/rv_search"
            app:layout_constraintEnd_toEndOf="@+id/rv_search"
            app:layout_constraintStart_toStartOf="@+id/rv_search"
            app:layout_constraintTop_toTopOf="@+id/rv_search"/>
        <com.onyx.galaxy.note.p048ui.view.TextSwitchButton
            android:id="@+id/hwr_switch_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/text_input_layout_name"
            app:layout_constraintEnd_toEndOf="@+id/text_input_layout_name"
            app:layout_constraintTop_toTopOf="@+id/text_input_layout_name"
            app:text="@string/ai_search"
            app:textMarginEnd="@dimen/dp_8"
            app:textSize="@dimen/dp_10"
            app:thumbHeight="@dimen/dp_12"
            app:thumbMarginEnd="@dimen/dp_2"
            app:thumbMarginStart="@dimen/dp_6"
            app:thumbMarginVertical="@dimen/dp_6"
            app:thumbWidth="@dimen/dp_12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_40"
            android:text="@string/cancel"
            android:lines="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_10"
            android:paddingHorizontal="@dimen/dp_4"
            android:autoSizeMaxTextSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="@+id/text_input_layout_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_input_layout_name"
            style="@style/materialPressStyleRadiusDp12"/>
        <include
            android:id="@+id/searchScopeBinding"
            layout="@layout/layout_search_scope"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/note_search_history_hint"
            app:layout_constraintStart_toStartOf="@+id/searchScopeBinding"
            app:layout_constraintTop_toBottomOf="@+id/searchScopeBinding"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/btn_clear"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_28"
            android:text="@string/note_search_clear"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/tv_history_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_history_title"
            style="@style/materialPressStyleRadiusDp12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:id="@+id/v_divider"
            android:background="@color/theme_divider_color_01"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_history_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_history_title"/>
        <ScrollView
            android:id="@+id/sv_history"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/text_input_layout_name"
            app:layout_constraintStart_toStartOf="@+id/tv_history_title"
            app:layout_constraintTop_toBottomOf="@+id/v_divider">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/dp_12"
                app:chipSpacingVertical="@dimen/dp_8"/>
        </ScrollView>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/dp_24"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="btn_cancel,guideline1"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
