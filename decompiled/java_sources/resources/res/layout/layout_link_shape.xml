<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="@drawable/shape_link_audio_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/shape_link_audio_bg_stroke">
    <ImageView
        android:id="@+id/ic_link"
        android:layout_width="@dimen/link_icon_size"
        android:layout_height="@dimen/link_icon_size"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/link_audio_margin_start"
        android:layout_marginEnd="@dimen/link_padding"/>
    <TextView
        android:textSize="@dimen/link_name_text_size"
        android:textColor="@color/link_text_color"
        android:ellipsize="middle"
        android:id="@+id/fileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/link_audio_margin_end"
        android:layout_toEndOf="@+id/ic_link"
        android:textFontWeight="@integer/font_weight_Regular"/>
</RelativeLayout>
