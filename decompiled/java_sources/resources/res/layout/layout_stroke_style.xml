<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_40"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginHorizontal="@dimen/dp_24">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/solidStyle"
        android:background="@drawable/graph_line_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:src="@drawable/graph_line_solid"
        android:scaleType="fitCenter"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/dp_16"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/dashStyle"
        android:background="@drawable/graph_line_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:src="@drawable/graph_line_dash"
        android:scaleType="fitCenter"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_6"
        android:paddingHorizontal="@dimen/dp_16"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/dotStyle"
        android:background="@drawable/graph_line_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:src="@drawable/graph_line_dot"
        android:scaleType="fitCenter"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_6"
        android:paddingHorizontal="@dimen/dp_16"
        app:imageTint="@color/theme_icon_color_01"/>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
