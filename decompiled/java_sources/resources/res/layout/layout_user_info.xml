<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_user_info_0"
    android:paddingBottom="@dimen/dp_40"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_02"
        android:gravity="center"
        android:id="@+id/personal_info_text"
        android:paddingLeft="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/user_title_personal_info"/>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:id="@+id/personal_layout"
        android:background="@drawable/shape_common_group_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_1"
        android:paddingVertical="@dimen/dp_1">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/avatar_layout"
            android:tag="binding_1"
            android:background="@drawable/ripple_white_top_corner"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_title_avatar"/>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/avatar_image"
                android:tag="binding_2"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                app:civ_border_color="@color/color_user_text_light"
                app:civ_border_overlay="false"
                app:civ_border_width="@dimen/px_1"
                app:civ_fill_color="@color/white"
                style="@style/iconButtonStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginLeft="@dimen/dp_10"
                android:src="@drawable/icon_back"
                android:rotation="180"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:paddingHorizontal="@dimen/dp_30"
            style="@style/dividerStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/nickname_layout"
            android:tag="binding_3"
            android:background="@drawable/ripple_white"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_title_nickname"/>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_icon_color_02"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="right"
                android:id="@+id/nickname_text"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/user_not_set"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginLeft="@dimen/dp_10"
                android:src="@drawable/icon_back"
                android:rotation="180"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:paddingHorizontal="@dimen/dp_30"
            style="@style/dividerStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/account_id_layout"
            android:tag="binding_5"
            android:background="@drawable/ripple_white_bottom_corner"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_title_account_id"/>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_icon_color_02"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="right"
                android:id="@+id/account_id_text"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/user_not_set"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/copy_button"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginLeft="@dimen/dp_10"
                android:src="@drawable/icon_op_copy"
                android:rotation="180"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_02"
        android:gravity="center"
        android:id="@+id/account_info_text"
        android:paddingLeft="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/user_title_account_info"/>
    <com.onyx.android.sdk.theme.widgets.TintCardView
        android:id="@+id/card_list"
        android:background="@drawable/shape_common_group_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="vertical"
            android:id="@+id/account_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_1"
            android:paddingVertical="@dimen/dp_1">
            <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/phone_layout"
                android:tag="binding_7"
                android:background="@drawable/ripple_white_top_corner"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_title_phone"/>
                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_03"
                    android:textColorHint="@color/theme_primary_color_01"
                    android:gravity="right"
                    android:id="@+id/phone_text"
                    android:tag="binding_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_phone_not_bind"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:src="@drawable/icon_back"
                    android:rotation="180"
                    app:imageTint="@color/theme_icon_color_02"/>
            </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_phone_divider"
                android:paddingHorizontal="@dimen/dp_30"
                style="@style/dividerStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/email_layout"
                android:tag="binding_9"
                android:background="@drawable/ripple_white"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_title_email"/>
                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_03"
                    android:textColorHint="@color/theme_primary_color_01"
                    android:gravity="right"
                    android:id="@+id/email_text"
                    android:tag="binding_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_email_not_bind"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:src="@drawable/icon_back"
                    android:rotation="180"
                    app:imageTint="@color/theme_icon_color_02"/>
            </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_email_divider"
                android:paddingHorizontal="@dimen/dp_30"
                style="@style/dividerStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/wechat_layout"
                android:tag="binding_11"
                android:background="@drawable/ripple_white"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_title_wechat"/>
                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/color_user_text_light"
                    android:textColorHint="@color/theme_primary_color_01"
                    android:gravity="right"
                    android:id="@+id/wechat_text"
                    android:tag="binding_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_wechat_not_bind"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:src="@drawable/icon_back"
                    android:rotation="180"
                    app:imageTint="@color/theme_icon_color_02"/>
            </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_wechat_divider"
                android:paddingHorizontal="@dimen/dp_30"
                style="@style/dividerStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/huawei_layout"
                android:tag="binding_13"
                android:background="@drawable/ripple_white_bottom_corner"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_title_huawei_account"/>
                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/dp_16"
                    android:textColor="@color/theme_text_color_03"
                    android:textColorHint="@color/theme_primary_color_01"
                    android:gravity="right"
                    android:id="@+id/huawei_text"
                    android:tag="binding_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_huawei_not_bind"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:src="@drawable/icon_back"
                    android:rotation="180"
                    app:imageTint="@color/theme_icon_color_02"/>
            </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintCardView>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:id="@+id/password_set_layout"
        android:background="@drawable/shape_common_group_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_20"
        android:paddingHorizontal="@dimen/dp_1"
        android:paddingVertical="@dimen/dp_1">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/password_layout"
            android:tag="binding_15"
            android:background="@drawable/ripple_white_corner"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_title_password_setting"/>
            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_03"
                android:textColorHint="@color/theme_primary_color_01"
                android:gravity="right"
                android:id="@+id/password_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_380"
                android:text="@string/user_tip_logout_after_password_reset"
                android:hint="@string/user_tip_logout_after_password_reset"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginLeft="@dimen/dp_10"
                android:src="@drawable/icon_back"
                android:rotation="180"
                app:imageTint="@color/theme_icon_color_02"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</LinearLayout>
