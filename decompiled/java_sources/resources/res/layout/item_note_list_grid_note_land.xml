<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root"
    android:layout_width="@dimen/note_page_gird_item_max_width"
    android:layout_height="@dimen/note_page_gird_item_height">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/cls_root"
        android:layout_width="@dimen/note_page_gird_item_max_width"
        android:layout_height="@dimen/note_page_gird_item_height">
        <View
            android:id="@+id/v_click_open"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/cl_thumbnail"
            app:layout_constraintEnd_toEndOf="@+id/cl_thumbnail"
            app:layout_constraintStart_toStartOf="@+id/cl_thumbnail"
            app:layout_constraintTop_toTopOf="@+id/cl_thumbnail"/>
        <View
            android:id="@+id/v_click_option"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_thumbnail"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_190"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/note_thumbnail_shadow_bottom_land"
                android:background="@drawable/note_list_item_shadow"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_20"
                android:translationY="@dimen/dp_8_"
                app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
                app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"
                app:layout_constraintTop_toBottomOf="@+id/iv_thumbnail"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_thumbnail"
                android:padding="0dp"
                android:layout_width="@dimen/dp_146"
                android:layout_height="@dimen/dp_118"
                android:layout_marginTop="@dimen/note_page_gird_item_thumbnail_land_margin_top"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/note_face_shape_appearance"
                app:strokeColor="@color/transparent"
                app:strokeWidth="@dimen/dp_1"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_lock_thumbnail"
                android:background="@color/note_lock_thumbnail_bg"
                android:padding="0dp"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_146"
                android:layout_height="@dimen/dp_118"
                android:layout_marginTop="@dimen/note_page_gird_item_thumbnail_land_margin_top"
                android:src="@drawable/icon_note_lock_thumbnail"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/note_face_shape_appearance"
                app:strokeColor="@color/transparent"
                app:strokeWidth="@dimen/dp_1"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_note_thumbnail_land_broder"
                android:background="@drawable/shape_note_list_item_note_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_thumbnail"
                app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
                app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"
                app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"/>
            <View
                android:id="@+id/note_thumbnail_shadow_land"
                android:background="@drawable/shape_note_list_face_left"
                android:layout_width="@dimen/dp_8"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_thumbnail"
                app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"
                app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"/>
            <com.onyx.android.sdk.theme.widgets.TintCheckBox
                android:id="@+id/cb_sel"
                android:background="@drawable/sel_note_list_checkbox"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginBottom="@dimen/dp_16"
                android:button="@null"
                app:layout_constraintBottom_toBottomOf="@+id/iv_thumbnail"
                app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
                app:layout_constraintStart_toStartOf="@+id/iv_thumbnail"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_sync"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
                app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"
                style="@style/SyncProgressIndicatorStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/iv_sync_status"
                android:visibility="gone"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                app:layout_constraintEnd_toEndOf="@+id/iv_thumbnail"
                app:layout_constraintTop_toTopOf="@+id/iv_thumbnail"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.onyx.android.sdk.p039ui.EllipsizingTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_20"
            android:maxLines="@integer/item_note_name_max_lines"
            android:includeFontPadding="true"
            android:drawablePadding="@dimen/dp_4"
            app:drawableRightCompat="@drawable/icon_note_arrow_down"
            app:drawableTint="@color/theme_icon_color_02"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_thumbnail"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/theme_text_color_03"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
        <com.onyx.galaxy.note.category.view.TagsLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_tags"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"
            app:tagHorizontalMargin="@dimen/tag_divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:layout_gravity="start"
        android:id="@+id/v_drag_top"
        android:background="@drawable/shape_item_folder_drag_bottom"
        android:visibility="gone"
        android:layout_width="@dimen/dp_2"
        android:layout_height="@dimen/dp_190"
        android:layoutDirection="ltr"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:layout_gravity="end"
        android:id="@+id/v_drag_bottom"
        android:background="@drawable/shape_item_folder_drag_bottom"
        android:visibility="gone"
        android:layout_width="@dimen/dp_2"
        android:layout_height="@dimen/dp_190"
        android:layoutDirection="ltr"/>
</FrameLayout>
