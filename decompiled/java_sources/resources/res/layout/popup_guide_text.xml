<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_guide_text_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialogRoot"
        android:background="@color/popup_guide_text_color"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="center"
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textFontWeight="@integer/font_weight_Medium"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_gravity="center"
                android:id="@+id/closeButton"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginRight="@dimen/dp_16"
                android:src="@drawable/ic_guide_close"
                android:scaleType="fitXY"
                app:imageTint="@color/theme_icon_color_02"/>
        </FrameLayout>
        <com.onyx.galaxy.note.p048ui.view.NotificationRichTextView
            android:gravity="start|center_vertical"
            android:id="@+id/contentText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_24"
            android:maxHeight="@dimen/dp_450"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:basicHeight="@dimen/dp_150"
            app:maxScreenRatioY="0.7"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/selector_login_btn_text_color"
            android:gravity="center"
            android:id="@+id/confirmButton"
            android:background="@drawable/selector_fill_blue_gray_ripple"
            android:clickable="true"
            android:layout_width="@dimen/dp_272"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/upgrade_start"
            android:fontFamily="sans-serif"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:textFontWeight="@integer/font_weight_Medium"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
