<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_account_verify_email_0"
    android:paddingTop="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintEditText
        android:gravity="center"
        android:id="@+id/emailEdit"
        android:tag="binding_1"
        android:background="@drawable/selector_edit_input"
        android:padding="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:hint="@string/email_hint"
        android:singleLine="true"
        android:digits="@string/user_phone_email_chars"
        android:inputType="textEmailAddress"
        android:imeOptions="actionNext"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/tintEditTextStyleV2"/>
    <com.onyx.android.sdk.theme.widgets.TintEditText
        android:gravity="center"
        android:id="@+id/verificationCodeEdit"
        android:tag="binding_2"
        android:background="@drawable/selector_edit_input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_16"
        android:hint="@string/verification_code_hint"
        android:singleLine="true"
        android:maxLength="@integer/max_length_verify_code"
        android:digits="@string/user_phone_chars"
        android:inputType="number"
        android:imeOptions="actionNext"
        app:layout_constraintTop_toBottomOf="@+id/emailEdit"
        style="@style/tintEditTextStyleV2"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/selector_verification_code_button"
        android:id="@+id/verifyCodeButton"
        android:tag="binding_3"
        android:padding="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/verificationCodeEdit"
        app:layout_constraintRight_toRightOf="@+id/verificationCodeEdit"
        app:layout_constraintTop_toTopOf="@+id/verificationCodeEdit"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/selector_login_btn_text_color"
        android:gravity="center"
        android:id="@+id/nextButton"
        android:tag="binding_4"
        android:background="@drawable/selector_fill_blue_gray_ripple"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/user_title_confirm_verify"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/verificationCodeEdit"/>
</androidx.constraintlayout.widget.ConstraintLayout>
