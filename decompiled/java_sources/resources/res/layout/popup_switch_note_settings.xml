<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_switch_note_settings_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/tv_common_settings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:minWidth="@dimen/dp_200"
            android:text="@string/common_settings"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/dp_12"
            app:drawableRightTint="@color/theme_primary_color_01"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/divider"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/tv_doc_local_settings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:minWidth="@dimen/dp_200"
            android:text="@string/doc_local_settings"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/dp_12"
            app:drawableRightTint="@color/theme_primary_color_01"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
