<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_folder_op_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:background="@drawable/shape_common_popup_bg"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="@dimen/dp_240"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textColor="@color/theme_text_color_01"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_folder_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_38"
            android:singleLine="true"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_1"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_folder_title"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btn_create_sub_folder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_1"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/icon_create_sub_folder"
                app:imageTint="@color/theme_icon_color_01"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_sub_folder"
                android:layout_marginStart="@dimen/sp_12"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_2"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_create_sub_folder"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btn_edt_folder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_2"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/icon_edt_folder"
                app:imageTint="@color/theme_icon_color_01"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edt_folder"
                android:layout_marginStart="@dimen/sp_12"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_3"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_edt_folder"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btn_move_folder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_3"
            style="@style/materialSelectPressStyleNoRadius">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/icon_move_folder"
                app:imageTint="@color/theme_icon_color_01"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/move_folder"
                android:layout_marginStart="@dimen/sp_12"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_4"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_move_folder"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btn_delete_folder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_4"
            style="@style/materialSelectPressStyleNoRadiusError">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/icon_delete_folder"
                app:imageTint="@color/theme_error_color_01"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/delete_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_folder"
                android:layout_marginStart="@dimen/sp_12"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_create_sub_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="btn_create_sub_folder,view_2"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
