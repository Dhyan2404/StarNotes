<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/fragment_doc_overview_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <com.onyx.galaxy.note.editor.view.SelectionActionLayout
        android:gravity="center_vertical"
        android:id="@+id/selection_action_layout"
        android:background="@drawable/bg_border_round"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16">
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/add_page_after_current_page"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/add_new_page_after_current_page_long"
            android:drawableTop="@drawable/ic_file_arrow_right"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/add_to_custom_paper"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/add_to_custom_paper"
            android:drawableTop="@drawable/ic_file_star"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/add_to_toc"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/add_to_toc"
            android:drawableTop="@drawable/ic_add_to_list"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/export"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/export"
            android:drawableTop="@drawable/ic_export"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/rotate"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/rotate"
            android:drawableTop="@drawable/ic_rotate"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/copy"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/option_select_duplicate"
            android:drawableTop="@drawable/ic_duplicate"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/clone"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/option_select_copy"
            android:drawableTop="@drawable/ic_clone"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/paste"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/paste"
            android:drawableTop="@drawable/ic_paste"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.galaxy.note.editor.view.HideTextView
            android:enabled="false"
            android:textColor="@color/selector_delete_color"
            android:gravity="center_horizontal"
            android:id="@+id/delete"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:drawableTop="@drawable/ic_delete_round"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_delete_color"
            app:iconTint="@color/selector_delete_color"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
    </com.onyx.galaxy.note.editor.view.SelectionActionLayout>
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/layout_search"
            layout="@layout/layout_doc_search"/>
        <com.onyx.galaxy.note.category.view.SwipeRecycleViewContainer
            android:id="@+id/swipe_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_search"
            app:padding="@dimen/dp_24"
            app:scrollBarEnable="true"/>
        <com.onyx.galaxy.note.category.view.CommonEmptyView
            android:id="@+id/search_empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:empty_holder_src="@drawable/icon_empty_view_search"
            app:empty_title="@string/overview_empty_view_search_title"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</LinearLayout>
