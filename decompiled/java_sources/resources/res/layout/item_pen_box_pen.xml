<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_pen_box_pen_0"
    android:layout_width="@dimen/dp_52"
    android:layout_height="@dimen/dp_44">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cl_content"
        android:background="@drawable/selector_pen_box_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <com.onyx.galaxy.note.editor.view.toolbar.PhysicalShapeIconView
            android:id="@+id/icon_view"
            android:tag="binding_1"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_74"
            app:alwaysShowFillColor="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxTrans="@dimen/dp_20"
            app:minTrans="@dimen/dp_14"
            app:showSelectArrowIndicator="false"
            app:showSelectedStroke="true"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_6"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:textFontWeight="@integer/font_weight_Medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_selected_arrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_shape_arrow_down"
            app:imageTint="@color/theme_primary_color_01"
            app:layout_constraintBottom_toBottomOf="@+id/value"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/v_selected_vertical"
            android:background="@color/theme_primary_color_01"
            android:visibility="gone"
            android:layout_width="@dimen/dp_1_5"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
