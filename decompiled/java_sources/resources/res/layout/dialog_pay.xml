<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_pay_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/theme_background_color_01"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="0dp">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/fly_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/pay_title_text_size"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qrcode_pay"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_gravity="center"
                android:id="@+id/iv_close"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginRight="@dimen/dp_16"
                android:src="@drawable/ic_pay_dialog_close"
                app:imageTint="@color/theme_icon_color_03"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lly_pay_contain"
            android:paddingBottom="@dimen/dp_24"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fly_header">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lly_wechat_pay"
                    android:background="@drawable/bg_wechat_pay_menu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintWidth_percent="0.5">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_14"
                        android:src="@drawable/ic_wechat_pay"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_text_color_01"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:text="@string/wechat_pay"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/lly_ali_pay"
                    android:background="@drawable/bg_ali_pay_menu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintWidth_percent="0.5">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_14"
                        android:src="@drawable/ic_alipay"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_text_color_01"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:text="@string/alipay"/>
                </LinearLayout>
                <View
                    android:background="@color/theme_bg_overlay_color_01"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0_5"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <View
                    android:id="@+id/view_wechat_line"
                    android:background="@color/theme_wechat_color"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_1_5"
                    app:layout_constraintBottom_toBottomOf="@+id/lly_wechat_pay"
                    app:layout_constraintLeft_toLeftOf="@+id/lly_wechat_pay"
                    app:layout_constraintRight_toRightOf="@+id/lly_wechat_pay"/>
                <View
                    android:id="@+id/view_ali_line"
                    android:background="@color/theme_alipay_color"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_1_5"
                    app:layout_constraintBottom_toBottomOf="@+id/lly_ali_pay"
                    app:layout_constraintLeft_toLeftOf="@+id/lly_ali_pay"
                    app:layout_constraintRight_toRightOf="@+id/lly_ali_pay"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_02"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_order_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:singleLine="true"
                android:layout_marginHorizontal="@dimen/dp_10"/>
            <LinearLayout
                android:gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_46">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_32"
                    android:textColor="@color/theme_text_color_01"
                    android:id="@+id/tv_actual_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_02"
                    android:id="@+id/tv_original_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_8"/>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/fly_qrcode"
                android:background="@drawable/bg_pay_qrcode"
                android:layout_width="@dimen/qrcode_container"
                android:layout_height="@dimen/qrcode_container"
                android:layout_marginTop="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_qrcode"
                    android:visibility="gone"
                    android:layout_width="@dimen/qrcode_width"
                    android:layout_height="@dimen/qrcode_height"/>
                <WebView
                    android:layout_gravity="center"
                    android:id="@+id/wv_qrcode"
                    android:visibility="gone"
                    android:layout_width="@dimen/qrcode_width"
                    android:layout_height="@dimen/qrcode_height"/>
                <com.onyx.android.sdk.theme.widgets.TintLinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/lly_qrcode_invalid"
                    android:background="@drawable/bg_qrcode_invalid"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/ic_qrcode_refresh"
                        app:imageTint="@color/theme_icon_color_01"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_text_color_01"
                        android:gravity="center"
                        android:id="@+id/tv_qrcode_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"/>
                </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
                <FrameLayout
                    android:id="@+id/fly_qrcode_loading"
                    android:background="@drawable/bg_qrcode_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/dp_1">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_qrcode_loading"
                        android:background="@drawable/animate_loading"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"/>
                </FrameLayout>
            </FrameLayout>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_pay"
                android:background="@drawable/bg_pay_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_24"
                android:minWidth="@dimen/dp_145"
                android:paddingHorizontal="@dimen/dp_24"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/theme_text_color_02"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fly_status"
            android:paddingBottom="@dimen/dp_24"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fly_header">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/lly_pay_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_pay_status"
                    android:layout_width="@dimen/dp_56"
                    android:layout_height="@dimen/dp_56"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_24"
                    android:textColor="@color/theme_text_color_01"
                    android:id="@+id/tv_pay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/pay_success"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_02"
                    android:gravity="center"
                    android:id="@+id/tv_pay_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_48"
                    android:paddingHorizontal="@dimen/dp_24"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_02"
                    android:id="@+id/tv_pay_status_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/pay_fail_tips"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_retry"
                    android:background="@drawable/bg_pay_button"
                    android:layout_width="@dimen/dp_76"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_40"
                    android:text="@string/pay_retry"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fly_loading"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_loading"
                android:layout_width="@dimen/dp_136"
                android:layout_height="@dimen/dp_136">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_loading"
                    android:background="@drawable/animate_loading"
                    android:layout_width="@dimen/dp_50"
                    android:layout_height="@dimen/dp_50"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/theme_text_btn_color"
                    android:id="@+id/tv_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/dialog_loading"/>
            </LinearLayout>
        </FrameLayout>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.onyx.android.sdk.theme.widgets.TintCardView>
