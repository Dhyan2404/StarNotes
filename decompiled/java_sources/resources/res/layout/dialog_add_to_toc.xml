<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_add_to_toc_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:tag="@string/auto_size_dialog_tag"
        android:background="@drawable/shape_common_popup_bg"
        android:paddingBottom="@dimen/dp_24"
        android:layout_width="@dimen/dp_560"
        android:layout_height="match_parent">
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:text="@string/add_toc_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/materialPressStyleBtnRadiusDp08"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_text"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/materialPressStyleBtnRadiusDp08"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/add_toc_title_desc"
            android:paddingHorizontal="@dimen/popup_horizontal_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_toc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/toc_entry_title"
            android:layout_marginStart="@dimen/popup_horizontal_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_name_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/popup_horizontal_margin"
            app:layout_constraintBottom_toBottomOf="@+id/tv_toc_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_toc_title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/title_input_layout"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:counterMaxLength="@integer/toc_entry_title_max_char_length"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_toc_title"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.theme.widgets.TintTextInputEditTextView
                android:textSize="@dimen/sp_16"
                android:id="@+id/title_edit"
                android:layout_width="match_parent"
                android:hint="@string/input_toc_entry_title"
                android:maxLines="1"
                android:maxLength="@integer/folder_name_max_length"
                android:inputType="text"
                android:textCursorDrawable="@drawable/shape_cursor_bg"
                android:layout_marginHorizontal="@dimen/popup_horizontal_margin"
                android:paddingHorizontal="@dimen/dp_16"
                style="@style/textInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_page_number_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/page_number"
            android:layout_marginStart="@dimen/popup_horizontal_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_input_layout"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/page_input_layout"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:counterMaxLength="@integer/toc_entry_title_max_char_length"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_page_number_title"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.theme.widgets.TintTextInputEditTextView
                android:textSize="@dimen/sp_16"
                android:id="@+id/page_edit"
                android:layout_width="match_parent"
                android:text="0"
                android:maxLines="1"
                android:maxLength="@integer/folder_name_max_length"
                android:inputType="number"
                android:layout_marginHorizontal="@dimen/popup_horizontal_margin"
                android:paddingHorizontal="@dimen/dp_16"
                style="@style/textInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
