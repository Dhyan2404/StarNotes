<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:background="@drawable/shape_common_popup_bg"
    android:paddingBottom="@dimen/dp_14"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.p039ui.MediumTextView
        android:gravity="center"
        android:id="@+id/titleBar"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content"
        android:text="@string/style"
        android:paddingVertical="@dimen/dp_12"
        style="@style/commonTextStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/divider"
        style="@style/dividerStyle"/>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/penGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/penStrokeStyleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:text="@string/graph_h2_stroke_style"
            android:layout_marginStart="@dimen/tool_popup_margin_start"/>
        <include
            android:id="@+id/penStrokeStyle"
            layout="@layout/layout_stroke_style"/>
        <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
            android:id="@+id/seek_bar_thickness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_68"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:progressValueSuffix="@string/unit_mm"
            app:seekBarTitle="@string/thickness"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/color_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:text="@string/color"
            android:layout_marginStart="@dimen/tool_popup_margin_start"/>
        <com.onyx.galaxy.note.editor.view.toolbar.ShapeColorPropertyLayout
            android:id="@+id/color_layout"
            android:background="@drawable/shape_rectangle_gray_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:isLarge="true"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:id="@+id/shapeFillGroup"
        android:background="@drawable/bg_popup_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tool_popup_item_margin_top"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_8">
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/enableFillColorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_8">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/fillColorSwitchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/graphic_filling"/>
            <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                android:layout_gravity="end|center_vertical"
                android:id="@+id/fillColorSwitch"
                android:textOn=""
                android:textOff=""
                app:thumbTint="@color/white"
                style="@style/commonSwitchStyle"/>
        </FrameLayout>
        <com.onyx.galaxy.note.editor.view.toolbar.ShapeFillColorPropertyLayout
            android:id="@+id/fillColorLayout"
            android:background="@drawable/shape_rectangle_gray_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_common_item_height"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_4"
            app:isLarge="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:saveColor="false"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
