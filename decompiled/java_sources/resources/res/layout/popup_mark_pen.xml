<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_mark_pen_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:background="@drawable/shape_common_popup_bg"
        android:paddingBottom="@dimen/dp_24"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_title_margin_top"
            android:text="@string/marker_pen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/commonTextStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/divider"
            android:layout_marginTop="@dimen/tool_popup_title_margin_top"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/dividerStyle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_mark_type_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_128"
            android:layout_marginStart="@dimen/dp_36"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.onyx.galaxy.note.editor.view.toolbar.PhysicalMarkPenGroup
                    android:id="@+id/right_angle_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:isRoundCorner="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.onyx.galaxy.note.editor.view.toolbar.PhysicalMarkPenGroup
                    android:id="@+id/round_corner_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:isRoundCorner="true"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:background="@drawable/icon_write_pen_group_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/ll_mark_type_container"/>
        <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
            android:id="@+id/seek_bar_thickness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_seekbar_height"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:layout_constraintTop_toBottomOf="@+id/ll_mark_type_container"
            app:progressValueSuffix="@string/unit_mm"
            app:seekBarTitle="@string/thickness"/>
        <FrameLayout
            android:id="@+id/line_drawing_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_common_item_height"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seek_bar_thickness">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/line_drawing"/>
            <com.onyx.android.sdk.theme.widgets.TintSwitchCompat
                android:layout_gravity="end|center_vertical"
                android:id="@+id/switch_line_drawing"
                android:textOn=""
                android:textOff=""
                app:thumbTint="@color/white"
                style="@style/commonSwitchStyle"/>
        </FrameLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/tv_color_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:text="@string/color"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line_drawing_container"/>
        <com.onyx.galaxy.note.editor.view.toolbar.ShapeColorArgsPropertyLayout
            android:id="@+id/color_layout"
            android:background="@drawable/shape_rectangle_gray_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_common_item_height"
            android:layout_marginTop="@dimen/dp_8"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:isLarge="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_color_title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/add_to_pen_box"
            android:background="@drawable/shape_rectangle_primary_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/tool_popup_bottom_item_margin_top"
            android:text="@string/add_to_pen_case"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:layout_constraintTop_toBottomOf="@+id/color_layout"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
