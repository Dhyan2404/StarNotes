<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_page_num_float_panel_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/pageJumpContainer"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40">
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_28"
            android:layout_marginStart="@dimen/dp_8"
            app:boxCornerRadiusBottomEnd="@dimen/dp_8"
            app:boxCornerRadiusBottomStart="@dimen/dp_8"
            app:boxCornerRadiusTopEnd="@dimen/dp_8"
            app:boxCornerRadiusTopStart="@dimen/dp_8"
            app:endIconCheckable="false"
            app:endIconDrawable="@null"
            app:endIconMode="none"
            app:startIconCheckable="false"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.theme.widgets.TintEditText
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="center"
                android:id="@+id/pageGoTo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="1"
                android:maxLines="1"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                app:enableLengthRule="true"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/"
            android:alpha="0.3"
            android:layout_marginStart="@dimen/dp_4"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/pageCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="99"
            android:alpha="0.38"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/pageJump"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jump"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
