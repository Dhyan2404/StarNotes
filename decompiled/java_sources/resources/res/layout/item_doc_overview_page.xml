<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom|center_horizontal"
    android:orientation="vertical"
    android:tag="layout/item_doc_overview_page_0"
    android:paddingTop="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_12"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:id="@+id/imageContainer"
        android:layout_width="@dimen/dp_136"
        android:layout_height="@dimen/dp_136">
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:layout_gravity="center"
            android:id="@+id/card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:borderColorRes="@color/theme_primary_color_01"
            app:borderWidth="@dimen/dp_2"
            app:shadowColor="@color/black_percent_15"
            app:shadowRadius="@dimen/dp_5"
            app:showBorder="false"
            app:showShadow="true">
            <ImageView
                android:id="@+id/image"
                android:layout_width="@dimen/note_item_grid_pad_width"
                android:layout_height="@dimen/note_item_grid_pad_height"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/bookmark"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:layout_margin="@dimen/dp_5"
                android:src="@drawable/ic_bookmark_unselect"/>
            <com.onyx.android.sdk.theme.widgets.TintCheckBox
                android:layout_gravity="center"
                android:id="@+id/checkbox"
                android:background="@null"
                android:visibility="invisible"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/selector_circle_checked_02"
                android:stateListAnimator="@null"/>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_24">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dp_32"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="end"
            android:id="@+id/more_settings"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_action_more"
            android:scaleType="centerInside"
            app:imageTint="@color/theme_icon_color_01"/>
    </FrameLayout>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
