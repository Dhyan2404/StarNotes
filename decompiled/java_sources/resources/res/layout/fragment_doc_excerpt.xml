<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content_container"
    android:tag="layout/fragment_doc_excerpt_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <com.onyx.galaxy.note.editor.view.SelectionActionLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/selection_action_layout"
        android:background="@drawable/bg_border_round"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:enabled="false"
            android:textColor="@color/selector_icon_primary_gray_color_select"
            android:gravity="center_horizontal"
            android:id="@+id/edit"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:drawableTop="@drawable/ic_edit"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_icon_primary_gray_color_select"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:enabled="false"
            android:textColor="@color/selector_delete_color"
            android:gravity="center_horizontal"
            android:id="@+id/delete"
            android:layout_width="@dimen/dp_64"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:drawableTop="@drawable/ic_delete_round"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginHorizontal="@dimen/dp_8"
            app:drawableTopTint="@color/selector_delete_color"
            app:iconTint="@color/selector_delete_color"
            style="@style/materialPressStyleRadiusDp12Sp12"/>
    </com.onyx.galaxy.note.editor.view.SelectionActionLayout>
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/layout_search"
            layout="@layout/layout_doc_search"/>
        <com.onyx.galaxy.note.category.view.CustomScrollBarRecycleView
            android:id="@+id/recyclerViewContainer"
            android:fitsSystemWindows="true"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_search"
            app:padding="@dimen/dp_24"
            app:scrollBarEnable="true"
            app:widthLarge="@dimen/doc_excerpt_item_grid_pad_width"
            app:widthSmall="@dimen/doc_excerpt_item_grid_phone_width"/>
        <com.onyx.galaxy.note.category.view.CommonEmptyView
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:empty_holder_src="@drawable/icon_empty_view_excerpt"
            app:empty_title="@string/note_empty_view_excerpt_title"/>
        <com.onyx.galaxy.note.category.view.CommonEmptyView
            android:id="@+id/search_empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:empty_holder_src="@drawable/icon_empty_view_search"
            app:empty_title="@string/excerpt_empty_view_search_title"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
