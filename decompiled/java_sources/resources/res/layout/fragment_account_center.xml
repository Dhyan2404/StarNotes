<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_account_center_0"
    android:background="@color/theme_background_color_02"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_36"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_button"
            style="@style/account_return_button"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:layout_gravity="center"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_user_info"/>
    </FrameLayout>
    <ScrollView
        android:tag="binding_1"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/user_center_webview_marigin"
        app:layout_constraintBottom_toTopOf="@+id/exit_layout"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <include
            android:id="@+id/scrollLayout"
            layout="@layout/layout_user_info"/>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/exit_layout"
        android:tag="binding_2"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_40"
        android:layout_marginVertical="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/log_off_button"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_logoff_account"
            android:paddingHorizontal="@dimen/dp_16"/>
        <include
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_12"
            layout="@layout/layout_adaptive_divider"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/log_out_button"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_log_out"
            android:paddingHorizontal="@dimen/dp_16"/>
        <include
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_12"
            layout="@layout/layout_adaptive_divider"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/disagree_protocol_button"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_user_protocol_disagree"
            android:paddingHorizontal="@dimen/dp_16"/>
    </LinearLayout>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
