<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selectMultiTagLayout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/tagIconMask"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/icon_item_tag_list_bottom"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/tagIcon"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ic_slider_tag_small"
        android:scaleType="fitCenter"
        app:imageTint="@color/theme_icon_color_01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_01"
        android:ellipsize="middle"
        android:id="@+id/tagNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp_300"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tagIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/expandCollapseButton"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        app:imageTint="@color/theme_icon_color_02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selectButton"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/selectButton"
        android:clickable="true"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/selector_circle_selected"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/dividerView"
        android:background="@color/theme_divider_color_01"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tagIcon"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
