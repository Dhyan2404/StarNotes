<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_item_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_56"
    style="@style/selectPressStyleNoRadius">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_menu"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_24"
        app:imageTint="@color/selector_primary_color_select"/>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_border"
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_16">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/selector_setting_text_color"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_setting_menu_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/newFeatureImage"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_15"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/dp_8"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
