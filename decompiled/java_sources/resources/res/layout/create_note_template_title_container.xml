<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/create_note_template_title_container_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:id="@+id/cl_title_container_bg"
        android:background="@drawable/shape_gradient_note_create_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.DynamicImageView
            android:id="@+id/create_title_dynamic_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_note_create_title_dynamic_bg"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/header_container"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/header_container"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/fl_top_container"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/ll_top_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginTop="@dimen/dp_8">
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/theme_primary_color_01"
                        android:gravity="center_vertical"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/iv_note_template_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel"
                        android:layout_marginStart="@dimen/dp_24"/>
                    <com.onyx.android.sdk.p039ui.MediumTextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/theme_text_color_01"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_note"/>
                    <com.onyx.android.sdk.p039ui.MediumTextView
                        android:textSize="@dimen/sp_16"
                        android:gravity="center"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/tv_template_create"
                        android:layout_width="@dimen/dp_80"
                        android:layout_height="@dimen/dp_38"
                        android:text="@string/dialog_create_sub_folder_create"
                        android:lines="@integer/text_view_max_lines_1"
                        android:layout_marginEnd="@dimen/dp_24"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/sp_12"
                        android:autoSizeMaxTextSize="@dimen/sp_16"
                        style="@style/materialBtnPrimaryRadius12"/>
                </FrameLayout>
                <include
                    android:id="@+id/changeTitleContainer"
                    android:visibility="gone"
                    layout="@layout/change_note_template_title_container"/>
            </FrameLayout>
            <include
                android:id="@+id/template_title_orientation_container"
                layout="@layout/layout_template_title_orientation_container"/>
        </LinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
    <include
        android:id="@+id/category_container"
        layout="@layout/layout_category_title_container"/>
</LinearLayout>
