<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_write_pen_group_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:background="@drawable/shape_common_popup_bg"
        android:paddingBottom="@dimen/tool_popup_padding_bottom"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_title_margin_top"
            android:text="@string/write_pen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/commonTextStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/divider"
            android:layout_marginTop="@dimen/tool_popup_title_margin_top"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/dividerStyle"/>
        <com.onyx.galaxy.note.editor.view.toolbar.PhysicalShapeIconContainer
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/shape_tool_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_46"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
        <FrameLayout
            android:background="@drawable/icon_write_pen_group_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/shape_tool_container"/>
        <FrameLayout
            android:id="@+id/params_container"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/shape_tool_container">
            <include
                android:id="@+id/ink_params"
                layout="@layout/include_ink_pen_popup_params"/>
            <include
                android:id="@+id/art_pen_params"
                layout="@layout/include_art_ink_pen_popup_params"/>
            <include
                android:id="@+id/soft_paint_pen_params"
                layout="@layout/include_soft_paint_pen_popup_params"/>
            <include
                android:id="@+id/ballpoint_pen_params"
                layout="@layout/include_ballpoint_pen_popup_params"/>
            <include
                android:id="@+id/pencil_params"
                layout="@layout/include_pencil_popup_params"/>
        </FrameLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/tv_color_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:text="@string/color"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/params_container"/>
        <com.onyx.galaxy.note.editor.view.toolbar.ShapeColorArgsPropertyLayout
            android:id="@+id/color_layout"
            android:background="@drawable/shape_rectangle_gray_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:isLarge="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_color_title"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/add_to_pen_box"
            android:background="@drawable/shape_rectangle_primary_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/tool_popup_bottom_item_margin_top"
            android:text="@string/add_to_pen_case"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:layout_constraintTop_toBottomOf="@+id/color_layout"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
