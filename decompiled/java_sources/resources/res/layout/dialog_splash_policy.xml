<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/fl_privacy"
    android:tag="layout/dialog_splash_policy_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintRelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_400"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintCheckBox
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="start"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:button="@null"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="@dimen/dp_24"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:layout_width="@dimen/dp_168"
            android:layout_height="@dimen/dp_48"
            android:text="@string/splash_policy_ok"
            android:layout_below="@+id/tv_dialog_title"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            android:layout_marginVertical="@dimen/dp_24"
            app:cornerRadius="@dimen/dp_12"
            style="@style/materialBtnPrimaryRadius12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/theme_ripple_btn_gray_bg_radius_12"
            android:layout_width="@dimen/dp_168"
            android:layout_height="@dimen/dp_48"
            android:text="@string/splash_policy_cancel"
            android:layout_below="@+id/tv_dialog_title"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginVertical="@dimen/dp_24"
            app:cornerRadius="@dimen/dp_12"
            style="@style/loginDialogPolicyCancelBtn"/>
    </com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
</FrameLayout>
