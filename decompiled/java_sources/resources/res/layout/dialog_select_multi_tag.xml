<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/multiTagLayout"
    android:background="@drawable/shape_common_dialog_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_24"
    android:paddingVertical="@dimen/dp_16">
    <View
        android:id="@+id/parentSizeView"
        android:tag="@string/auto_size_dialog_tag"
        android:layout_width="@dimen/dp_498"
        android:layout_height="@dimen/dp_468"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/theme_text_color_01"
        android:gravity="center"
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_select_tag"
        android:paddingVertical="@dimen/dp_4"
        android:textFontWeight="@integer/font_weight_Medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/theme_text_color_02"
        android:id="@+id/cancelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleText"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/theme_primary_color_01"
        android:id="@+id/doneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/done"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/titleText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleText"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/selectScopeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        android:text="@string/search_select_tag_search_scope"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleText"/>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/unclassifiedLayout"
        android:background="@drawable/shape_select_folder_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectScopeText">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/unclassifiedIcon"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_un_tag"
            android:layout_marginStart="@dimen/dp_16"
            app:imageTint="@color/theme_icon_color_01"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/unclassifiedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_tag"
            android:layout_marginHorizontal="@dimen/dp_8"/>
        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/selectUnclassifiedButton"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/selector_circle_selected"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_12"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/theme_text_color_03"
        android:id="@+id/currentTagTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/search_current_tags"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unclassifiedLayout"/>
    <com.onyx.android.sdk.theme.widgets.TintFrameLayout
        android:id="@+id/treeLayout"
        android:background="@drawable/shape_select_folder_bg"
        android:padding="@dimen/dp_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/selectAllButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/currentTagTitleText">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/treeListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <include
            android:id="@+id/emptyBinding"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/empty_view_select_multi_tag"/>
    </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/selectAllButton"
        android:clickable="true"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@drawable/selector_circle_selected"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/selectAllText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/treeLayout"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_03"
        android:id="@+id/selectAllText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_all"
        app:layout_constraintBottom_toBottomOf="@+id/selectAllButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/selectAllButton"
        app:layout_constraintTop_toTopOf="@+id/selectAllButton"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
