<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_view_image_0"
    android:background="@color/theme_text_color_02"
    android:padding="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minWidth="@dimen/dp_240"
        android:minHeight="@dimen/dp_240"
        android:layout_centerInParent="true"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_alignParentBottom="true">
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:background="@drawable/shape_common_popup_bg"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_5"
            app:cardCornerRadius="@dimen/dp_12">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/percent"
                    android:clickable="true"
                    android:layout_width="@dimen/dp_68"
                    android:layout_height="match_parent"
                    android:text="100%"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/scale_restore"
                    android:background="@drawable/ripple_white_corner"
                    android:padding="@dimen/dp_16"
                    android:layout_width="@dimen/dp_56"
                    android:layout_height="@dimen/dp_56"
                    android:src="@drawable/ic_scale_restore"
                    android:text="@string/restore"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:textSize="@dimen/sp_14"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/scale_down"
                    android:padding="@dimen/dp_16"
                    android:layout_width="@dimen/dp_56"
                    android:layout_height="@dimen/dp_56"
                    android:src="@drawable/ic_scale_down"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/scale_up"
                    android:padding="@dimen/dp_16"
                    android:layout_width="@dimen/dp_56"
                    android:layout_height="@dimen/dp_56"
                    android:src="@drawable/ic_scale_up"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/quit"
            android:background="@drawable/ripple_white_corner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/dp_64"
            android:minHeight="@dimen/dp_40"
            android:text="@string/quit"
            android:layout_marginStart="@dimen/dp_15"
            android:paddingVertical="@dimen/dp_4"
            app:cornerRadius="@dimen/dp_15"
            app:iconPadding="0dp"
            style="@style/materialBtnWhiteRadius12"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
