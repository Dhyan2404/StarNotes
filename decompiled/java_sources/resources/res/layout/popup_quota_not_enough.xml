<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_quota_not_enough_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialogRoot"
        android:background="@drawable/dialog_common_bg"
        android:padding="@dimen/dp_24"
        android:layout_width="@dimen/dp_400"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/contentText"
            android:layout_width="@dimen/dp_352"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_24"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="@dimen/dp_400"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center"
                android:id="@+id/closeButton"
                android:background="@drawable/md_ui_shape_stroke_gray"
                android:clickable="true"
                android:layout_width="@dimen/dp_168"
                android:layout_height="@dimen/dp_48"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_btn_color"
                android:gravity="center"
                android:id="@+id/confirmButton"
                android:background="@drawable/md_ui_shape_solid_primary"
                android:clickable="true"
                android:layout_width="@dimen/dp_168"
                android:layout_height="@dimen/dp_48"
                android:layout_marginLeft="@dimen/dp_16"/>
        </LinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
