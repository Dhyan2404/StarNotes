<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_pen_create_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_280"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginHorizontal="@dimen/dp_16">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_back"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@drawable/ic_arrow_left"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    app:imageTint="@color/theme_icon_color_01"
                    style="@style/iconButtonStyle"/>
                <com.onyx.android.sdk.p039ui.MediumTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_pen_box"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </FrameLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textColor="@color/theme_text_color_01"
                android:gravity="end"
                android:id="@+id/tv_name_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_5"/>
            <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
                android:id="@+id/cl_edit_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/til_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/theme_background_color_02"
                    app:boxCornerRadiusBottomEnd="@dimen/dp_12"
                    app:boxCornerRadiusBottomStart="@dimen/dp_12"
                    app:boxCornerRadiusTopEnd="@dimen/dp_12"
                    app:boxCornerRadiusTopStart="@dimen/dp_12"
                    app:boxStrokeColor="@color/selector_edt_stroke_outline"
                    app:boxStrokeWidth="@dimen/dp_0_5"
                    app:boxStrokeWidthFocused="@dimen/dp_0_5"
                    app:hintEnabled="false"
                    app:hintTextColor="@color/theme_text_color_03"
                    style="@style/textInputLayoutStyle">
                    <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                        android:textSize="@dimen/sp_14"
                        android:gravity="center_vertical"
                        android:id="@+id/edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        android:hint="@string/pen_box_input_hint"
                        android:maxLines="1"
                        android:maxLength="@integer/pen_box_name_max_length"
                        android:inputType="text"
                        style="@style/textInputEditTextStyle"/>
                </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
            </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:enabled="false"
                android:textColor="@color/selector_pen_box_btn_text"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/selector_pen_box_btn_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_16"
                android:minWidth="@dimen/dp_16"
                android:minHeight="@dimen/dp_16"
                android:text="@string/create"/>
        </LinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
