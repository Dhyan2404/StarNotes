<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wrapper"
    android:tag="layout/layout_selection_menu_paged_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="start"
        android:id="@+id/cl_annotation_menu"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:id="@+id/sl_annotation_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cornerRadius="@dimen/dp_12"
            app:fillColor="@color/theme_background_popup_color_01"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shadowColor="@color/black_percent_15"
            app:shadowRadius="@dimen/dp_6"
            app:showShadow="true">
            <com.onyx.android.sdk.textbox.widget.TintLinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40">
                <com.onyx.android.sdk.textbox.widget.TintImageView
                    android:id="@+id/iv_highlight"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_menu_highlight_sub"
                    android:layout_marginStart="@dimen/dp_16"/>
                <com.onyx.android.sdk.textbox.widget.TintImageView
                    android:id="@+id/ivUnderline"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_menu_underline_sub"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintStart_toEndOf="@+id/iv_highlight"/>
                <com.onyx.android.sdk.textbox.widget.TintImageView
                    android:id="@+id/iv_wavy_line"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_menu_wavy_line_sub"
                    android:layout_marginEnd="@dimen/dp_16"/>
            </com.onyx.android.sdk.textbox.widget.TintLinearLayout>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
        <com.onyx.galaxy.note.p048ui.view.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:cornerRadius="@dimen/dp_12"
            app:fillColor="@color/theme_background_popup_color_01"
            app:layout_constraintBottom_toBottomOf="@+id/sl_annotation_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sl_annotation_menu"
            app:layout_constraintTop_toTopOf="@+id/sl_annotation_menu"
            app:shadowColor="@color/black_percent_15"
            app:shadowRadius="@dimen/dp_6"
            app:showShadow="true">
            <com.onyx.android.sdk.theme.widgets.TintFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40">
                <com.onyx.android.sdk.theme.widgets.TintRecycleView
                    android:orientation="horizontal"
                    android:id="@+id/rv_annotation_color"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/dp_10"
                    android:paddingEnd="@dimen/dp_10"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
    <com.onyx.galaxy.note.p048ui.view.ShadowLayout
        android:layout_gravity="start"
        android:id="@+id/fl_sub_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cornerRadius="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_annotation_menu"
        app:shadowColor="@color/black_percent_15"
        app:shadowRadius="@dimen/dp_6"
        app:showShadow="true">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sub_menu_container"
            android:background="@drawable/ripple_white_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    <com.onyx.galaxy.note.p048ui.view.ShadowLayout
        android:layout_gravity="start"
        android:id="@+id/fl_primary_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cornerRadius="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_sub_menu"
        app:shadowColor="@color/black_percent_15"
        app:shadowRadius="@dimen/dp_6"
        app:showShadow="true">
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/menuContainer"
            android:background="@drawable/ripple_white_corner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/arrowView"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_12"
        android:src="@drawable/icon_menu_arrow_bottom"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_primary_menu"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
