<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:ellipsize="end"
            android:id="@+id/tv"
            android:paddingLeft="16dp"
            android:paddingTop="13dp"
            android:paddingRight="16dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:maxLines="1"
            android:backgroundTint="@color/btn_enable"/>
    </FrameLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
