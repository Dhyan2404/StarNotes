<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_image_cropper_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:orientation="vertical"
        android:id="@+id/rl"
        android:background="@drawable/bg_dialog_element_handle"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_text_color_02"
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_alignParentStart="true"/>
            <com.onyx.android.sdk.theme.widgets.TintCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:cardBackgroundColor="@color/theme_background_color_02"
                app:cardCornerRadius="@dimen/dp_6"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/dp_2">
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.onyx.android.sdk.theme.widgets.TintRadioButton
                        android:textSize="@dimen/dp_12"
                        android:id="@+id/rect_crop"
                        android:checked="true"
                        android:text="@string/rect_crop"
                        android:paddingHorizontal="@dimen/dp_16"
                        style="@style/popup_insert_page_radio_btn_style"/>
                    <com.onyx.android.sdk.theme.widgets.TintRadioButton
                        android:textSize="@dimen/dp_12"
                        android:id="@+id/free_crop"
                        android:text="@string/free_crop"
                        android:paddingHorizontal="@dimen/dp_16"
                        style="@style/popup_insert_page_radio_btn_style"/>
                </RadioGroup>
            </com.onyx.android.sdk.theme.widgets.TintCardView>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/theme_primary_color_01"
                android:id="@+id/finish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finish"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.onyx.android.sdk.theme.widgets.TintRelativeLayout
            android:layout_gravity="center"
            android:id="@+id/image_container"
            android:background="@color/theme_background_color_02"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_16">
            <com.canhub.cropper.CropImageView
                android:id="@+id/rect_crop_View"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:cropBorderCornerColor="@color/primary_200"
                app:cropBorderCornerOffset="@dimen/dp0_5"
                app:cropBorderCornerThickness="@dimen/dp_2"
                app:cropBorderLineColor="@color/primary_200"
                app:cropBorderLineThickness="@dimen/dp_1"
                app:cropScaleType="fitCenter"/>
            <com.onyx.galaxy.note.editor.view.FreeCropImageView
                android:id="@+id/free_crop_View"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:layout_centerInParent="true"/>
        </com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
