<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:background="@drawable/shape_common_popup_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_24"
    android:paddingVertical="@dimen/dp_16">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/strokeStyleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/graph_h2_stroke_style"/>
    <include
        android:id="@+id/lineStyle"
        android:layout_width="@dimen/dp_272"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_8"
        layout="@layout/layout_stroke_style"/>
</com.onyx.android.sdk.theme.widgets.TintLinearLayout>
