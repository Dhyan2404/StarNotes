<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_ink_font_0"
    android:background="@drawable/ripple_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48">
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/fontTitleThumbnail"
        android:layout_width="@dimen/dp_224"
        android:layout_height="@dimen/dp_32"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/dp_4"
        app:imageTint="@color/theme_text_color_01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/selectedIcon"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ic_ink_selected"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/dp_12"
        app:imageTint="@color/theme_primary_color_01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/loadingIcon"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/icon_loading"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/downloadButton"
        android:padding="@dimen/dp_13"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_42"
        android:src="@drawable/icon_download"
        app:imageTint="@color/theme_icon_color_03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/bottomDivider"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/dividerStyle"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
