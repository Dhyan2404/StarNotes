<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_logoff_by_phone_0"
    android:background="@drawable/layer_bind_phone_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_36"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/back_button"
            style="@style/account_return_button"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:layout_gravity="center"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_logoff_verify"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="left"
        android:orientation="vertical"
        android:id="@+id/verify_layout"
        android:layout_width="@dimen/dp_440"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_24"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_title_account_verify"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/theme_text_color_03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/user_tip_logoff_verify"/>
        <com.onyx.android.sdk.theme.widgets.TintTabLayoutView
            android:id="@+id/tab_layout"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_34"
            app:tabBackground="@color/transparent"
            app:tabGravity="center"
            app:tabIndicator="@drawable/shape_color_tab_indicator"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/theme_primary_color_01"
            app:tabMinWidth="@dimen/dp_72"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/primary_200"
            app:tabTextSelector="@color/selector_theme_tab_layout_color"
            app:tabUnboundedRipple="true">
            <com.google.android.material.tabs.TabItem
                android:background="@color/transparent"
                android:layout_width="@dimen/dp_72"
                android:layout_height="wrap_content"
                android:text="@string/user_title_phone"/>
        </com.onyx.android.sdk.theme.widgets.TintTabLayoutView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/shape_edit_gray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_16">
            <TextView
                android:enabled="false"
                android:textSize="@dimen/dp_16"
                android:gravity="center"
                android:id="@+id/area_code_text"
                android:tag="binding_1"
                android:layout_width="@dimen/dp_60"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_16"/>
            <View
                android:background="@drawable/shape_vertical_line"
                android:layout_width="1dp"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_8"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:enabled="false"
                android:textSize="@dimen/dp_16"
                android:gravity="center"
                android:id="@+id/phone_edit"
                android:tag="binding_2"
                android:background="@color/transparent"
                android:paddingLeft="@dimen/dp_16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:digits="@string/user_phone_chars"
                android:layout_weight="1"
                android:inputType="phone"
                app:hintTextColor="@color/edt_hint_text"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_16">
            <com.onyx.android.sdk.theme.widgets.TintEditText
                android:textColor="@color/theme_text_color_01"
                android:textColorHint="@color/theme_text_color_03"
                android:gravity="center"
                android:id="@+id/verify_code_edit"
                android:tag="binding_3"
                android:background="@drawable/selector_edit_focused_blue_gray"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLength="@integer/max_length_verify_code"
                android:inputType="number"
                android:paddingHorizontal="@dimen/dp_16"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/selector_color_enabled_blue_gray"
                android:gravity="center"
                android:id="@+id/verify_code_button"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/dp_18"
            android:textColor="@color/selector_login_btn_text_color"
            android:gravity="center"
            android:id="@+id/next_button"
            android:tag="binding_5"
            android:background="@drawable/selector_fill_blue_gray_ripple"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_48"
            android:text="@string/user_title_log_off"/>
    </LinearLayout>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
