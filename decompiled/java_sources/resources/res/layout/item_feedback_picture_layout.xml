<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_feedback_picture_layout_0"
    android:layout_width="@dimen/dp_136"
    android:layout_height="@dimen/dp_144">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_note_thumbnail"
        android:background="@color/white"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/feedback_item_picture_shape_appearance"
        app:strokeColor="@color/transparent"
        app:strokeWidth="@dimen/dp_1"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_note_thumbnail_broder"
        android:background="@drawable/shape_item_feedback_picture_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_note_thumbnail"
        app:layout_constraintEnd_toEndOf="@+id/iv_note_thumbnail"
        app:layout_constraintStart_toStartOf="@+id/iv_note_thumbnail"
        app:layout_constraintTop_toTopOf="@+id/iv_note_thumbnail"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_feedback_picture_delete"
        app:layout_constraintEnd_toEndOf="@+id/iv_note_thumbnail"
        app:layout_constraintTop_toTopOf="@+id/iv_note_thumbnail"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
