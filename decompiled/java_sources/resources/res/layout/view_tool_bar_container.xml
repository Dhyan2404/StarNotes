<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_drag_container"
    android:tag="layout/view_tool_bar_container_0"
    android:background="@color/theme_background_drag_tool"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:id="@+id/tl_drag_tool_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/ll_tool_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_0"
            android:layout_marginStart="@dimen/drag_tool_start_margin"
            android:layout_marginEnd="@dimen/drag_tool_end_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_full_screen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_undo_redo_container"
                android:layout_width="@dimen/dp_96"
                android:layout_height="@dimen/dp_40">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/undo"
                    android:tag="binding_1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_40"
                    android:src="@drawable/selector_btn_undo"
                    android:layout_weight="1"
                    app:imageTint="@color/select_color_editor_undo_redo"
                    style="@style/materialPressStyleRadiusDp12"/>
                <com.onyx.android.sdk.theme.widgets.TintView
                    android:id="@+id/undo_redo_divider"
                    android:background="@color/theme_divider_color_01"
                    android:layout_width="@dimen/dp0_5"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dp_8"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/redo"
                    android:tag="binding_2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_40"
                    android:src="@drawable/selector_btn_redo"
                    android:layout_weight="1"
                    app:imageTint="@color/select_color_editor_undo_redo"
                    style="@style/materialPressStyleRadiusDp12"/>
            </LinearLayout>
            <com.onyx.galaxy.note.editor.view.toolbar.ShapeToolViewAuto
                android:id="@+id/rl_shape_tool_view_auto"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_16"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_8"
                style="@style/dividingLineStyle"/>
            <FrameLayout
                android:id="@+id/params_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_8">
                <com.onyx.galaxy.note.editor.view.toolbar.ShapeParamsContainer
                    android:id="@+id/scroll_params_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <com.onyx.galaxy.note.editor.view.toolbar.ImageShapeParamsContainer
                    android:id="@+id/image_shape_params_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <com.onyx.galaxy.note.editor.view.toolbar.LassoTypeParamsContainer
                    android:id="@+id/lasso_type_params_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <com.onyx.galaxy.note.editor.view.toolbar.ExcerptTypeParamsContainer
                    android:id="@+id/excerpt_type_params_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <com.onyx.galaxy.note.editor.view.toolbar.EraserTypeParamsContainer
                    android:id="@+id/eraser_type_params_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <com.onyx.galaxy.note.editor.view.toolbar.StickersParamsContainer
                    android:id="@+id/sticker_params_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_full_screen"
            android:background="@drawable/bg_tool_exit_full_screen"
            android:padding="@dimen/dp_6"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_exit_full_screen"
            android:layout_marginEnd="@dimen/dp_30"
            app:imageTint="@color/select_icon_edit_title_color"
            app:layout_constraintBottom_toBottomOf="@+id/ll_tool_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_tool_container"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/tool_container_divider_top"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/tool_container_divider_bottom"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_drag_holder_icon"
            android:visibility="invisible"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:src="@drawable/ic_tool_drag_icon"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/guide_view"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guide_line"
            app:layout_constraintStart_toStartOf="@+id/guide_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guide_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.9"/>
        <View
            android:id="@+id/guide_divider"
            android:background="@drawable/ic_guide_divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.onyx.android.sdk.theme.widgets.TintFrameLayout>
