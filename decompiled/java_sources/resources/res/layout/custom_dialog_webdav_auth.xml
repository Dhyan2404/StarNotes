<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/custom_dialog_webdav_auth_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/normal_black"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/title_bar_margin_top"
        android:minHeight="@dimen/title_bar_min_height"
        android:layout_marginHorizontal="@dimen/title_bar_margin_horizontal">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:ellipsize="middle"
                android:id="@+id/title_back"
                android:background="@drawable/imagebtn_underline_bg"
                android:singleLine="true"
                android:layout_centerVertical="true"
                style="@style/title_bar_item_back_text"/>
        </RelativeLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/title_bar_margin_horizontal">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@android:color/black"
                        android:layout_width="@dimen/webdav_title_width"
                        android:layout_height="wrap_content"
                        android:text="@string/webdav_url"
                        style="@style/kcb_item_title_text_style"/>
                    <EditText
                        android:id="@+id/url_edit"
                        android:background="@drawable/bg_rounded_full_border"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/webdav_text_field_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/search_view_edit_text_margin"
                        android:paddingHorizontal="@dimen/rounded_border_inner_radius"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/webdav_text_field_item_margin_vertical">
                    <TextView
                        android:textColor="@android:color/black"
                        android:layout_width="@dimen/webdav_title_width"
                        android:layout_height="wrap_content"
                        android:text="@string/account"
                        style="@style/kcb_item_title_text_style"/>
                    <EditText
                        android:id="@+id/account"
                        android:background="@drawable/bg_rounded_full_border"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/webdav_text_field_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/search_view_edit_text_margin"
                        android:paddingHorizontal="@dimen/rounded_border_inner_radius"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@android:color/black"
                        android:layout_width="@dimen/webdav_title_width"
                        android:layout_height="wrap_content"
                        android:text="@string/password"
                        style="@style/kcb_item_title_text_style"/>
                    <EditText
                        android:id="@+id/password"
                        android:background="@drawable/bg_rounded_full_border"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/webdav_text_field_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/search_view_edit_text_margin"
                        android:paddingHorizontal="@dimen/rounded_border_inner_radius"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/webdav_button_margin_top"
                android:layout_marginHorizontal="@dimen/title_bar_margin_horizontal">
                <Button
                    android:id="@+id/button_negative"
                    android:layout_width="0dp"
                    android:text="@android:string/cancel"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/button_positive"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/deprecated_custom_alert_dialog_common_button"/>
                <Button
                    android:id="@+id/button_positive"
                    android:layout_width="0dp"
                    android:text="@android:string/ok"
                    android:layout_marginStart="@dimen/webdav_binding_page_button_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/button_negative"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/deprecated_custom_alert_dialog_positive_button"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/normal_black"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="@dimen/title_bar_margin_horizontal"
                android:layout_marginVertical="@dimen/webdav_divider_line_margin_vertical"/>
            <TextView
                android:textSize="@dimen/text_size_level_2"
                android:textColor="@color/normal_black"
                android:id="@+id/tv_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/title_bar_margin_horizontal"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
