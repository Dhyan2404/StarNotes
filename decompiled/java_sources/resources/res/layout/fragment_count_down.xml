<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_count_down_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintRelativeLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/counter_setting_popup_sub_fragment_min_height"
        android:layoutDirection="locale">
        <com.onyx.galaxy.note.editor.view.TimePickerView
            android:id="@+id/time_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_above="@+id/tv_start"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:id="@+id/tv_start"
            android:layout_width="@dimen/dp_120"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/counter_task_start"
            android:layout_above="@+id/lly_input"
            android:layout_centerHorizontal="true"
            style="@style/popup_counter_stroke_btn_style"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="vertical"
            android:id="@+id/lly_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/ll_more">
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"/>
            <com.onyx.android.sdk.theme.widgets.TintRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:paddingHorizontal="@dimen/dp_16">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_label_counter_name"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxWidth="@dimen/dp_120"
                    android:text="@string/counter_task_count_up_rename"
                    android:maxLines="@integer/text_view_max_lines_2"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="@dimen/sp_13"
                    android:autoSizeMaxTextSize="@dimen/sp_14"/>
                <com.onyx.android.sdk.theme.widgets.TintEditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:textColorHint="@color/theme_text_color_03"
                    android:gravity="end|center_vertical"
                    android:id="@+id/edt_counter_name"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="@dimen/dp_30"
                    android:hint="@string/counter_task_enter_name"
                    android:maxLines="@integer/text_view_max_lines_2"
                    android:layout_centerVertical="true"
                    android:imeOptions="actionDone"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_toEndOf="@+id/tv_label_counter_name"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="@dimen/dp_2"/>
            </com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"/>
            <com.onyx.android.sdk.theme.widgets.TintFrameLayout
                android:id="@+id/tv_my_timer_task"
                android:layout_width="match_parent"
                style="@style/popup_counter_more_btn_style">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/timer_my_timer_task"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="end|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_popup_arrow_right"
                    app:imageTint="@color/theme_icon_color_02"/>
            </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"/>
            <com.onyx.android.sdk.theme.widgets.TintRelativeLayout
                android:id="@+id/rl_timer_history_record"
                android:layout_marginBottom="@dimen/dp_8"
                android:layout_alignParentBottom="true"
                style="@style/popup_counter_more_btn_style">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_01"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_timer_history_record"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/count_down_history_record"
                    android:layout_centerVertical="true"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:id="@+id/iv_new_record_indicator"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_4"
                    android:layout_height="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_12"
                    android:src="@drawable/shape_new_circle_indicator"
                    android:layout_marginStart="@dimen/dp_2"
                    android:layout_toEndOf="@+id/tv_timer_history_record"/>
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_popup_arrow_right"
                    android:scaleType="centerInside"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:imageTint="@color/theme_icon_color_02"/>
            </com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
</FrameLayout>
