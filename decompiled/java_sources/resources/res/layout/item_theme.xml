<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_theme_0"
    android:paddingTop="@dimen/dp_16"
    android:layout_width="@dimen/dp_248"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/theme_container"
        android:layout_width="@dimen/dp_248"
        android:layout_height="@dimen/dp_168">
        <ImageView
            android:id="@+id/iv_theme_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_vip_style"
            android:background="@drawable/shape_theme_vip_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pro_exclusive"
            android:paddingHorizontal="@dimen/dp_10"
            android:paddingVertical="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="@+id/iv_theme_thumbnail"
            app:layout_constraintTop_toTopOf="@+id/iv_theme_thumbnail"/>
        <com.onyx.android.sdk.theme.widgets.TintCheckBox
            android:id="@+id/cb_sel"
            android:background="@drawable/selector_circle_selected"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            android:button="@null"
            app:layout_constraintBottom_toBottomOf="@+id/iv_theme_thumbnail"
            app:layout_constraintEnd_toEndOf="@+id/iv_theme_thumbnail"
            app:layout_constraintStart_toStartOf="@+id/iv_theme_thumbnail"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/iv_item_theme_stroke"
            android:background="@drawable/selector_theme_item_stroke"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="@+id/iv_theme_thumbnail"
            app:layout_constraintEnd_toEndOf="@+id/iv_theme_thumbnail"
            app:layout_constraintStart_toStartOf="@+id/iv_theme_thumbnail"
            app:layout_constraintTop_toTopOf="@+id/iv_theme_thumbnail"/>
        <ImageView
            android:id="@+id/iv_payment"
            android:visibility="gone"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/ic_theme_payment"
            app:layout_constraintEnd_toEndOf="@+id/iv_theme_thumbnail"
            app:layout_constraintTop_toTopOf="@+id/iv_theme_thumbnail"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/selector_theme_note_list_left_item_color"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="@+id/theme_container"
        app:layout_constraintStart_toStartOf="@+id/theme_container"
        app:layout_constraintTop_toBottomOf="@+id/theme_container"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
