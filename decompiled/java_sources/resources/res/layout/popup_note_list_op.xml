<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_note_list_op_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_240"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_8">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/btn_edit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/popup_note_list_edit"
            android:drawableLeft="@drawable/icon_edt_folder"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/theme_text_color_01"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_2"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_edit"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/btn_copy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/popup_note_list_copy"
            android:drawableLeft="@drawable/icon_op_copy"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/theme_text_color_01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_2"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_3"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_copy"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_change_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_3">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center_vertical"
                android:id="@+id/btn_change_template"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="@string/popup_note_list_change_template"
                android:drawableLeft="@drawable/icon_change_template"
                android:drawablePadding="@dimen/dp_12"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                app:drawableLeftTint="@color/theme_text_color_01"
                style="@style/materialSelectPressStyleNoRadius"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_change_template">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center_vertical"
                android:id="@+id/btn_export"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="@string/popup_note_list_export_and_share"
                android:drawableLeft="@drawable/icon_op_export"
                android:drawablePadding="@dimen/dp_12"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                app:drawableLeftTint="@color/theme_text_color_01"
                style="@style/materialSelectPressStyleNoRadius"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_add_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_export">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center_vertical"
                android:id="@+id/btn_add_tags"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="@string/popup_note_list_edit_note_tags"
                android:drawableLeft="@drawable/ic_tag"
                android:drawablePadding="@dimen/dp_12"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                app:drawableLeftTint="@color/theme_text_color_01"
                style="@style/materialSelectPressStyleNoRadius"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center_vertical"
            android:id="@+id/btn_move"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/popup_note_list_move_to"
            android:drawableLeft="@drawable/icon_op_move"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:drawableLeftTint="@color/theme_text_color_01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_add_tags"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:id="@+id/view_5"
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_move"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_5">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center_vertical"
                android:id="@+id/btn_lock"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:drawableLeft="@drawable/icon_note_list_lock"
                android:drawablePadding="@dimen/dp_12"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                app:drawableLeftTint="@color/theme_text_color_01"
                style="@style/materialSelectPressStyleNoRadius"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:background="@color/theme_divider_color_01"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_error_color_01"
            android:gravity="center_vertical"
            android:id="@+id/btn_move_trash"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:text="@string/popup_note_list_move_trash"
            android:drawableLeft="@drawable/icon_move_to_trash"
            android:drawablePadding="@dimen/dp_12"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:drawableTint="@color/theme_error_color_01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_lock"
            style="@style/materialSelectPressStyleNoRadiusError"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
