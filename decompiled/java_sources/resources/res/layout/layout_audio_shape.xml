<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_audio_shape"
    android:layout_width="@dimen/audio_shape_width"
    android:layout_height="@dimen/audio_shape_height"
    android:paddingHorizontal="@dimen/audio_inner_padding_horizontal"
    android:paddingVertical="@dimen/audio_inner_padding_vertical">
    <ImageView
        android:id="@+id/ic_audio"
        android:layout_width="@dimen/audio_icon_size"
        android:layout_height="@dimen/audio_icon_size"
        android:src="@drawable/ic_audio_speech"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/audio_text_margin_horizontal"/>
    <TextView
        android:textSize="@dimen/audio_name_text_size"
        android:textColor="@android:color/black"
        android:ellipsize="middle"
        android:id="@+id/audioName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/ic_audio"/>
    <TextView
        android:textSize="@dimen/audio_duration_text_size"
        android:textColor="@android:color/black"
        android:id="@+id/audioDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/audioName"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/ic_audio"/>
    <View
        android:id="@+id/line"
        android:background="@android:color/black"
        android:layout_width="1dp"
        android:layout_height="@dimen/audio_duration_text_size"
        android:layout_alignTop="@+id/audioDuration"
        android:layout_alignBottom="@+id/audioDuration"
        android:layout_marginStart="@dimen/audio_text_margin_horizontal"
        android:layout_marginEnd="@dimen/audio_text_margin_horizontal"
        android:layout_toEndOf="@+id/audioDuration"/>
    <TextView
        android:textSize="@dimen/audio_duration_text_size"
        android:textColor="@android:color/black"
        android:id="@+id/audioSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/audioDuration"
        android:layout_toEndOf="@+id/line"/>
</RelativeLayout>
