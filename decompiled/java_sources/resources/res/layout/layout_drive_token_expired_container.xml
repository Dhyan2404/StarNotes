<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/theme_background_warn"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_36">
    <ImageView
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/icon_edit_drive_token_expired_warn"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_drive_token_expire_warn"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/warning_200"
        android:gravity="center_vertical"
        android:id="@+id/tv_drive_token_expire_warn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/user_edit_drive_token_expired_tip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/warning_200"
        android:gravity="center"
        android:id="@+id/tv_drive_token_expire_bind"
        android:background="@drawable/bg_edit_drive_token_expired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_edit_drive_token_expired_bind_now"
        android:layout_marginStart="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_drive_token_expire_warn"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/icon_edit_drive_token_expired_close"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/dp_16"
        app:imageTint="@color/theme_icon_color_03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
