<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_backup_process_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_loading_bg"
        android:layout_width="@dimen/dp_360"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_132">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/overlay_05"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_backup_local"
            app:layout_constraintBottom_toBottomOf="@+id/iv_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_close"/>
        <ImageView
            android:id="@+id/iv_close"
            android:background="@drawable/ic_backup_dialog_close"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_center_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32">
                <ProgressBar
                    android:orientation="horizontal"
                    android:id="@+id/progress_import_backup"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_8"
                    android:progress="20"
                    android:thumb="@null"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title"
                    style="@style/commonProgressStyle"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12">
                    <TextView
                        android:textColor="@color/overlay_05"
                        android:ellipsize="middle"
                        android:id="@+id/tv_backup_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_192"
                        android:lines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/overlay_05"
                        android:id="@+id/tv_current_progress_name"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:layout_marginStart="@dimen/dp_2"
                        android:layout_marginEnd="@dimen/dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_current_progress"
                        app:layout_constraintStart_toEndOf="@+id/tv_backup_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/overlay_05"
                        android:layout_gravity="end"
                        android:id="@+id/tv_current_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_result_complete_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/overlay_05"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_complete"
                        android:drawableLeft="@drawable/ic_progress_complete"
                        android:drawablePadding="@dimen/dp_4"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/overlay_05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/backup_import_success_tips"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_result_error_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/overlay_05"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_failed"
                        android:drawableLeft="@drawable/ic_progress_error"
                        android:drawablePadding="@dimen/dp_4"/>
                    <TextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/overlay_05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/backup_import_failed_tips"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_error_detail_info_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/fl_center_container">
            <View
                android:background="@color/overlay_08"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp0_5"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rl_import_error_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_24"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
