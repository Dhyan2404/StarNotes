<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_ruler_units_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.galaxy.note.p048ui.view.ShadowLayout
        android:layout_gravity="start"
        android:id="@+id/shadowLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cornerRadius="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/black_percent_15"
        app:shadowRadius="@dimen/dp_6"
        app:showShadow="true">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_16"/>
        </FrameLayout>
    </com.onyx.galaxy.note.p048ui.view.ShadowLayout>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/bottomArrowView"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_12"
        android:src="@drawable/icon_menu_arrow"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shadowLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
