<?xml version="1.0" encoding="utf-8"?>
<com.aitsuki.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_80"
    app:autoClose="true"
    app:preview="none">
    <FrameLayout
        android:layout_gravity="end"
        android:layout_width="@dimen/dp_72"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/tv_remove"
            android:background="@drawable/bg_red_round"
            android:layout_width="@dimen/dp_64"
            android:layout_height="match_parent"
            android:text="@string/manager_folder_remove"/>
    </FrameLayout>
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:id="@+id/cl_account"
        android:background="@drawable/bg_gray_round"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_avatar"
            android:layout_marginStart="@dimen/dp_16"
            app:civ_border_color="@color/overlay_04"
            app:civ_border_overlay="false"
            app:civ_border_width="@dimen/px_1"
            app:civ_fill_color="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/iconButtonStyle"/>
        <ImageView
            android:id="@+id/iv_login_type"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/iv_user_avatar"
            app:layout_constraintEnd_toEndOf="@+id/iv_user_avatar"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/tv_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_last_login_at"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_last_login_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/iv_user_avatar"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_account"/>
        <ImageView
            android:id="@+id/iv_user_role"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_pro_role"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_account"
            app:layout_constraintStart_toEndOf="@+id/tv_account"
            app:layout_constraintTop_toTopOf="@+id/tv_account"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/to_login"
            android:layout_marginEnd="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/background_50"
            android:gravity="center"
            android:id="@+id/tv_last_login"
            android:background="@drawable/ic_recent_login"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_18"
            android:text="@string/last_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</com.aitsuki.swipe.SwipeLayout>
