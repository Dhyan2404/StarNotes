<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_category_container"
    android:tag="layout/layout_category_title_container_0"
    android:background="@color/theme_background_color_01"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_args_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/tv_category_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cover_template"
            android:layout_marginStart="@dimen/dp_24"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_color_args"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_24">
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/color_divider"
                android:background="@color/theme_divider_color_01"
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_20"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/cl_color_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_space_args"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_24">
            <com.onyx.android.sdk.theme.widgets.TintView
                android:textSize="@dimen/sp_14"
                android:background="@color/theme_divider_color_01"
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_24"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_80"
                android:text="@string/line_space"
                android:maxLines="@integer/text_view_max_lines_2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/sp_14"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center"
                android:id="@+id/tv_line_space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_60"
                android:minWidth="@dimen/dp_50"
                android:maxLines="@integer/text_view_max_lines_2"
                android:drawableRight="@drawable/ic_arrow_down"
                android:layout_marginStart="@dimen/dp_12"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/sp_14"
                app:drawableRightTint="@color/theme_icon_color_02"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_20">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_custom_selected_container"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dp_20">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:enabled="false"
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/selector_color_red_gray"
                    android:gravity="center"
                    android:id="@+id/tv_delete"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_40"
                    android:text="@string/delete"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:enabled="false"
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/selector_primary_gray_color_select"
                    android:gravity="center"
                    android:id="@+id/tv_rename"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rename"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center"
                    android:id="@+id/tv_done"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_40"
                    android:text="@string/done"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_primary_color_01"
                    android:gravity="center"
                    android:id="@+id/tv_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_40"
                    android:text="@string/select"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/rl_change_orientation_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/theme_text_color_02"
                    android:gravity="center"
                    android:id="@+id/tv_change_template_size_orientation"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxWidth="@dimen/dp_80"
                    android:maxLines="@integer/text_view_max_lines_2"
                    android:drawableRight="@drawable/ic_arrow_down"
                    android:layout_marginEnd="@dimen/dp_20"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="@dimen/sp_12"
                    android:autoSizeMaxTextSize="@dimen/sp_14"
                    app:drawableRightTint="@color/theme_icon_color_02"/>
                <com.onyx.android.sdk.theme.widgets.TintView
                    android:layout_gravity="end"
                    android:background="@color/theme_divider_color_01"
                    android:layout_width="@dimen/dp0_5"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dp_8"/>
            </FrameLayout>
            <com.onyx.android.sdk.theme.widgets.TintCheckBox
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/apply_all"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:button="@drawable/selector_circle_selected"
                android:maxWidth="@dimen/dp_150"
                android:checkedButton="@null"
                android:text="@string/apply_all_paper"
                android:maxLines="@integer/text_view_max_lines_2"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_20"
                android:paddingHorizontal="@dimen/dp_8"/>
        </LinearLayout>
        <com.onyx.android.sdk.p039ui.EllipsizingTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/tv_goto_material_center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/goto_material_center"
            android:drawablePadding="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_24"
            app:drawableStartCompat="@drawable/ic_material"
            app:drawableTint="@color/theme_primary_color_01"/>
    </LinearLayout>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/divider_category"
        android:background="@color/theme_divider_color_01"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp0_5"
        app:layout_constraintTop_toBottomOf="@+id/ll_args_container"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rl_category_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        app:layout_constraintTop_toBottomOf="@+id/divider_category"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
