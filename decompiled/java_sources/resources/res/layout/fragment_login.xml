<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:tag="layout/fragment_login_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:background="@color/theme_bg_primary_color_01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
            android:id="@+id/login_content_container"
            android:background="@color/theme_background_color_01"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_8"
                android:src="@drawable/icon_back"
                android:layout_marginStart="@dimen/dp_8"
                app:imageTint="@color/theme_icon_color_01"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/materialPressStyleRadiusDp08"/>
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_54"
                android:src="@drawable/ic_logo"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toTopOf="@+id/btn_back"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_24"
                android:textStyle="bold"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_login_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_28"
                app:layout_constraintEnd_toEndOf="@+id/btn_login"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/imageView"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_02"
                android:id="@+id/tv_login_type_hint"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title_hint"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/view2"/>
            <View
                android:id="@+id/view2"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_8"
                app:layout_constraintEnd_toEndOf="@+id/btn_login"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/tv_login_type"/>
            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_28"
                app:layout_constraintEnd_toEndOf="@+id/btn_login"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/tv_login_type_hint"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_edt_bg"
                android:background="@drawable/sel_edt_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_50"
                app:layout_constraintEnd_toEndOf="@+id/btn_login"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/view"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/tv_area_code_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_area_code_mark"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/v_edt_bg"
                app:layout_constraintStart_toStartOf="@+id/v_edt_bg"
                app:layout_constraintTop_toTopOf="@+id/v_edt_bg"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/theme_text_color_01"
                android:gravity="start|center_vertical"
                android:id="@+id/edt_area_code"
                android:tag="binding_3"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_50"
                android:maxEms="4"
                android:maxLength="5"
                app:layout_constraintBottom_toBottomOf="@+id/tv_area_code_mark"
                app:layout_constraintStart_toEndOf="@+id/tv_area_code_mark"
                app:layout_constraintTop_toTopOf="@+id/tv_area_code_mark"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/iv_area_code_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_area_code_arrow"
                app:imageTint="@color/theme_icon_color_02"
                app:layout_constraintBottom_toBottomOf="@+id/edt_area_code"
                app:layout_constraintStart_toEndOf="@+id/edt_area_code"
                app:layout_constraintTop_toTopOf="@+id/edt_area_code"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/v_divider"
                android:background="@drawable/shape_vertical_line"
                android:layout_width="1dp"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="@+id/v_edt_bg"
                app:layout_constraintStart_toEndOf="@+id/iv_area_code_arrow"
                app:layout_constraintTop_toTopOf="@+id/v_edt_bg"/>
            <com.onyx.android.sdk.theme.widgets.TintEditText
                android:textSize="@dimen/sp_16"
                android:gravity="start|center_vertical"
                android:id="@+id/edt_phone_or_email"
                android:tag="binding_4"
                android:background="@android:color/transparent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:imeOptions="actionNext"
                android:textCursorDrawable="@drawable/shape_cursor_bg"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_50"
                app:layout_constraintBottom_toBottomOf="@+id/v_edt_bg"
                app:layout_constraintEnd_toEndOf="@+id/v_edt_bg"
                app:layout_constraintStart_toEndOf="@+id/v_divider"
                app:layout_constraintTop_toTopOf="@+id/v_edt_bg"
                style="@style/tintEditTextStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:tag="binding_5"
                android:padding="@dimen/dp_12"
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:src="@drawable/icon_login_clear"
                app:layout_constraintBottom_toBottomOf="@+id/v_edt_bg"
                app:layout_constraintEnd_toEndOf="@+id/v_edt_bg"
                app:layout_constraintTop_toTopOf="@+id/v_edt_bg"
                style="@style/materialPressStyleRadiusDp08"/>
            <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
                android:layout_gravity="center_horizontal"
                android:id="@+id/til_pwd_or_verification"
                android:tag="binding_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:boxCornerRadiusBottomEnd="@dimen/dp_12"
                app:boxCornerRadiusBottomStart="@dimen/dp_12"
                app:boxCornerRadiusTopEnd="@dimen/dp_12"
                app:boxCornerRadiusTopStart="@dimen/dp_12"
                app:boxStrokeColor="@color/selector_edt_stroke_outline"
                app:boxStrokeWidth="@dimen/dp_1"
                app:boxStrokeWidthFocused="@dimen/dp_1"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="@+id/btn_login"
                app:layout_constraintStart_toStartOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/v_edt_bg"
                style="@style/TextInputLayoutStyle">
                <com.onyx.android.sdk.theme.widgets.TintEditText
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/theme_text_color_01"
                    android:textColorHint="@color/theme_text_color_03"
                    android:id="@+id/tie_pwd_or_verification"
                    android:tag="binding_7"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:hint="@string/verification_code_hint"
                    android:maxLines="1"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:layoutDirection="ltr"
                    android:paddingStart="@dimen/dp_16"/>
            </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/selector_primary_gray_color_select"
                android:gravity="center"
                android:id="@+id/btn_verification_code"
                android:tag="binding_8"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_50"
                android:maxWidth="@dimen/dp_160"
                android:text="@string/get_verification_code"
                android:maxLines="@integer/text_view_max_lines_1"
                android:layoutDirection="ltr"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/sp_12"
                android:autoSizeMaxTextSize="@dimen/sp_16"
                app:layout_constraintBottom_toBottomOf="@+id/til_pwd_or_verification"
                app:layout_constraintEnd_toEndOf="@+id/til_pwd_or_verification"
                app:layout_constraintTop_toTopOf="@+id/til_pwd_or_verification"
                style="@style/materialPressStyleBtnRadiusDp08"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:id="@+id/btn_toggle_pwd_visible"
                android:tag="binding_9"
                android:padding="@dimen/dp_12"
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:src="@drawable/selector_edt_pwd"
                android:layoutDirection="ltr"
                app:imageTint="@color/theme_icon_color_02"
                app:layout_constraintBottom_toBottomOf="@+id/til_pwd_or_verification"
                app:layout_constraintEnd_toEndOf="@+id/til_pwd_or_verification"
                app:layout_constraintTop_toTopOf="@+id/til_pwd_or_verification"
                style="?attr/materialIconButtonStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintCheckBox
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_01"
                android:id="@+id/cb_policy"
                android:tag="binding_10"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/sel_checkbox"
                android:text="@string/login_policy"
                android:paddingHorizontal="@dimen/dp_6"
                android:paddingVertical="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/til_pwd_or_verification"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/selector_login_btn_text_color"
                android:gravity="center"
                android:id="@+id/btn_login"
                android:tag="binding_11"
                android:layout_width="@dimen/dp_440"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/login"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                app:cornerRadius="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cb_policy"
                style="@style/materialBtnEnablePrimaryRadius12"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_primary_color_01"
                android:id="@+id/btn_forget_password"
                android:tag="binding_12"
                android:padding="@dimen/dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_forget_password"
                app:layout_constraintEnd_toEndOf="@+id/btn_login"
                app:layout_constraintTop_toBottomOf="@+id/btn_login"
                style="@style/materialPressStyleRadiusDp08"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/view3"
                android:layout_width="@dimen/dp_160"
                android:layout_marginEnd="@dimen/dp_24"
                app:layout_constraintBottom_toBottomOf="@+id/textView"
                app:layout_constraintEnd_toStartOf="@+id/textView"
                app:layout_constraintTop_toTopOf="@+id/textView"
                style="@style/loginDividerLineStyle"/>
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/theme_text_color_03"
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_24"
                android:text="@string/login_more_ways"
                app:layout_constraintBottom_toTopOf="@+id/ll_logins"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.onyx.android.sdk.theme.widgets.TintView
                android:id="@+id/view4"
                android:layout_width="@dimen/dp_160"
                android:layout_marginStart="@dimen/dp_24"
                app:layout_constraintBottom_toBottomOf="@+id/textView"
                app:layout_constraintStart_toEndOf="@+id/textView"
                app:layout_constraintTop_toTopOf="@+id/textView"
                style="@style/loginDividerLineStyle"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/ll_logins"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_40"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/view4"
                app:layout_constraintStart_toStartOf="@+id/view3">
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/tv_login_google"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_google"
                    android:drawableTop="@drawable/icon_login_google"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_login_microsoft"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/loginWaysTextStyle"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/tv_login_microsoft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_microsoft"
                    android:drawableTop="@drawable/icon_login_microsoft"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_login_huawei"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_login_google"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/loginWaysTextStyle"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/iv_login_phone"
                    android:tag="binding_13"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_phone"
                    android:drawableTop="@drawable/icon_login_phone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_login_email"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_login_huawei"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/loginWaysTextStyle"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/iv_login_email"
                    android:tag="binding_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_email"
                    android:drawableTop="@drawable/icon_login_email"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_login_wechat"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/iv_login_phone"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/loginWaysTextStyle"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/tv_login_wechat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_wechat"
                    android:drawableTop="@drawable/icon_login_wechat"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_login_account"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/iv_login_email"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/loginWaysTextStyle"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/tv_login_huawei"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_huawei"
                    android:drawableTop="@drawable/icon_login_huawei"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_login_phone"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_login_microsoft"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0"
                    style="@style/loginWaysTextStyle"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:id="@+id/tv_login_account"
                    android:tag="binding_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_ways_account"
                    android:drawableTop="@drawable/icon_login_account"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_login_wechat"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/loginWaysTextStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
