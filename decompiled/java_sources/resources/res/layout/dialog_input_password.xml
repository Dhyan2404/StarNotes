<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_input_password_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/shape_common_dialog_bg"
        android:paddingBottom="@dimen/dp_24"
        android:layout_width="@dimen/dp_400"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_cancel"
            android:padding="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:text="@string/decrypt_current_file"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_confirm"
            android:padding="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:ellipsize="middle"
            android:id="@+id/tv_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.onyx.android.sdk.theme.widgets.TintEditText
            android:enabled="true"
            android:textSize="@dimen/dp_16"
            android:textColor="@color/theme_text_color_01"
            android:textColorHint="@color/theme_text_color_03"
            android:gravity="center"
            android:id="@+id/edt_file_password"
            android:background="@drawable/selector_edit_text_bind_phone"
            android:paddingLeft="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_12"
            android:hint="@string/input_file_password_hint"
            android:singleLine="true"
            android:maxLength="@integer/pdf_file_password_max_length"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/shape_cursor_bg"
            android:paddingEnd="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_file_name"
            style="@style/tintEditTextStyle"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/iv_file_password_toggle"
            android:padding="@dimen/dp_5"
            android:layout_width="@dimen/dp_38"
            android:layout_height="@dimen/dp_38"
            android:layout_marginRight="@dimen/dp_10"
            android:src="@drawable/icon_invisible"
            app:imageTint="@color/theme_play_icon_color"
            app:layout_constraintBottom_toBottomOf="@+id/edt_file_password"
            app:layout_constraintRight_toRightOf="@+id/edt_file_password"
            app:layout_constraintTop_toTopOf="@+id/edt_file_password"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_error_color_01"
            android:id="@+id/tv_error_tip"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/password_incorrect_tip"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_file_password"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
