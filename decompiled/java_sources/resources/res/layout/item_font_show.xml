<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_font_show_0"
    android:background="@drawable/ripple_item_select_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48"
    android:minWidth="@dimen/dp_200"
    android:layoutDirection="ltr">
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/theme_text_color_01"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="0dp"
        android:layout_toStartOf="@+id/func_btn_container"
        android:layout_alignParentStart="true"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/previewImage"
        android:layout_width="@dimen/dp_214"
        android:layout_height="@dimen/dp_48"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/dp_2"
        android:layout_alignParentStart="true"
        app:imageTint="@color/theme_icon_color_01"/>
    <com.onyx.android.sdk.theme.widgets.TintView
        android:id="@+id/v_line"
        android:background="@color/theme_divider_color_01"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginHorizontal="@dimen/dp_5"/>
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/func_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/selectButton"
            android:padding="@dimen/dp_16"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/ic_selected"
            app:imageTint="@color/theme_primary_color_01"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/deleteButton"
            android:padding="@dimen/dp_16"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_op_delete"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/downloadingButton"
            android:padding="@dimen/dp_16"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_loading"
            app:imageTint="@color/theme_icon_color_03"/>
        <com.onyx.android.sdk.theme.widgets.TintImageView
            android:id="@+id/downloadButton"
            android:padding="@dimen/dp_16"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_download"
            app:imageTint="@color/theme_icon_color_03"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.android.sdk.theme.widgets.TintRelativeLayout>
