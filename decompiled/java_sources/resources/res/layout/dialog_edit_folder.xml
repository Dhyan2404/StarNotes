<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_edit_folder_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:tag="@string/auto_size_dialog_tag"
        android:background="@drawable/shape_common_popup_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/dp_86"
            android:layout_height="@dimen/dp_46"
            android:text="@string/cancel"
            app:layout_constraintBottom_toBottomOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView4"
            style="@style/materialPressStyleRadiusDp12"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:text="@string/dialog_edit_folder_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_primary_color_01"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:layout_width="@dimen/dp_86"
            android:layout_height="@dimen/dp_46"
            android:text="@string/done"
            app:layout_constraintBottom_toBottomOf="@+id/textView4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView4"
            style="@style/materialPressStyleRadiusDp12"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_bottom"
            android:padding="0dp"
            android:layout_width="@dimen/dp_106"
            android:layout_height="@dimen/dp_132"
            android:layout_marginTop="@dimen/dp_16"
            android:src="@drawable/icon_folder_face_bottom"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_fourth_top"
            android:padding="0dp"
            android:layout_width="@dimen/dp_106"
            android:layout_height="@dimen/dp_132"
            android:layout_marginTop="@dimen/dp_16"
            android:src="@drawable/icon_folder_face_fourth_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_thr_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_folder_face_thr_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_face_sec_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_folder_face_sec_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@mipmap/ic_folder_face_top_shadow"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@drawable/shape_note_list_item_folder_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_folder_face_top"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_face_bottom"
            app:layout_constraintEnd_toEndOf="@+id/iv_face_bottom"
            app:layout_constraintStart_toStartOf="@+id/iv_face_bottom"
            app:layout_constraintTop_toTopOf="@+id/iv_face_bottom"
            app:shapeAppearance="@style/folder_face_shape_appearance"
            app:strokeColor="@color/transparent"
            app:strokeWidth="@dimen/dp_1"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_face_bottom"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/tv_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintBottom_toTopOf="@+id/til_name"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView
            android:layout_gravity="center_horizontal"
            android:id="@+id/til_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_38"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:endIconTint="@null"
            app:hintEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv"
            app:layout_constraintVertical_bias="0"
            style="@style/textInputLayoutStyle">
            <com.onyx.android.sdk.p039ui.MaxLengthInputTextEdit
                android:textSize="@dimen/sp_16"
                android:gravity="start|center_vertical"
                android:id="@+id/tie_name"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:hint="@string/dialog_create_folder_hint"
                android:maxLines="1"
                android:maxLength="@integer/folder_name_max_input_length"
                android:inputType="text"
                app:enableLengthRule="true"
                style="@style/textInputEditTextStyle"/>
        </com.onyx.android.sdk.theme.widgets.TintTextInputLayoutView>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
