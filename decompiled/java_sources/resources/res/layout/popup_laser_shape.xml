<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/popup_laser_shape_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_common_popup_bg"
        android:paddingBottom="@dimen/tool_popup_padding_bottom"
        android:layout_width="@dimen/dp_320"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/dp_212">
        <com.onyx.android.sdk.p039ui.MediumTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_title_margin_top"
            android:text="@string/laser_pen"/>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:layout_marginTop="@dimen/tool_popup_title_margin_top"
            style="@style/dividerStyle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="center"
                    android:id="@+id/line_type"
                    android:tag="binding_1"
                    android:background="@drawable/rectangle_bg_selector"
                    android:padding="@dimen/dp_5"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/ic_laser_line_type"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/line_type"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.onyx.android.sdk.theme.widgets.TintImageView
                    android:layout_gravity="center"
                    android:id="@+id/dot_type"
                    android:tag="binding_2"
                    android:background="@drawable/rectangle_bg_selector"
                    android:padding="@dimen/dp_5"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/ic_laser_dot_type"/>
                <com.onyx.android.sdk.theme.widgets.TintTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/theme_text_color_01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="@string/dot_type"/>
            </LinearLayout>
        </LinearLayout>
        <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
            android:id="@+id/seek_bar_thickness"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_seekbar_height"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:layout_constraintTop_toBottomOf="@+id/ll_mark_type_container"
            app:progressValueSuffix="@string/unit_mm"
            app:seekBarTitle="@string/thickness"/>
        <com.onyx.galaxy.note.editor.view.custom.StickSeekBarContainer
            android:id="@+id/seek_bar_duration"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_seekbar_height"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:isStick="true"
            app:progressValueSuffix="@string/counter_label_second"
            app:seekBarTitle="@string/duration"
            app:segmentCount="2"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:layout_gravity="start"
            android:id="@+id/tv_color_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tool_popup_item_margin_top"
            android:text="@string/color"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seek_bar_thickness"/>
        <com.onyx.galaxy.note.editor.view.toolbar.ShapeColorPropertyLayout
            android:id="@+id/color_layout"
            android:background="@drawable/shape_rectangle_gray_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tool_popup_common_item_height"
            android:layout_marginTop="@dimen/dp_8"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            android:layout_marginStart="@dimen/tool_popup_margin_start"
            android:layout_marginEnd="@dimen/tool_popup_margin_end"
            app:isLarge="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_color_title"/>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</FrameLayout>
