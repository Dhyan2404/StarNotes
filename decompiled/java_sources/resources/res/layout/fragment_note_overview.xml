<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_note_overview_0"
    android:background="@color/note_overview_background"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.onyx.android.sdk.theme.widgets.TintLinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/lly_content"
        android:tag="binding_1"
        android:background="@color/theme_background_color_01"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/dp_280"
        android:layout_height="match_parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_text_color_01"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_24"
                android:text="@string/shortcut_bar_note_overview"
                android:layout_marginVertical="@dimen/dp_12"/>
            <com.onyx.android.sdk.theme.widgets.TintImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_close"
                android:padding="@dimen/dp_8"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/ic_close_dialog"
                app:imageTint="@color/theme_icon_color_03"/>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"/>
        <include
            android:id="@+id/layout_search"
            layout="@layout/layout_doc_search"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.onyx.galaxy.note.category.view.CustomScrollBarRecycleView
                android:id="@+id/rv_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_16"
                app:scrollBarEnable="true"/>
            <com.onyx.galaxy.note.category.view.CommonEmptyView
                android:id="@+id/search_empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:empty_holder_src="@drawable/icon_empty_view_search"
                app:empty_title="@string/overview_empty_view_search_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.onyx.android.sdk.theme.widgets.TintView
            android:background="@color/theme_divider_color_01"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp0_5"/>
        <com.onyx.android.sdk.theme.widgets.TintLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/lly_quick_create"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48">
            <com.onyx.android.sdk.theme.widgets.TintTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/theme_primary_color_01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quickly_create_note"
                android:drawableLeft="@drawable/icon_note_overview_quick_create"
                android:drawablePadding="@dimen/dp_4"
                app:drawableLeftTint="@color/theme_primary_color_01"/>
        </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
    </com.onyx.android.sdk.theme.widgets.TintLinearLayout>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
