<?xml version="1.0" encoding="utf-8"?>
<com.onyx.android.sdk.theme.widgets.TintConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cls_content"
    android:background="@drawable/selector_manager_folder_item_bg_color"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50">
    <com.onyx.android.sdk.theme.widgets.TintView
        android:background="@color/theme_divider_color_01"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_note_tree_folder"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_note_tree_folder_bottom"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/icon_item_folder_list_bottom"
        app:layout_constraintBottom_toBottomOf="@+id/iv_note_tree_folder"
        app:layout_constraintEnd_toEndOf="@+id/iv_note_tree_folder"
        app:layout_constraintStart_toStartOf="@+id/iv_note_tree_folder"
        app:layout_constraintTop_toTopOf="@+id/iv_note_tree_folder"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_note_tree_folder"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ic_slider_folder_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/theme_text_color_01"
        android:id="@+id/tv_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginHorizontal="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_note_tree_expand"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_note_tree_folder"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_check"
        android:background="@drawable/icon_manager_folder_check"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:button="@null"
        android:layout_marginEnd="@dimen/dp_16"
        android:elevation="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.onyx.android.sdk.theme.widgets.TintImageView
        android:id="@+id/iv_note_tree_expand"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_8"
        app:imageTint="@color/theme_icon_color_02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_check"
        app:layout_constraintTop_toTopOf="parent"/>
</com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
