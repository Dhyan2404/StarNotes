<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_select_folder_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
        android:layout_gravity="center"
        android:tag="binding_1"
        android:background="@drawable/shape_common_dialog_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_528">
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_01"
            android:gravity="center"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:text="@string/dialog_select_folder_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_text_color_02"
            android:id="@+id/tv_cancel"
            android:padding="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView4"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_ok"
            android:padding="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/textView4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView4"
            style="@style/materialSelectPressStyleNoRadius"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/tv_un_classify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            android:text="@string/dialog_select_folder_manage_un_classfied"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4"/>
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:id="@+id/fl_un_classified"
            android:background="@drawable/shape_select_folder_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:layout_marginVertical="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_un_classify">
            <com.onyx.android.sdk.theme.widgets.TintCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_background_popup_color_01"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <com.onyx.android.sdk.theme.widgets.TintConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48">
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_note_tree_folder_bottom"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/icon_move_folder_un_classfied"
                        app:imageTint="@color/theme_icon_color_01"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_note_tree_folder"
                        app:layout_constraintEnd_toEndOf="@+id/iv_note_tree_folder"
                        app:layout_constraintStart_toStartOf="@+id/iv_note_tree_folder"
                        app:layout_constraintTop_toTopOf="@+id/iv_note_tree_folder"/>
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_note_tree_folder"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/icon_move_folder_un_classfied"
                        android:layout_marginStart="@dimen/tree_node_item_indent"
                        app:imageTint="@color/theme_icon_color_01"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.onyx.android.sdk.theme.widgets.TintTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/theme_text_color_01"
                        android:id="@+id/tv_item_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/no_classify"
                        android:singleLine="true"
                        android:layout_marginHorizontal="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_note_tree_expand"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/iv_note_tree_folder"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.onyx.android.sdk.theme.widgets.TintImageView
                        android:id="@+id/iv_un_classify_checked"
                        android:visibility="gone"
                        android:clickable="false"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:button="@null"
                        android:src="@drawable/icon_manager_folder_check"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:elevation="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
            </com.onyx.android.sdk.theme.widgets.TintCardView>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_text_color_01"
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            android:text="@string/manager_folder_hint_title"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_un_classified"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/theme_text_color_03"
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@string/dialog_select_folder_sub_title"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView6"/>
        <com.onyx.android.sdk.theme.widgets.TintFrameLayout
            android:id="@+id/fl_list"
            android:background="@drawable/shape_select_folder_bg"
            android:padding="@dimen/dp_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:layout_marginVertical="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_manager_folder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView7">
            <com.onyx.android.sdk.theme.widgets.TintCardView
                android:id="@+id/card_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/theme_background_popup_color_01"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </com.onyx.android.sdk.theme.widgets.TintCardView>
        </com.onyx.android.sdk.theme.widgets.TintFrameLayout>
        <include
            android:id="@+id/include_empty_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/fl_list"
            app:layout_constraintEnd_toEndOf="@+id/fl_list"
            app:layout_constraintStart_toStartOf="@+id/fl_list"
            app:layout_constraintTop_toTopOf="@+id/textView6"
            layout="@layout/empty_view_manage_folder"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manager_folder_create_title"
            android:drawableLeft="@drawable/icon_manage_dialog_create"
            android:drawablePadding="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="@+id/textView6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView6"/>
        <com.onyx.android.sdk.theme.widgets.TintTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/theme_primary_color_01"
            android:id="@+id/tv_manager_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/dialog_select_folder_manage"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_un_classified"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="fl_un_classified,tv_un_classify"/>
    </com.onyx.android.sdk.theme.widgets.TintConstraintLayout>
</FrameLayout>
