<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="@dimen/dp_40"
        android:width="@dimen/dp_40">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/theme_background_gradient_color_01"
                android:endColor="#00f08080"
                android:angle="0"
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="130"/>
        </shape>
    </item>
    <item
        android:height="@dimen/dp_40"
        android:width="@dimen/dp_40">
        <shape
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:shape="rectangle">
            <gradient
                android:startColor="@color/theme_background_gradient_color_02"
                android:endColor="#00ffd1dc"
                android:angle="0"
                android:type="radial"
                android:centerX="1.12"
                android:centerY="0.2"
                android:gradientRadius="80"/>
        </shape>
    </item>
    <item
        android:height="@dimen/dp_40"
        android:width="@dimen/dp_40">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/theme_background_gradient_color_03"
                android:endColor="#00ffffe0"
                android:angle="0"
                android:type="radial"
                android:centerX="0.15"
                android:centerY="1"
                android:gradientRadius="60"/>
        </shape>
    </item>
    <item
        android:height="@dimen/dp_40"
        android:width="@dimen/dp_40">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/theme_background_gradient_color_04"
                android:endColor="#00e0ffff"
                android:angle="0"
                android:type="radial"
                android:centerX="1"
                android:centerY="1"
                android:gradientRadius="60"/>
        </shape>
    </item>
</layer-list>
