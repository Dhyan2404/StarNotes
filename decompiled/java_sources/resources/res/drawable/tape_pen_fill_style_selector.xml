<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="@dimen/dp_8"/>
                    <stroke
                        android:width="@dimen/dp_1_2"
                        android:color="@color/theme_primary_color_01"/>
                </shape>
            </item>
            <item
                android:left="@dimen/dp_2"
                android:top="@dimen/dp_2"
                android:right="@dimen/dp_2"
                android:bottom="@dimen/dp_2">
                <shape>
                    <corners android:radius="@dimen/dp_7"/>
                    <stroke
                        android:width="@dimen/dp_1_2"
                        android:color="@color/theme_background_color_02"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape/>
    </item>
</selector>
