    d1 = {
        "\u0000k\n\u0002\u0018\u0002\n\u0002\u0010\u0000\n\u0002\u0008\u0002\n\u0002\u0010\u0008\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0010\u000b\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\n\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0010\u0011\n\u0002\u0008\u0008\n\u0002\u0010\u0007\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0008\n\u0002\u0018\u0002\n\u0002\u0008\u000c\n\u0002\u0010\u000e\n\u0003\u0008\u0089\u0001\n\u0002\u0018\u0002\n\u0000\u0008\u0086\u0003\u0018\u00002\u00020\u0001B\u0007\u0008\u0002\u00a2\u0006\u0002\u0010\u0002J\u0008\u0010\u00dd\u0001\u001a\u00030\u00de\u0001R\u000e\u0010\u0003\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u000e\u0010\u0005\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u0014\u0010\u0006\u001a\u00020\u0004X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0007\u0010\u0008R\u0014\u0010\t\u001a\u00020\u0004X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\n\u0010\u0008R\u001a\u0010\u000b\u001a\u00020\u000cX\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008\r\u0010\u000e\"\u0004\u0008\u000f\u0010\u0010R\u0014\u0010\u0011\u001a\u00020\u0012X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0013\u0010\u0014R\u0014\u0010\u0015\u001a\u00020\u0012X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0016\u0010\u0014R\u001a\u0010\u0017\u001a\u00020\u0018X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008\u0019\u0010\u001a\"\u0004\u0008\u001b\u0010\u001cR\u0014\u0010\u001d\u001a\u00020\u0012X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u001e\u0010\u0014R\u0014\u0010\u001f\u001a\u00020\u0012X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008 \u0010\u0014R\u000e\u0010!\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u001a\u0010\"\u001a\u00020#X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008$\u0010%\"\u0004\u0008&\u0010\'R$\u0010(\u001a\n\u0012\u0006\u0012\u0004\u0018\u00010#0)X\u0086\u000e\u00a2\u0006\u0010\n\u0002\u0010.\u001a\u0004\u0008*\u0010+\"\u0004\u0008,\u0010-R\u0014\u0010/\u001a\u00020\u0012X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u00080\u0010\u0014R\u001a\u00101\u001a\u000202X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u00083\u00104\"\u0004\u00085\u00106R\u001a\u00107\u001a\u000208X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u00089\u0010:\"\u0004\u0008;\u0010<R\u001a\u0010=\u001a\u00020>X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008?\u0010@\"\u0004\u0008A\u0010BR\u001a\u0010C\u001a\u000208X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008D\u0010:\"\u0004\u0008E\u0010<R\u001a\u0010F\u001a\u00020GX\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008H\u0010I\"\u0004\u0008J\u0010KR\u001a\u0010L\u001a\u000202X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008M\u00104\"\u0004\u0008N\u00106R\u0014\u0010O\u001a\u000202X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008P\u00104R\u0014\u0010Q\u001a\u000202X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008R\u00104R\u0014\u0010S\u001a\u00020TX\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008U\u0010VR\u0014\u0010W\u001a\u00020TX\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008X\u0010VR\u001a\u0010Y\u001a\u00020#X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008Z\u0010%\"\u0004\u0008[\u0010\'R\u000e\u0010\\\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u000e\u0010]\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u000e\u0010^\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u001a\u0010_\u001a\u000208X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008`\u0010:\"\u0004\u0008a\u0010<R\u0014\u0010b\u001a\u00020\u0004X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008c\u0010\u0008R\u0014\u0010d\u001a\u00020\u0004X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008e\u0010\u0008R\u001a\u0010f\u001a\u00020>X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008g\u0010@\"\u0004\u0008h\u0010BR\u001a\u0010i\u001a\u000208X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008j\u0010:\"\u0004\u0008k\u0010<R\u0014\u0010l\u001a\u00020TX\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008m\u0010VR\u0014\u0010n\u001a\u000202X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008o\u00104R\u001a\u0010p\u001a\u000208X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008q\u0010:\"\u0004\u0008r\u0010<R\u0014\u0010s\u001a\u00020\u0004X\u0086D\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008t\u0010\u0008R\u000e\u0010u\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u001a\u0010v\u001a\u00020#X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008w\u0010%\"\u0004\u0008x\u0010\'R\u001a\u0010y\u001a\u000202X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008z\u00104\"\u0004\u0008{\u00106R\u001a\u0010|\u001a\u000202X\u0086\u000e\u00a2\u0006\u000e\n\u0000\u001a\u0004\u0008}\u00104\"\u0004\u0008~\u00106R\u000e\u0010\u007f\u001a\u00020\u0004X\u0086T\u00a2\u0006\u0002\n\u0000R\u001d\u0010\u0080\u0001\u001a\u00020#X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u0081\u0001\u0010%\"\u0005\u0008\u0082\u0001\u0010\'R\u001d\u0010\u0083\u0001\u001a\u000202X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u0084\u0001\u00104\"\u0005\u0008\u0085\u0001\u00106R\u001d\u0010\u0086\u0001\u001a\u000202X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u0087\u0001\u00104\"\u0005\u0008\u0088\u0001\u00106R\u001d\u0010\u0089\u0001\u001a\u00020\u0018X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u008a\u0001\u0010\u001a\"\u0005\u0008\u008b\u0001\u0010\u001cR\u001d\u0010\u008c\u0001\u001a\u000208X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u008d\u0001\u0010:\"\u0005\u0008\u008e\u0001\u0010<R\u0016\u0010\u008f\u0001\u001a\u00020\u0004X\u0086D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0090\u0001\u0010\u0008R\u001d\u0010\u0091\u0001\u001a\u00020>X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u0092\u0001\u0010@\"\u0005\u0008\u0093\u0001\u0010BR\u001d\u0010\u0094\u0001\u001a\u000208X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u0095\u0001\u0010:\"\u0005\u0008\u0096\u0001\u0010<R\u001d\u0010\u0097\u0001\u001a\u00020\u0018X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u0098\u0001\u0010\u001a\"\u0005\u0008\u0099\u0001\u0010\u001cR\u001d\u0010\u009a\u0001\u001a\u000208X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u009b\u0001\u0010:\"\u0005\u0008\u009c\u0001\u0010<R\u0016\u0010\u009d\u0001\u001a\u00020\u0004X\u0086D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u009e\u0001\u0010\u0008R\u001d\u0010\u009f\u0001\u001a\u00020>X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00a0\u0001\u0010@\"\u0005\u0008\u00a1\u0001\u0010BR\u001d\u0010\u00a2\u0001\u001a\u000208X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00a3\u0001\u0010:\"\u0005\u0008\u00a4\u0001\u0010<R\u001d\u0010\u00a5\u0001\u001a\u000202X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00a6\u0001\u00104\"\u0005\u0008\u00a7\u0001\u00106R\u001d\u0010\u00a8\u0001\u001a\u000202X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00a9\u0001\u00104\"\u0005\u0008\u00aa\u0001\u00106R\u001d\u0010\u00ab\u0001\u001a\u00020\u0018X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00ac\u0001\u0010\u001a\"\u0005\u0008\u00ad\u0001\u0010\u001cR\u001d\u0010\u00ae\u0001\u001a\u000202X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00af\u0001\u00104\"\u0005\u0008\u00b0\u0001\u00106R\u001d\u0010\u00b1\u0001\u001a\u00020>X\u0086\u000e\u00a2\u0006\u0010\n\u0000\u001a\u0005\u0008\u00b2\u0001\u0010@\"\u0005\u0008\u00b3\u0001\u0010BR\u0016\u0010\u00b4\u0001\u001a\u00020\u0004X\u0086D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b5\u0001\u0010\u0008R\u0016\u0010\u00b6\u0001\u001a\u00020\u0004X\u0086D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b7\u0001\u0010\u0008R\u0016\u0010\u00b8\u0001\u001a\u00020\u0004X\u0086D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b9\u0001\u0010\u0008R\u001d\u0010\u00ba\u0001\u001a\u000208X\u00