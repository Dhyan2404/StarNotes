<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/dp_12" />
                    <stroke android:width="@dimen/dp_1" android:color="@color/theme_primary_color_01" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/dp_12" />
                    <stroke android:width="@dimen/dp0_5" android:color="@color/theme_divider_color_01" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>