<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/dp_12" />
            <stroke android:width="@dimen/dp_1_2" android:color="@color/theme_primary_color_01" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <corners android:radius="@dimen/dp_12" />
            <stroke android:width="@dimen/dp0_5" android:color="@color/theme_divider_color_01" />
        </shape>
    </item>
</selector>