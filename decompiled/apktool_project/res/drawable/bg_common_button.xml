<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/dialog_common_button_radius" />
            <solid android:color="@android:color/white" />
            <stroke android:width="@dimen/focused_border_width" android:color="@android:color/black" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/dialog_common_button_radius" />
            <solid android:color="@android:color/white" />
            <stroke android:width="@dimen/dialog_common_button_stroke_width" android:color="@color/icon_disable_color" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dialog_common_button_radius" />
            <solid android:color="@android:color/black" />
            <stroke android:width="@dimen/dialog_common_button_stroke_width" android:color="@android:color/black" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/dialog_common_button_radius" />
            <solid android:color="@android:color/white" />
            <stroke android:width="@dimen/dialog_common_button_stroke_width" android:color="@android:color/black" />
        </shape>
    </item>
    <item android:state_focused="true" android:drawable="@drawable/focused_bg" />
</selector>