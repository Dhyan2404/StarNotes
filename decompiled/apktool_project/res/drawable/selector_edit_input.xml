<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_background_color_02" />
            <corners android:radius="@dimen/dp_12" />
            <stroke android:width="@dimen/dp_1" android:color="@color/theme_divider_color_01" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_12" />
            <stroke android:width="@dimen/dp_1" android:color="@color/theme_primary_color_01" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_12" />
            <stroke android:width="@dimen/dp0_5" android:color="@color/theme_divider_color_01" />
        </shape>
    </item>
</selector>