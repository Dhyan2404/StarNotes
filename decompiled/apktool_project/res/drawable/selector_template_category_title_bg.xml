<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_bg_primary_color_01" />
            <stroke android:width="@dimen/dp_1" android:color="@color/theme_primary_color_01" />
            <corners android:radius="@dimen/dp_37" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_background_color_02" />
            <corners android:radius="@dimen/dp_37" />
        </shape>
    </item>
</selector>